# shellcheck shell=bash
# Shared by pre-commit and pre-push (sourced, not a hook): the gitleaks checks both hooks make before scanning.
#   gl_init HOOK    sets top (work tree), hookrepo (repo that holds the hooks), cfg (temp file with the COMMITTED .gitleaks.toml;
#                   the caller removes it); exits 1 with a message when gitleaks is missing or a .gitleaksignore exists
# The config comes from the committed file of the scanned repo, else of the repo that holds the hooks (the nvim submodule has
# none), else a temp config that only extends the default rules; never the working file. `-c` is ALWAYS passed: without it
# gitleaks auto-loads `<source>/.gitleaks.toml` (or $GITLEAKS_CONFIG), and an empty or rule-less file there has NO rules, so a
# truncated committed file would silence every gate. A committed file is only used when it is non-empty and extends the defaults.
gl_init() {
  local hook=$1
  top=$(git rev-parse --show-toplevel) || exit 1
  hookrepo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[1]}")")/.." && pwd)
  if ! command -v gitleaks >/dev/null 2>&1; then
    printf '%s: gitleaks is not installed, the secret scan cannot run.\n  sudo pacman -S gitleaks   (or, deliberately: --no-verify)\n' "$hook" >&2
    exit 1
  fi
  if [ -e "$top/.gitleaksignore" ]; then
    printf '%s: remove %s/.gitleaksignore; allowlist entries go into .gitleaks.toml (committed on its own).\n' "$hook" "$top" >&2
    exit 1
  fi
  cfg=$(mktemp) || exit 1
  gl_load_cfg
}
# gl_default_cfg FILE: the fallback config, the default rules only
gl_default_cfg() { printf '%s\n' 'title = "default rules"' '[extend]' 'useDefault = true' >"$1"; }
# gl_usable_cfg FILE: non-empty and it extends the default rules (otherwise gitleaks would run with no or fewer rules)
gl_usable_cfg() { [ -s "$1" ] && grep -Eq '^[[:space:]]*useDefault[[:space:]]*=[[:space:]]*true' "$1"; }
# gl_pick_cfg REPO FILE: the committed .gitleaks.toml of REPO into FILE when it is usable AND gl_cfg_problems finds nothing in
# it (a file that could silence real findings is not trusted: the default-only config is used and doctor reports the file),
# else the default-only config in FILE
gl_pick_cfg() {
  git -C "$1" show HEAD:.gitleaks.toml >"$2" 2>/dev/null && gl_usable_cfg "$2" && [ -z "$(gl_cfg_problems "$2")" ] && return 0
  gl_default_cfg "$2"; return 1
}
gl_load_cfg() {
  gl_pick_cfg "$top" "$cfg" && return 0
  gl_pick_cfg "$hookrepo" "$cfg"
  return 0
}

# gl_cfg_problems FILE: print one line per way a .gitleaks.toml could silence real findings (doctor `gitleaks-history` FAILs on
# any): default rules not extended, an allowlist by `paths` / `commits` / `stopwords`, a `regexTarget` other than "secret" (line
# or match allowlists are wider than the exact value), a catch-all regex (.* .+ \S+ ...), `disabledRules` (switches default
# rules off) or a `[[rules]]` table (a rule whose id equals a default rule REPLACES it, e.g. with a regex that never matches).
# Exact value regexes are what the file is meant to hold. Prints nothing for a good file; returns 0 either way.
gl_cfg_problems() {
  local f=$1
  grep -Eq '^[[:space:]]*useDefault[[:space:]]*=[[:space:]]*true' "$f" || echo "the default rules are not extended (useDefault = true is missing)"
  grep -Eq '^[[:space:]]*paths[[:space:]]*=' "$f" && echo "a paths allowlist (it hides every finding in those files; use exact value regexes)"
  grep -Eq '^[[:space:]]*(commits|stopwords)[[:space:]]*=' "$f" && echo "a commits / stopwords allowlist (wider than an exact value)"
  grep -Eq 'disabledRules["'\'']?[[:space:]]*=' "$f" && echo "disabledRules (it switches default rules off)"
  grep -Eq '^[[:space:]]*(\[\[[[:space:]]*rules[[:space:]]*\]\]|["'\'']?rules["'\'']?[[:space:]]*=)' "$f" && echo "a [[rules]] table (a rule with the id of a default rule replaces it: custom rules do not belong in this file)"
  grep -E '^[[:space:]]*regexTarget[[:space:]]*=' "$f" | grep -Evq '=[[:space:]]*"secret"' && echo "a regexTarget other than \"secret\" (line / match allowlists are wider than the value)"
  # a regex entry that is only a wildcard: '.*' '^.+$' "\\S+" '[\s\S]*' '.{1,}' (every quoted string of the file is looked at)
  local q v re='^(\.|\\[SWsdwD]|\[[^]]*\])([*+]|\{[0-9]+,[0-9]*\})\??$'
  while IFS= read -r q; do
    v=${q//[\'\"]/}                       # quotes off
    v=${v//\\\\/\\}; v=${v#\(\?i\)}; v=${v#^}; v=${v%\$}
    if [[ $v =~ $re ]]; then echo "a catch-all regex entry ($v matches every value)"; break; fi
  done < <(grep -oE "'''[^']*'''|\"[^\"]*\"|'[^']*'" "$f")
  return 0
}

# gl_committed_cfg_problems REPO: gl_cfg_problems of the COMMITTED .gitleaks.toml of REPO; a missing or empty file is a problem
# too (the hooks then fall back to the default rules, but the allowlist is gone and the file was meant to be there)
gl_committed_cfg_problems() {
  local c; c=$(mktemp) || return 0
  if ! git -C "$1" show HEAD:.gitleaks.toml >"$c" 2>/dev/null; then echo "there is no committed .gitleaks.toml (the hooks fall back to the default rules only)"
  elif [ ! -s "$c" ]; then echo "the committed .gitleaks.toml is empty (it would have no rules; the hooks ignore it)"
  else gl_cfg_problems "$c"; fi
  rm -f "$c"
}

# gl_history_scan REPO: scan the whole history with the COMMITTED .gitleaks.toml (default rules when it is missing, empty or does
# not extend them), never the working file (an uncommitted broad allowlist must not silence it) and always with an explicit -c,
# --redact. Prints gitleaks' output; returns 0 clean, 3 findings, anything else = failed to run.
gl_history_scan() {
  local repo=$1 c rc
  c=$(mktemp) || return 1
  gl_pick_cfg "$repo" "$c"
  gitleaks git --no-banner --redact -l error --exit-code 3 -c "$c" "$repo" 2>&1; rc=$?
  rm -f "$c"
  return $rc
}
