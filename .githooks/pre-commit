#!/usr/bin/env bash
# pre-commit (core.hooksPath = .githooks, set by install.sh; the .config/nvim submodule points here too): scan the STAGED
# changes of this public repo for secrets with gitleaks (~25 ms). Runs in linked worktrees too (agents commit there).
# The only bypass is `git commit --no-verify`: `gitleaks:allow` comments and .gitleaksignore files are not honoured, and the
# allowlist comes from the COMMITTED .gitleaks.toml, so a false positive needs a .gitleaks.toml commit of its own first.
set -u
top=$(git rev-parse --show-toplevel) || exit 1
hookrepo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
if ! command -v gitleaks >/dev/null 2>&1; then
  printf 'pre-commit: gitleaks is not installed, the secret scan cannot run.\n  sudo pacman -S gitleaks   (or, deliberately: git commit --no-verify)\n' >&2
  exit 1
fi
if [ -e "$top/.gitleaksignore" ]; then
  printf 'pre-commit: remove %s/.gitleaksignore; allowlist entries go into .gitleaks.toml (committed on its own).\n' "$top" >&2
  exit 1
fi
cfg=$(mktemp) || exit 1; trap 'rm -f "$cfg"' EXIT
# the committed config of the scanned repo, else of the repo that holds this hook (the nvim submodule has none), else the
# working file (first commit of the file); an empty file is never passed (it would have NO rules)
load_cfg() {
  git -C "$top" show HEAD:.gitleaks.toml >"$cfg" 2>/dev/null && [ -s "$cfg" ] && return 0
  git -C "$hookrepo" show HEAD:.gitleaks.toml >"$cfg" 2>/dev/null && [ -s "$cfg" ] && return 0
  cat "$top/.gitleaks.toml" >"$cfg" 2>/dev/null && [ -s "$cfg" ] && return 0
  cat "$hookrepo/.gitleaks.toml" >"$cfg" 2>/dev/null && [ -s "$cfg" ]
}
load_cfg || : >"$cfg"
args=(git --staged --no-banner --redact --ignore-gitleaks-allow --exit-code 3 -l warn -v)
[ -s "$cfg" ] && args+=(-c "$cfg")
[ -t 2 ] || args+=(--no-color)
gitleaks "${args[@]}" "$top" >&2; rc=$?
case $rc in
  0) exit 0 ;;
  3) printf '%s\n' '' 'pre-commit: gitleaks found possible secrets in the staged changes (values redacted above).' \
       '  Real secret: unstage it (git restore --staged FILE), remove it, rotate it if it was ever pushed.' \
       '  False positive: add an exact entry to .gitleaks.toml, commit that file alone, then commit again.' \
       '  Deliberate bypass (never for a real secret): git commit --no-verify' >&2; exit 1 ;;
  *) printf 'pre-commit: gitleaks failed to run (exit %s); fix the config or bypass deliberately with --no-verify\n' "$rc" >&2; exit 1 ;;
esac
