# Identity lives in ~/.gitconfig.local (created by install.sh, not tracked)
[include]
	path = ~/.gitconfig.local
[credential]
	# after installing github-cli, run once (interactive): gh auth login && gh auth setup-git
	helper = cache --timeout=28800
[init]
	defaultBranch = master
[core]
	editor = nvim
	# delta when installed, plain less otherwise; the pager only runs on a TTY, agent output stays stock
	pager = "if command -v delta >/dev/null 2>&1; then exec delta; else exec less; fi"
[interactive]
	diffFilter = "command -v delta >/dev/null 2>&1 && delta --color-only || cat"
[delta]
	navigate = true
	line-numbers = true
	dark = true
	syntax-theme = ansi
# Everforest diff colours (generated, see themes/palette): the black fallback first, then the active variant
# (symlink ~/.local/state/theme/current, flipped by the `theme` command). Missing include files are ignored.
[include]
	path = ~/dotfiles/themes/generated/black/delta.gitconfig
	path = ~/.local/state/theme/current/delta.gitconfig
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[pull]
	rebase = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[commit]
	verbose = true
[alias]
	lg = log --graph --oneline --decorate --all
	st = status -sb
	undo = reset --soft HEAD~1
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[protocol "file"]
	allow = always
