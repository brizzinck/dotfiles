# Pinned external pieces of the Telegram MCP service (read by apply-system.sh --only mcp, doctor.sh and the tests). KEY=VALUE.
# chigwell/telegram-mcp (Apache-2.0). NEVER `pip install telegram-mcp`: that PyPI name belongs to an unrelated project.
TELEGRAM_MCP_REPO=https://github.com/chigwell/telegram-mcp.git
TELEGRAM_MCP_COMMIT=20eaff3ea1b0dcc21f4c163167e5b3eaad16b48a
# Whisper model for voice messages: the same file Voxtype dictation uses (dictation.sh model), shared through /srv/models
# because aimcp cannot read /home. Size 487601967 bytes.
WHISPER_MODEL_FILE=ggml-small.bin
WHISPER_MODEL_SHA256=1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b
WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin
