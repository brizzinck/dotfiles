[Unit]
Description=Telegram MCP (chigwell/telegram-mcp: read-only MCP tools, chat allowlist, bearer token; plus /x-send, which only the owner-confirming tgconfirm broker may call) on 127.0.0.1:8765
After=network-online.target
Wants=network-online.target
# started only once mcp-telegram-setup has stored all five credentials (otherwise the unit is skipped, not failed)
ConditionPathExists=/etc/credstore.encrypted/telegram-mcp.api_id
ConditionPathExists=/etc/credstore.encrypted/telegram-mcp.api_hash
ConditionPathExists=/etc/credstore.encrypted/telegram-mcp.session
ConditionPathExists=/etc/credstore.encrypted/telegram-mcp.allowlist
ConditionPathExists=/etc/credstore.encrypted/telegram-mcp.token

[Service]
Type=simple
User=aimcp
Group=aimcp
# secrets: encrypted with the TPM2 + host key, decrypted by systemd at start into a private tmpfs ($CREDENTIALS_DIRECTORY)
LoadCredentialEncrypted=api_id:/etc/credstore.encrypted/telegram-mcp.api_id
LoadCredentialEncrypted=api_hash:/etc/credstore.encrypted/telegram-mcp.api_hash
LoadCredentialEncrypted=session:/etc/credstore.encrypted/telegram-mcp.session
LoadCredentialEncrypted=allowlist:/etc/credstore.encrypted/telegram-mcp.allowlist
LoadCredentialEncrypted=token:/etc/credstore.encrypted/telegram-mcp.token
ExecStart=/usr/local/lib/telegram-mcp/run
Restart=on-failure
RestartSec=15
# 78 = refused to start (missing credential, empty allowlist): do not loop on it
RestartPreventExitStatus=78
StateDirectory=telegram-mcp
StateDirectoryMode=0700
WorkingDirectory=/var/lib/telegram-mcp
UMask=0077
Environment=HOME=/var/lib/telegram-mcp

# sandbox: no writable system, no /home, own /tmp, only IP and unix sockets, no capabilities
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
