#!/usr/bin/env bash
# fake rbw: `rbw get --folder F --field FLD ITEM` (values in $FAKE_DIR/vault/<F>__<ITEM>__<FLD>), `rbw get --raw --folder MCP telegram-mcp`
# (the record is built from $FAKE_DIR/bw-item.json; FAKE_RBW_FAIL=1 makes it fail), `rbw sync` / `rbw unlocked`; every call is logged
echo "rbw $*" >>"${FAKE_DIR:-/tmp}/argv.log"
case ${1:-} in sync | unlocked) exit 0 ;; get) ;; *) exit 2 ;; esac
shift; folder=""; field=""; raw=0
while (($#)); do case $1 in --folder) folder=$2; shift ;; --field) field=$2; shift ;; --raw) raw=1 ;; *) item=$1 ;; esac; shift; done
if ((raw)); then
  [[ ${FAKE_RBW_FAIL:-0} == 1 || $folder != MCP || $item != telegram-mcp ]] && { echo "rbw: no entry found" >&2; exit 1; }
  jq -c '{id, name, folder: "MCP", data: {}, notes: null, fields: [.fields[]? | {name, value, type: (if .type == 1 then "hidden" else "text" end)}]}' "$FAKE_DIR/bw-item.json"
  exit 0
fi
f="$FAKE_DIR/vault/${folder}__${item}__${field}"
[[ -r $f ]] || { echo "rbw: no entry found" >&2; exit 1; }
cat "$f"
