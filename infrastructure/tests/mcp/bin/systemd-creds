#!/usr/bin/env bash
# fake systemd-creds encrypt: `encrypt --with-key=... --name=N - OUTFILE` (value on stdin); the "sealed" file holds only a hash
echo "systemd-creds $*" >>"${FAKE_DIR:-/tmp}/argv.log"
[[ $1 == encrypt ]] || exit 2
out="${@: -1}"
printf 'SEALED:%s\n' "$(sha256sum | cut -d' ' -f1)" >"$out"
