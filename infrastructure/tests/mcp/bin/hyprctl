#!/usr/bin/env bash
# fake hyprctl for the mcp tests: canned JSON, argv logged
echo "hyprctl $*" >>"${FAKE_DIR:-/tmp}/argv.log"
case "$*" in
  "-j clients") cat <<'J'
[{"address":"0xaaa","class":"org.telegram.desktop","title":"Chat with Ann","pid":11,"floating":false,"fullscreen":0,"pinned":false,"xwayland":false,"at":[0,0],"size":[800,600],"monitor":0,"workspace":{"id":1,"name":"1"},"focusHistoryID":1,"tags":[],"grouped":[],"secretfield":"x"},
 {"address":"0xbbb","class":"com.mitchellh.ghostty","title":"nvim","pid":12,"floating":true,"fullscreen":0,"pinned":false,"xwayland":false,"at":[10,10],"size":[500,400],"monitor":1,"workspace":{"id":2,"name":"2"},"focusHistoryID":0,"tags":[],"grouped":[]}]
J
  ;;
  "-j activewindow") echo '{"address":"0xbbb","class":"com.mitchellh.ghostty","title":"nvim","pid":12,"workspace":{"id":2,"name":"2"}}' ;;
  "-j monitors") echo '[{"id":0,"name":"HDMI-A-1","description":"Dell","width":2560,"height":1440,"refreshRate":144.0,"x":0,"y":0,"scale":1.0,"focused":true,"dpmsStatus":true,"transform":0,"activeWorkspace":{"id":1,"name":"1"},"specialWorkspace":{"id":0,"name":""}}]' ;;
  "-j workspaces") echo '[{"id":1,"name":"1","monitor":"HDMI-A-1","windows":2,"hasfullscreen":false,"lastwindowtitle":"x"}]' ;;
  *) echo "fake hyprctl: unexpected $*" >&2; exit 1 ;;
esac
