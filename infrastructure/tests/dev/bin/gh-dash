#!/usr/bin/env bash
# fake gh-dash: logs argv, cwd and keeps a copy of the --config file
. "$(dirname "$0")/_dev.sh"
dev_log "gh-dash $*"
dev_log "gh-dash cwd=$PWD"
while (($#)); do case $1 in --config|-c) cp "$2" "$FAKE_DIR/gh-dash.config"; dev_log "gh-dash config-mode=$(stat -c %a "$2")" ;; esac; shift; done
maybe_sleep
