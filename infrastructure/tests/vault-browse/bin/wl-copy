#!/usr/bin/env bash
# shellcheck source=_common.sh
. "$(dirname "$0")/_common.sh"
log_argv wl-copy "$@"
if [[ ${FAKE_ENV_SEND:-} == 1 && " $* " == *" --foreground "* ]]; then
  exec /usr/bin/python3 -I -B "$(dirname "$0")/send-clipboard.py" "$@"
fi
if [[ ${1:-} == --clear ]]; then : >"$FAKE_DIR/clip.txt"; echo cleared >>"$FAKE_DIR/clip.events"; exit 0; fi
printf '%s' "$*" >"$FAKE_DIR/clip.args"
cat >"$FAKE_DIR/clip.txt"
cp "$FAKE_DIR/clip.txt" "$FAKE_DIR/clip.last"   # the last copy, kept when a delayed --clear of an earlier copy empties clip.txt
echo "copy $*" >>"$FAKE_DIR/clip.events"
