#!/bin/sh
# Pacman hook helper: snapshot the installed package lists into the dotfiles repo (pkg/native.txt, aur.txt, flatpak.txt).
# Template: apply-system.sh renders @OWNER@ (account that owns the dotfiles) and @DOTFILES@ (repo path)
# and installs the result to /usr/local/bin/dotfiles-pkglist, so the tracked file stays user-agnostic.
# Runs as root inside the hook, writes as the owner so the files stay owner-owned. Never fails a transaction.
# shellcheck disable=SC2016  # $1 is meant to expand in the owner's inner shell
OWNER='@OWNER@'
DOTFILES='@DOTFILES@'
OUT="$DOTFILES/pkg"

[ -d "$DOTFILES" ] || exit 0
OWNER_HOME="$(getent passwd "$OWNER" | cut -d: -f6)"
[ -n "$OWNER_HOME" ] || exit 0

as_owner() { runuser -u "$OWNER" -- env HOME="$OWNER_HOME" "$@"; }

as_owner mkdir -p "$OUT" || exit 0
# explicitly installed native / foreign (AUR) packages; write to a temp file first so a failure keeps the old list
as_owner sh -c 'pacman -Qqen | sort > "$1.tmp" && mv "$1.tmp" "$1"' _ "$OUT/native.txt" || true
as_owner sh -c 'pacman -Qqem | sort > "$1.tmp" && mv "$1.tmp" "$1"' _ "$OUT/aur.txt" || true
if command -v flatpak >/dev/null 2>&1; then
  as_owner sh -c 'flatpak list --app --columns=application | sort -u > "$1.tmp" && mv "$1.tmp" "$1"' _ "$OUT/flatpak.txt" || true
fi
exit 0
