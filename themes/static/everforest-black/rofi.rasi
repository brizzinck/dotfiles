/* Everforest Black tokens for rofi (paste into a `* { }` block). Same names as palette.md. */
* {
  bg: #000000;
  surface: #0b0e0d;
  raised: #141a17;
  sel: #1f2a24;
  border: #3a4440;
  dim: #6b7770;
  sub: #859289;
  fg: #d3c6aa;
  fg-hi: #e7dabe;
  green: #a7c080;
  aqua: #83c092;
  blue: #7fbbb3;
  yellow: #dbbc7f;
  orange: #e69875;
  red: #e67e80;
  purple: #d699b6;
}
