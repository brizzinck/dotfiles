# gh-dash theme: Everforest {{variant}}. Generated by themes/palette/render.py. Do not edit.
# Only the top-level `theme:` key lives here: `forge` concatenates ~/.config/gh-dash/base.yml (no `theme:`) and this file into
# the per-run config (tests check that the result holds exactly one `theme:`).
theme:
  ui:
    sectionsShowCount: true
    table:
      showSeparator: true
  colors:
    text:
      primary: "{{fg}}"
      secondary: "{{green}}"
      inverted: "{{bg}}"
      faint: "{{muted}}"
      warning: "{{yellow}}"
      success: "{{green}}"
      error: "{{red}}"
      actor: "{{blue}}"
    background:
      selected: "{{select}}"
    border:
      primary: "{{line}}"
      secondary: "{{border}}"
      faint: "{{line}}"
    icon:
      newcontributor: "{{aqua}}"
      contributor: "{{blue}}"
      collaborator: "{{purple}}"
      member: "{{yellow}}"
      owner: "{{orange}}"
      unknownrole: "{{muted}}"
