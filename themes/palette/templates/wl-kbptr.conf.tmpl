# wl-kbptr (keyboard pointer) overlay colours: Everforest {{variant}}. Generated by themes/palette/render.py. Do not edit.
# Colours are #rrggbbaa. Role map: labels = fg_hi, selected = yellow, selectable cells = surface with a green frame,
# the rest of the screen is dimmed with bg_oled, pointer marker = red, drag start = orange.
[general]
modes=tile,bisect

[mode_tile]
label_color={{fg_hi}}ee
label_select_color={{yellow}}ff
unselectable_bg_color={{bg_oled}}aa
selectable_bg_color={{surface}}99
selectable_border_color={{green}}cc
label_font_family=JetBrainsMono Nerd Font
label_symbols=abcdefghijklmnopqrstuvwxyz

[mode_floating]
label_color={{fg_hi}}ee
label_select_color={{yellow}}ff
unselectable_bg_color={{bg_oled}}aa
selectable_bg_color={{surface}}99
selectable_border_color={{green}}cc
label_font_family=JetBrainsMono Nerd Font

[mode_bisect]
label_color={{fg_hi}}ee
label_font_family=JetBrainsMono Nerd Font
pointer_color={{red}}ee
unselectable_bg_color={{bg_oled}}aa
even_area_bg_color={{green}}22
even_area_border_color={{green}}99
odd_area_bg_color={{blue}}22
odd_area_border_color={{blue}}99
history_border_color={{muted}}99

[mode_split]
pointer_color={{red}}ee
bg_color={{bg_oled}}aa
area_bg_color={{surface}}88
vertical_color={{blue}}cc
horizontal_color={{green}}cc
history_border_color={{muted}}99

[mode_drag]
start_marker_color={{orange}}ee
