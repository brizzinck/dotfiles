# Everforest {{variant}} ({{title}}): tmux colours. Generated by themes/palette/render.py from everforest.json. Do not edit.
# Sourced from tmux.conf through ~/.local/state/theme/current/tmux.conf (and re-sourced live by `theme`).
# Structure (positions, lengths, separators, borders lines, hooks) stays in tmux.conf.

# status bar
set -g status-style "bg=default,fg={{subtext}}"
# badges: PREFIX (yellow), COPY (blue), ZOOM (purple); text on the badge is the background colour
set -g status-left "#{?client_prefix,#[fg={{bg}}]#[bg={{yellow}}]#[bold] PREFIX #[default] ,}#{?pane_in_mode,#[fg={{bg}}]#[bg={{blue}}]#[bold] COPY #[default] ,}#{?window_zoomed_flag,#[fg={{purple}}]#[bold]󰁌 ZOOM #[default],}"
# SYNC (red) + session name; throwaway term-* and all-digit (unnamed) sessions stay hidden, waybar owns the clock
set -g status-right "#{?pane_synchronized,#[fg={{red}}]#[bold]SYNC #[default],}#[fg={{muted}}]#{?#{||:#{m:term-*,#{session_name}},#{m/r:^[0-9]+$,#{session_name}}},,#{session_name}} "
# windows: workmux writes @workmux_status (status_format: false in workmux config), rendered here
set -g window-status-format "#[fg={{muted}}] #I #[fg={{subtext}}]#W#{?@workmux_status, #{@workmux_status},}#{?window_bell_flag,#[fg={{red}}] 󰂞,} "
set -g window-status-current-format "#[bg={{raised}}]#[fg={{green}}]#[bold] #I #[fg={{fg}}]#W#{?@workmux_status, #{@workmux_status},}#{?window_zoomed_flag,#[fg={{purple}}] 󰁌,} #[default]"
# panes: quiet inactive borders (line); active = green, copy-mode = blue, synchronized = red
set -g pane-border-style "fg={{line}}"
set -g pane-active-border-style "#{?pane_in_mode,fg={{blue}},#{?synchronize-panes,fg={{red}},fg={{green}}}}"
# pane titles on borders: active green, others muted
set -g pane-border-format "#{?pane_active,#[fg={{green}}]#[bold],#[fg={{muted}}]} #{pane_index} #{pane_current_command}#{?#{&&:#{pane_title},#{&&:#{!=:#{pane_title},#{host}},#{!=:#{pane_title},#{host_short}}}}, · #{=/32/…:pane_title},} "
# messages, copy mode, popups, menus
set -g message-style "fg={{yellow}},bg={{bg}}"
set -g message-command-style "fg={{blue}},bg={{bg}}"
set -g mode-style "fg={{fg}},bg={{visual}}"
set -g copy-mode-match-style "fg={{bg}},bg={{blue}}"
set -g copy-mode-current-match-style "fg={{bg}},bg={{yellow}}"
set -g copy-mode-mark-style "fg={{bg}},bg={{red}}"
# tmux 3.8 defaults popup-style to bg=themedarkgrey (a grey derived from the terminal), hence explicit palette colours
set -g popup-style "fg={{fg}},bg={{bg}}"
# the other tmux 3.8 "theme" greys (choose-tree, scrollbars, display-panes, unused client area) on palette tokens
set -g display-panes-border-style "fg={{border}}"
set -g pane-scrollbars-style "fg={{border}},width=1,pad=0"
set -g tree-mode-border-style "fg={{border}}"
set -g tree-mode-preview-style "fg=#{?#{||:#{&&:#{pane_format},#{pane_active}},#{&&:#{window_format},#{window_active}}},{{red}},{{blue}}}"
set -g copy-mode-line-number-style "fg={{muted}},dim"
set -g copy-mode-current-line-number-style "fg={{yellow}}"
set -g fill-character " "
set -g popup-border-style "fg={{border}}"
set -g menu-style "fg={{fg}},bg={{bg}}"
set -g menu-selected-style "fg={{bg}},bg={{green}}"
set -g menu-border-style "fg={{border}}"
set -g display-panes-active-colour "{{green}}"
set -g display-panes-colour "{{border}}"
set -g clock-mode-colour "{{green}}"
