# Everforest {{variant}} colours for Hyprland. Generated by themes/palette/render.py. Do not edit.
# Sourced by .config/hypr/hyprland.conf (black fallback first, then the active variant).
# Roles: focus = green -> aqua gradient, inactive border = line, floats/groups inactive = border, groups = purple.
general {
    col.active_border = rgb({{green|nohash}}) rgb({{aqua|nohash}}) 45deg
    col.inactive_border = rgb({{line|nohash}})
    col.nogroup_border = rgb({{border|nohash}})
    col.nogroup_border_active = rgb({{yellow|nohash}})
}

decoration {
    shadow {
        color = rgba({{glow|nohash}})          # faint green glow, focused window only
    }
}

group {
    col.border_active = rgb({{purple|nohash}})
    col.border_inactive = rgb({{border|nohash}})
    col.border_locked_active = rgb({{purple|nohash}})
    col.border_locked_inactive = rgb({{border|nohash}})

    groupbar {
        col.active = rgb({{purple|nohash}})
        col.inactive = rgb({{border|nohash}})
        col.locked_active = rgb({{purple|nohash}})
        col.locked_inactive = rgb({{border|nohash}})
        text_color = rgb({{fg|nohash}})
        text_color_inactive = rgb({{subtext|nohash}})
    }
}

misc {
    background_color = rgb({{bg_oled|nohash}})   # always pure black, also with the night variant
}
