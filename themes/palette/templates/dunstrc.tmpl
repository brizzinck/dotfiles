# Everforest {{variant}} colours for dunst. Generated by themes/palette/render.py. Do not edit.
# Read as a drop-in: .config/dunst/dunstrc.d/40-theme-black.conf (fallback) and 50-theme.conf (active variant) are
# symlinks to the generated files, so only colours live here and dunstrc keeps the structure.
# Roles (same calm language as the window borders and the bar): normal = `green_soft` frame (= active window border)
# and progress fill, text `fg`; low = `line` frame (almost invisible), `subtext` text; critical = `red_soft` frame,
# `fg_hi` text; recorder = `red_soft` (recording), idle and battery = `yellow_soft` (attention, caution). Background
# `bg` (the same surface the fzf menus use), separator `line`. No bright accent colour: urgency is told by the hue.
[global]
    separator_color = "{{line}}"

[urgency_low]
    background = "{{bg}}"
    foreground = "{{subtext}}"
    frame_color = "{{line}}"
    highlight = "{{border}}"

[urgency_normal]
    background = "{{bg}}"
    foreground = "{{fg}}"
    frame_color = "{{green_soft}}"
    highlight = "{{green_soft}}"

[urgency_critical]
    background = "{{bg}}"
    foreground = "{{fg_hi}}"
    frame_color = "{{red_soft}}"
    highlight = "{{red_soft}}"

[recorder]
    frame_color = "{{red_soft}}"
    highlight = "{{red_soft}}"

[idle]
    frame_color = "{{yellow_soft}}"
    highlight = "{{yellow_soft}}"

[battery]
    frame_color = "{{yellow_soft}}"
    highlight = "{{yellow_soft}}"
