# Everforest {{variant}} colours for dunst. Generated by themes/palette/render.py. Do not edit.
# Read as a drop-in: .config/dunst/dunstrc.d/40-theme-black.conf (fallback) and 50-theme.conf (active variant) are
# symlinks to the generated files, so only colours live here and dunstrc keeps the structure.
# Roles: low = quiet (border frame), normal = info (blue frame, green highlight), critical = red,
# recorder = red (recording), idle = yellow (attention), battery = orange (caution).
[urgency_low]
    background = "{{bg}}"
    foreground = "{{subtext}}"
    frame_color = "{{border}}"
    highlight = "{{muted}}"

[urgency_normal]
    background = "{{bg}}"
    foreground = "{{fg}}"
    frame_color = "{{blue}}"
    highlight = "{{green}}"

[urgency_critical]
    background = "{{bg}}"
    foreground = "{{fg_hi}}"
    frame_color = "{{red}}"
    highlight = "{{red}}"

[recorder]
    frame_color = "{{red}}"
    highlight = "{{red}}"

[idle]
    frame_color = "{{yellow}}"
    highlight = "{{yellow}}"

[battery]
    frame_color = "{{orange}}"
    highlight = "{{orange}}"
