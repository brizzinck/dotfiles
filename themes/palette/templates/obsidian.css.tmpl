/* Everforest {{variant}} for Obsidian. Generated by themes/palette/render.py. Do not edit.
   Copy it to <vault>/.obsidian/snippets/everforest.css and enable it in Settings > Appearance > CSS snippets. */
.theme-dark {
  --background-primary: {{bg}};
  --background-primary-alt: {{surface}};
  --background-secondary: {{surface}};
  --background-secondary-alt: {{raised}};
  --background-modifier-border: {{line}};
  --background-modifier-border-hover: {{border}};
  --background-modifier-border-focus: {{green}};
  --background-modifier-hover: {{raised}};
  --background-modifier-active-hover: {{select}};
  --background-modifier-form-field: {{surface}};
  --background-modifier-cover: rgba({{bg_oled|rgb}}, 0.7);
  --text-normal: {{fg}};
  --text-muted: {{subtext}};
  --text-faint: {{muted}};
  --text-accent: {{green}};
  --text-accent-hover: {{green_br}};
  --text-on-accent: {{bg}};
  --text-selection: {{visual}};
  --text-highlight-bg: rgba({{yellow|rgb}}, 0.3);
  --text-error: {{red}};
  --text-warning: {{yellow}};
  --text-success: {{green}};
  --interactive-normal: {{raised}};
  --interactive-hover: {{select}};
  --interactive-accent: {{green}};
  --interactive-accent-hover: {{green_br}};
  --code-background: {{surface}};
  --code-normal: {{fg}};
  --code-comment: {{comment}};
  --code-keyword: {{red}};
  --code-function: {{green}};
  --code-string: {{yellow}};
  --code-value: {{purple}};
  --code-property: {{blue}};
  --code-operator: {{orange}};
  --code-punctuation: {{subtext}};
  --code-tag: {{orange}};
  --code-important: {{orange}};
  --link-color: {{blue}};
  --link-color-hover: {{blue_br}};
  --link-unresolved-color: {{blue}};
  --link-external-color: {{blue}};
  --tag-color: {{aqua}};
  --tag-background: {{raised}};
  --scrollbar-bg: transparent;
  --scrollbar-thumb-bg: {{border}};
  --scrollbar-active-thumb-bg: {{muted}};
  --color-red: {{red}};
  --color-orange: {{orange}};
  --color-yellow: {{yellow}};
  --color-green: {{green}};
  --color-cyan: {{aqua}};
  --color-blue: {{blue}};
  --color-purple: {{purple}};
  --color-pink: {{purple_br}};
  --color-accent: {{green}};
  --color-accent-1: {{green}};
  --color-accent-2: {{green_br}};
}
