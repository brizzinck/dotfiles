/* Everforest {{variant}} for Obsidian. Generated by themes/palette/render.py. Do not edit.
   apps/obsidian/apply.sh links it into every vault as .obsidian/snippets/everforest.css (through the `current` link, so it
   follows `theme black|night`) and enables it in appearance.json; Obsidian's own theme stays the default dark one. */
.theme-dark {
  --color-base-00: {{bg}};
  --color-base-05: {{bg}};
  --color-base-10: {{surface}};
  --color-base-20: {{surface}};
  --color-base-25: {{raised}};
  --color-base-30: {{line}};
  --color-base-35: {{border}};
  --color-base-40: {{border}};
  --color-base-50: {{muted}};
  --color-base-60: {{muted}};
  --color-base-70: {{subtext}};
  --color-base-100: {{fg}};
  --background-primary: {{bg}};
  --background-primary-alt: {{surface}};
  --background-secondary: {{surface}};
  --background-secondary-alt: {{raised}};
  --background-modifier-border: {{line}};
  --background-modifier-border-hover: {{border}};
  --background-modifier-border-focus: {{green}};
  --background-modifier-hover: {{raised}};
  --background-modifier-active-hover: {{select}};
  --background-modifier-form-field: {{surface}};
  --background-modifier-cover: rgba({{bg_oled|rgb}}, 0.7);
  --text-normal: {{fg}};
  --text-muted: {{subtext}};
  --text-faint: {{muted}};
  --text-accent: {{green}};
  --text-accent-hover: {{green_br}};
  --text-on-accent: {{bg}};
  --text-selection: {{visual}};
  --text-highlight-bg: rgba({{yellow|rgb}}, 0.3);
  --text-error: {{red}};
  --text-warning: {{yellow}};
  --text-success: {{green}};
  --interactive-normal: {{raised}};
  --interactive-hover: {{select}};
  --interactive-accent: {{green}};
  --interactive-accent-hover: {{green_br}};
  --code-background: {{surface}};
  --code-normal: {{fg}};
  --code-comment: {{comment}};
  --code-keyword: {{red}};
  --code-function: {{green}};
  --code-string: {{yellow}};
  --code-value: {{purple}};
  --code-property: {{blue}};
  --code-operator: {{orange}};
  --code-punctuation: {{subtext}};
  --code-tag: {{orange}};
  --code-important: {{orange}};
  --link-color: {{blue}};
  --link-color-hover: {{blue_br}};
  --link-unresolved-color: {{blue}};
  --link-external-color: {{blue}};
  --tag-color: {{aqua}};
  --tag-background: {{raised}};
  --scrollbar-bg: transparent;
  --scrollbar-thumb-bg: {{border}};
  --scrollbar-active-thumb-bg: {{muted}};
  --color-red: {{red}};
  --color-orange: {{orange}};
  --color-yellow: {{yellow}};
  --color-green: {{green}};
  --color-cyan: {{aqua}};
  --color-blue: {{blue}};
  --color-purple: {{purple}};
  --color-pink: {{purple_br}};
  --color-accent: {{green}};
  --color-accent-1: {{green}};
  --color-accent-2: {{green_br}};
  --color-red-rgb: {{red|rgb}};
  --color-orange-rgb: {{orange|rgb}};
  --color-yellow-rgb: {{yellow|rgb}};
  --color-green-rgb: {{green|rgb}};
  --color-cyan-rgb: {{aqua|rgb}};
  --color-blue-rgb: {{blue|rgb}};
  --color-purple-rgb: {{purple|rgb}};
  --color-pink-rgb: {{purple_br|rgb}};
  --h1-color: {{red}};
  --h2-color: {{orange}};
  --h3-color: {{yellow}};
  --h4-color: {{green}};
  --h5-color: {{blue}};
  --h6-color: {{purple}};
  --bold-color: {{fg_hi}};
  --italic-color: {{fg_hi}};
  --blockquote-border-color: {{green_soft}};
  --blockquote-color: {{subtext}};
  --hr-color: {{line}};
  --divider-color: {{line}};
  --list-marker-color: {{muted}};
  --indentation-guide: {{line}};
  --checkbox-color: {{green}};
  --checkbox-border-color: {{border}};
  --caret-color: {{cursor}};
  --icon-color: {{subtext}};
  --icon-color-hover: {{fg}};
  --icon-color-active: {{green}};
  --icon-color-focused: {{fg}};
  --nav-item-background-hover: {{raised}};
  --nav-item-background-active: {{select}};
  --nav-item-color-active: {{fg}};
  --tab-background-active: {{bg}};
  --tab-text-color-focused-active: {{green}};
  --graph-line: {{border}};
  --graph-node: {{muted}};
  --graph-node-focused: {{green}};
  --graph-node-tag: {{aqua}};
  --graph-node-attachment: {{yellow}};
  --graph-node-unresolved: {{border}};
  --graph-text: {{fg}};
}
