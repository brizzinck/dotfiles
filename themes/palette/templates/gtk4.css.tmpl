/* Everforest {{variant}} for GTK 4 and libadwaita. Generated by themes/palette/render.py. Do not edit.
   Imported by .config/gtk-4.0/gtk.css (black fallback first, then the active variant). GTK apps read it at start. */
:root {
  --window-bg-color: {{bg}};
  --window-fg-color: {{fg}};
  --view-bg-color: {{bg}};
  --view-fg-color: {{fg}};
  --headerbar-bg-color: {{surface}};
  --headerbar-fg-color: {{fg}};
  --headerbar-border-color: {{line}};
  --headerbar-backdrop-color: {{bg}};
  --headerbar-shade-color: rgba(0, 0, 0, 0.36);
  --sidebar-bg-color: {{surface}};
  --sidebar-fg-color: {{fg}};
  --sidebar-backdrop-color: {{bg}};
  --sidebar-border-color: {{line}};
  --sidebar-shade-color: rgba(0, 0, 0, 0.36);
  --secondary-sidebar-bg-color: {{bg}};
  --secondary-sidebar-fg-color: {{fg}};
  --card-bg-color: {{surface}};
  --card-fg-color: {{fg}};
  --card-shade-color: rgba(0, 0, 0, 0.36);
  --popover-bg-color: {{surface}};
  --popover-fg-color: {{fg}};
  --popover-shade-color: rgba(0, 0, 0, 0.36);
  --dialog-bg-color: {{surface}};
  --dialog-fg-color: {{fg}};
  --thumbnail-bg-color: {{raised}};
  --thumbnail-fg-color: {{fg}};
  --shade-color: rgba(0, 0, 0, 0.36);
  --scrollbar-outline-color: rgba(0, 0, 0, 0.5);
  --border-color: {{border}};
  --accent-bg-color: {{green}};
  --accent-fg-color: {{bg}};
  --accent-color: {{green}};
  --destructive-bg-color: {{red}};
  --destructive-fg-color: {{bg}};
  --destructive-color: {{red}};
  --success-bg-color: {{green}};
  --success-fg-color: {{bg}};
  --success-color: {{green}};
  --warning-bg-color: {{yellow}};
  --warning-fg-color: {{bg}};
  --warning-color: {{yellow}};
  --error-bg-color: {{red}};
  --error-fg-color: {{bg}};
  --error-color: {{red}};
}

/* The same names for libadwaita versions that read @define-color, and the classic GTK names for plain GTK 4 apps. */
@define-color window_bg_color {{bg}};
@define-color window_fg_color {{fg}};
@define-color view_bg_color {{bg}};
@define-color view_fg_color {{fg}};
@define-color headerbar_bg_color {{surface}};
@define-color headerbar_fg_color {{fg}};
@define-color headerbar_border_color {{line}};
@define-color headerbar_backdrop_color {{bg}};
@define-color sidebar_bg_color {{surface}};
@define-color sidebar_fg_color {{fg}};
@define-color sidebar_backdrop_color {{bg}};
@define-color card_bg_color {{surface}};
@define-color card_fg_color {{fg}};
@define-color popover_bg_color {{surface}};
@define-color popover_fg_color {{fg}};
@define-color dialog_bg_color {{surface}};
@define-color dialog_fg_color {{fg}};
@define-color accent_bg_color {{green}};
@define-color accent_fg_color {{bg}};
@define-color accent_color {{green}};
@define-color destructive_bg_color {{red}};
@define-color destructive_fg_color {{bg}};
@define-color destructive_color {{red}};
@define-color success_color {{green}};
@define-color warning_color {{yellow}};
@define-color error_color {{red}};
@define-color theme_bg_color {{bg}};
@define-color theme_fg_color {{fg}};
@define-color theme_base_color {{bg}};
@define-color theme_text_color {{fg}};
@define-color theme_selected_bg_color {{green}};
@define-color theme_selected_fg_color {{bg}};
@define-color borders {{border}};
@define-color insensitive_fg_color {{muted}};
