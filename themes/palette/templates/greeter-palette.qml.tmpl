// Everforest {{variant}} colours for the Quickshell login screen (infrastructure/greetd/greeter). Generated by themes/palette/render.py. Do not edit.
// apply-system.sh installs the black variant as /etc/greetd/greeter/Theme.qml: the greeter is system-wide and stays on
// bg_oled like the lock screen. Alpha colours are built in QML with Theme.alpha(colour, 0.18) (QML reads #AARRGGBB,
// the palette stores #RRGGBBAA, so the glow token is not emitted as is).
pragma Singleton
import QtQuick
import Quickshell

Singleton {
    readonly property string font: "JetBrainsMono Nerd Font"

    readonly property color bgOled: "{{bg_oled}}"
    readonly property color surface: "{{surface}}"
    readonly property color raised: "{{raised}}"
    readonly property color select: "{{select}}"
    readonly property color line: "{{line}}"
    readonly property color border: "{{border}}"
    readonly property color muted: "{{muted}}"
    readonly property color subtext: "{{subtext}}"
    readonly property color fg: "{{fg}}"
    readonly property color fgHi: "{{fg_hi}}"
    readonly property color green: "{{green}}"
    readonly property color greenBr: "{{green_br}}"
    readonly property color yellow: "{{yellow}}"
    readonly property color orange: "{{orange}}"
    readonly property color blue: "{{blue}}"
    readonly property color purple: "{{purple}}"
    readonly property color red: "{{red}}"
    readonly property color aqua: "{{aqua}}"

    function alpha(colour: color, a: real): color {
        return Qt.rgba(colour.r, colour.g, colour.b, a);
    }
}
