# Everforest {{variant}}. Generated by themes/palette/render.py. Do not edit.
# Included from ~/.gitconfig (fallback black first, then ~/.local/state/theme/current).
[delta]
	syntax-theme = ansi
	minus-style = syntax "{{diff_del_bg}}"
	minus-emph-style = syntax "{{diff_del_word}}"
	plus-style = syntax "{{diff_add_bg}}"
	plus-emph-style = syntax "{{diff_add_word}}"
	line-numbers-minus-style = "{{red}}"
	line-numbers-plus-style = "{{green}}"
	line-numbers-zero-style = "{{muted}}"
	line-numbers-left-style = "{{line}}"
	line-numbers-right-style = "{{line}}"
	file-style = "{{blue}}" bold
	file-decoration-style = "{{border}}" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "{{border}}" box
	hunk-header-line-number-style = "{{muted}}"
