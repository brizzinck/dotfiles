# Everforest {{variant}} colours for hyprlock and the screensaver. Generated by themes/palette/render.py. Do not edit.
# `source`d by .config/hypr/hyprlock.conf and screensaver.conf (black fallback first, then the active variant).
# The lock screen and the screensaver stay on bg_oled (#000000) in both variants (OLED). The $ef_hex_* variables
# hold the same colours as bare hex for pango spans (## is hyprlang's escape for a literal #).
# No variable name is a prefix of another one (hyprlang substitutes textually).
$ef_bg_oled = rgb({{bg_oled|nohash}})
$ef_border = rgb({{border|nohash}})
$ef_fg = rgb({{fg|nohash}})
$ef_subtext = rgb({{subtext|nohash}})
$ef_muted = rgb({{muted|nohash}})
$ef_yellow = rgb({{yellow|nohash}})
$ef_red = rgb({{red|nohash}})
$ef_orange = rgb({{orange|nohash}})
$ef_hex_muted = ##{{muted|nohash}}
$ef_hex_red = ##{{red|nohash}}
