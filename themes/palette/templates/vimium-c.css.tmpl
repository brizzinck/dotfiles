/* Everforest {{variant}} for Vimium C (link hints, HUD, find bar, Vomnibar). Generated by themes/palette/render.py. Do not edit.
   Shipped inside browsers/vimium-c.json (userDefinedCss); built by browsers/vimium-c-build.py. Sections: ui (first), #find, #omni.
   Role map: hints = bg_oled with a green frame, typed prefix = yellow, hover/select highlights = green / yellow, HUD = surface. */
.LH,.D>.LH{background:{{bg_oled}};border:1px solid {{green}};border-radius:3px;box-shadow:none;color:{{green}}}
.BH{color:{{yellow}}}
.MC,.MH{color:{{yellow}}}
.IH{background:rgba({{green|rgb}},0.16);border:1px solid {{green}}}
.IHS{background:rgba({{yellow|rgb}},0.24);border-color:{{yellow}}}
.HUD,.HUD.D{color:{{fg}}}
.HUD:after,.HUD.D:after{background:{{surface}};border:1px solid {{line}}}
.Flash{box-shadow:0 0 4px 2px {{green}}}
.Sel{box-shadow:0 0 4px 2px {{yellow}}}
.Frame{border-color:{{green}}}
.One{border-color:{{orange}}}

/*#find*/
.r,.r.D{background:{{surface}};box-shadow:inset 0 0 1.5px 1px {{border}};color:{{fg}}}

/*#find:selection*/
background:{{visual}} !important;

/*#omni*/
body{background:{{bg}};box-shadow:0 2px 9px 0.5px rgba({{bg_oled|rgb}},0.9)}
body::after{border:1px solid {{border}}}
#bar{background:{{surface}};border-color:{{line}}}
#list{background:{{bg}}}
#input{background:{{bg}};border:1px solid {{line}};box-shadow:none;color:{{fg}}}
#toolbar{color:{{muted}}}
.button:hover{background:{{raised}};color:{{fg}}}
.item{border-color:{{line}}}
.item:hover{background-color:{{raised}}}
.p{border-color:{{border}}}
.item.s{background-color:{{select}}}
.top,match{color:{{fg}}}
match{color:{{green}}}
a{color:{{aqua}}}
.label,.time{color:{{subtext}}}
.icon,.tab,.math{fill:{{muted}};fill:var(--vc-c,{{muted}});stroke:{{muted}};stroke:var(--vc-c,{{muted}})}
