# Everforest black. Generated by themes/palette/render.py. Do not edit.
# Included from ~/.gitconfig (fallback black first, then ~/.local/state/theme/current).
[delta]
	syntax-theme = ansi
	minus-style = syntax "#2b1516"
	minus-emph-style = syntax "#4c2426"
	plus-style = syntax "#192616"
	plus-emph-style = syntax "#2c3f21"
	line-numbers-minus-style = "#e88384"
	line-numbers-plus-style = "#abc682"
	line-numbers-zero-style = "#6c7871"
	line-numbers-left-style = "#272f2b"
	line-numbers-right-style = "#272f2b"
	file-style = "#83c3c8" bold
	file-decoration-style = "#3e4843" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#3e4843" box
	hunk-header-line-number-style = "#6c7871"
