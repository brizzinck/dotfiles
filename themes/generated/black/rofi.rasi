/* Everforest black tokens for rofi (paste into a `* { }` block). Generated by themes/palette/render.py. Do not edit.
   Names follow palette.md; sel = select, dim = muted, sub = subtext are the old rofi names. */
* {
  bg-oled: #000000;
  bg: #000000;
  surface: #0d1210;
  raised: #151b18;
  select: #1e2822;
  sel: #1e2822;
  visual: #28352d;
  line: #272f2b;
  border: #3e4843;
  muted: #6c7871;
  dim: #6c7871;
  subtext: #8d998f;
  sub: #8d998f;
  fg: #dbd8c9;
  fg-hi: #e9e6db;
  green: #abc682;
  aqua: #8cc69c;
  blue: #83c3c8;
  yellow: #d9bc7f;
  orange: #ea9e77;
  red: #e88384;
  purple: #dca0bb;
}
