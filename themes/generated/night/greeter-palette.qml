// Everforest night colours for the Quickshell login screen (infrastructure/greetd/greeter). Generated by themes/palette/render.py. Do not edit.
// apply-system.sh installs the black variant as /etc/greetd/greeter/Theme.qml: the greeter is system-wide and stays on
// bg_oled like the lock screen. Alpha colours are built in QML with Theme.alpha(colour, 0.18) (QML reads #AARRGGBB,
// the palette stores #RRGGBBAA, so the glow token is not emitted as is).
pragma Singleton
import QtQuick
import Quickshell

Singleton {
    readonly property string font: "JetBrainsMono Nerd Font"

    readonly property color bgOled: "#000000"
    readonly property color surface: "#121815"
    readonly property color raised: "#19201c"
    readonly property color select: "#212c26"
    readonly property color line: "#2c3430"
    readonly property color border: "#424c47"
    readonly property color muted: "#6f7b74"
    readonly property color subtext: "#909c92"
    readonly property color fg: "#dbd8c9"
    readonly property color fgHi: "#e9e6db"
    readonly property color green: "#abc682"
    readonly property color greenBr: "#c2da9e"
    readonly property color yellow: "#d9bc7f"
    readonly property color orange: "#ea9e77"
    readonly property color blue: "#83c3c8"
    readonly property color purple: "#dca0bb"
    readonly property color red: "#e88384"
    readonly property color aqua: "#8cc69c"

    function alpha(colour: color, a: real): color {
        return Qt.rgba(colour.r, colour.g, colour.b, a);
    }
}
