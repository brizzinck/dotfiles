# btop theme: Everforest night. Generated by themes/palette/render.py. Do not edit.
# Gradients follow the semantic roles: ok = green, attention = yellow, danger = red, info = blue/aqua.
# main_bg stays empty (theme_background = false in btop.conf) so the terminal background shows through.
theme[main_bg]=""
theme[main_fg]="#dbd8c9"
theme[title]="#dbd8c9"
