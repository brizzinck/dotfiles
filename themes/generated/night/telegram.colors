dialogsVerifiedIconBg: #abc682; // chat list verified icon background
dialogsVerifiedIconFg: #0a0e0c; // chat list verified icon check
dialogsSendingIconFg: #6f7b74; // chat list sending message icon (clock)
dialogsSentIconFg: #abc682; // chat list sent message tick / double tick icon
dialogsUnreadBg: #abc682; // chat list unread badge background for not muted chat
dialogsUnreadBgMuted: #6f7b74; // chat list unread badge background for muted chat
dialogsUnreadFg: #0a0e0c; // chat list unread badge text
dialogsBgOver: #121815; // chat list background with mouse over
dialogsOnlineBadgeFg: #abc682; // chat list online status
