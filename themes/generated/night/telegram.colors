// Everforest night for Telegram Desktop. Generated by themes/palette/render.py. Do not edit.
// Derived from the stock Night theme (tdesktop Telegram/Resources/night.tdesktop-theme): every key is present, so no
// key falls back to the light Day palette. Literal colours are mapped to palette tokens by lightness/hue class, the
// keys of palette-v2.md section 5.3 and the text-on-green-fill contrast fixes are explicit. Import by hand (palette.md).
windowBg: #0a0e0c; // white: fallback for background
windowFg: #dbd8c9; // black: fallback for text
windowBgOver: #121815; // light gray: fallback for background with mouse over
windowBgRipple: #212c26; // darker gray: fallback for ripple effect
windowFgOver: #e9e6db; // black: fallback for text with mouse over
windowSubTextFg: #909c92; // gray: fallback for additional text
windowSubTextFgOver: #b4b6a7; // darker gray: fallback for additional text with mouse over
windowBoldFg: #e9e6db; // dark gray: fallback for bold text
windowBoldFgOver: #e9e6db; // dark gray: fallback for bold text with mouse over
windowBgActive: #abc682; // bright blue: fallback for blue filled active areas
windowFgActive: #0a0e0c; // white: fallback for text on active areas
windowActiveTextFg: #abc682; // online blue: fallback for active text like online status
windowShadowFg: #000000; // black: fallback for shadow
windowShadowFgFallback: #0a0e0c; // gray: fallback for shadow without opacity
shadowFg: #00000056; // most shadows (including opacity)
slideFadeOutBg: #0000003c; // slide animation (chat to profile) fade out filling
slideFadeOutShadowFg: windowShadowFg; // slide animation (chat to profile) fade out right section shadow
imageBg: #000000; // image background fallback (when photo size is less than minimum allowed)
imageBgTransparent: #e9e6db; // image background when displaying an image with opacity where no opacity is needed
activeButtonBg: #abc682; // default active button background
activeButtonBgOver: #c2da9e; // default active button background with mouse over
activeButtonBgRipple: #c2da9e; // default active button ripple effect
activeButtonFg: #0a0e0c; // default active button text
activeButtonFgOver: #0a0e0c; // default active button text with mouse over
activeButtonSecondaryFg: #2c3931; // default active button additional text (selected messages counter in forward / delete buttons)
activeButtonSecondaryFgOver: activeButtonSecondaryFg; // default active button additional text with mouse over
activeLineFg: #abc682; // default active line (like code input field bottom border when you log in and field is focused)
activeLineFgError: #e88384; // default active line for error state (like code input field bottom border when you log in and you've entered incorrect code)
lightButtonBg: #0a0e0c; // default light button background (like buttons in boxes)
lightButtonBgOver: #121815; // default light button background with mouse over
lightButtonBgRipple: #212c26; // default light button ripple effect
lightButtonFg: #abc682; // default light button text
lightButtonFgOver: lightButtonFg; // default light button text with mouse over
attentionButtonFg: #e88384; // default attention button text (like confirm button on log out)
attentionButtonFgOver: #e88384; // default attention button text with mouse over
attentionButtonBgOver: #e8838428; // default attention button background with mouse over
attentionButtonBgRipple: #e8838440; // default attention button ripple effect
outlineButtonBg: windowBg; // default left outlined button background (like shared media links in profiles)
outlineButtonBgOver: #121815; // default left outlined button background with mouse over
outlineButtonOutlineFg: #abc682; // default left outlined button left outline border
outlineButtonBgRipple: #212c26; // default left outlined button ripple effect
menuBg: #121815; // default popup menu background
menuBgOver: #212c26; // default popup menu item background with mouse over
menuBgRipple: #2c3931; // default popup menu item ripple effect
menuIconFg: #6f7b74; // default popup menu item icon (like main menu)
menuIconFgOver: #dbd8c9; // default popup menu item icon with mouse over
menuSubmenuArrowFg: #6f7b74; // default popup menu submenu arrow icon (like in message field context menu in case of RTL system language)
menuFgDisabled: #6f7b74; // default popup menu item disabled text (like unavailable items in message field context menu)
menuSeparatorFg: #2c3430; // default popup menu separator (like in message field context menu)
scrollBarBg: #424c47; // default scroll bar current rectangle, the bar itself (like in chats list)
scrollBarBgOver: #6f7b74; // default scroll bar current rectangle with mouse over it
scrollBg: #dbd8c91a; // default scroll bar background
scrollBgOver: #dbd8c92c; // default scroll bar background with mouse over the scroll bar
smallCloseIconFg: #424c47; // small X icon (like in Show all sessions box to the right for sessions termination)
smallCloseIconFgOver: #b4b6a7; // small X icon with mouse over
radialFg: #e9e6db; // default radial loader line (like in Media Viewer when loading a photo)
radialBg: #00000056; // default radial loader background (like in Media Viewer when loading a photo)
placeholderFg: #6f7b74; // default input field placeholder when field is not focused (like in phone input field when you log in)
placeholderFgActive: #6f7b74; // default input field placeholder when field is focused
inputBorderFg: #2c3430; // default input field bottom border (like in code input field when you log in and field is not focused)
filterInputBorderFg: #424c47; // default rounded input field border (like in chats list search field when field is focused)
filterInputInactiveBg: #121815; // default rounded input field background (like in chats list search field when field is inactive)
checkboxFg: #424c47; // default unchecked checkbox rounded rectangle (and also emoji category icons)
sliderBgInactive: #212c26; // default slider not active bar (like in Settings when you choose interface scale or custom notifications count)
sliderBgActive: #abc682; // default slider active bar (like in Settings when you choose interface scale or custom notifications count)
tooltipBg: #121815; // tooltip background (like when you put mouse over the message timestamp and wait)
tooltipFg: #dbd8c9; // tooltip text
tooltipBorderFg: #424c47; // tooltip border
titleShadow: #00000000; // one pixel line shadow at the bottom of custom window title
titleBg: #000000; // custom window title background when window is inactive
titleBgActive: #000000; // custom window title background when window is active
titleButtonBg: titleBg; // custom window title minimize/maximize/restore button background when window is inactive (Windows only)
titleButtonFg: #6f7b74; // custom window title minimize/maximize/restore button icon when window is inactive (Windows only)
titleButtonBgOver: #121815; // custom window title minimize/maximize/restore button background with mouse over when window is inactive (Windows only)
titleButtonFgOver: #dbd8c9; // custom window title minimize/maximize/restore button icon with mouse over when window is inactive (Windows only)
titleButtonBgActive: #000000; // custom window title minimize/maximize/restore button background when window is active (Windows only)
titleButtonFgActive: titleButtonFg; // custom window title minimize/maximize/restore button icon when window is active (Windows only)
titleButtonBgActiveOver: #121815; // custom window title minimize/maximize/restore button background with mouse over when window is active (Windows only)
titleButtonFgActiveOver: titleButtonFgOver; // custom window title minimize/maximize/restore button icon with mouse over when window is active (Windows only)
titleButtonCloseBg: titleButtonBg; // custom window title close button background when window is inactive (Windows only)
titleButtonCloseFg: titleButtonFg; // custom window title close button icon when window is inactive (Windows only)
titleButtonCloseBgOver: #e88384; // custom window title close button background with mouse over when window is inactive (Windows only)
titleButtonCloseFgOver: windowFgActive; // custom window title close button icon with mouse over when window is inactive (Windows only)
titleButtonCloseBgActive: #000000; // custom window title close button background when window is active (Windows only)
titleButtonCloseFgActive: titleButtonCloseFg; // custom window title close button icon when window is active (Windows only)
titleButtonCloseBgActiveOver: #e88384; // custom window title close button background with mouse over when window is active (Windows only)
titleButtonCloseFgActiveOver: titleButtonCloseFgOver; // custom window title close button icon with mouse over when window is active (Windows only)
titleFg: #6f7b74; // custom window title text when window is inactive (macOS only)
titleFgActive: #909c92; // custom window title text when window is active (macOS only)
trayCounterBg: #e88384; // tray icon counter background
trayCounterBgMute: #6f7b74; // tray icon counter background if all unread messages are muted
trayCounterFg: #0a0e0c; // tray icon counter text
trayCounterBgMacInvert: #e9e6db; // tray icon counter background when tray icon is pressed or when dark theme of macOS is used (macOS only)
trayCounterFgMacInvert: #e9e6db01; // tray icon counter text when tray icon is pressed or when dark theme of macOS is used (macOS only)
layerBg: #0000007f; // box and main menu background layer fade
cancelIconFg: #909c92; // default for settings close icon and box search cancel icon
cancelIconFgOver: #dbd8c9; // default for settings close icon and box search cancel icon with mouse over
boxBg: #0a0e0c; // box background
boxTextFg: windowFg; // box text
boxTextFgGood: #abc682; // accepted box text (like when choosing username that is not occupied)
boxTextFgError: #e88384; // rejecting box text (like when choosing username that is occupied)
boxTitleFg: #e9e6db; // box title text
boxSearchBg: #0a0e0c; // box search field background (like in contacts box)
boxTitleAdditionalFg: #6f7b74; // box title additional text (like in create group box when you see chosen members count)
boxTitleCloseFg: cancelIconFg; // settings close icon and box search cancel icon (like in contacts box)
boxTitleCloseFgOver: cancelIconFgOver; // settings close icon and box search cancel icon (like in contacts box) with mouse over
membersAboutLimitFg: #6f7b74; // text in channel members box about the limit (max 200 last members are shown)
contactsBg: #0a0e0c; // contacts (and some other) box row background
contactsBgOver: #121815; // contacts (and some other) box row background with mouse over
contactsNameFg: boxTextFg; // contacts (and some other) box row name text
contactsStatusFg: #6f7b74; // contacts (and some other) box row additional text (like last seen stamp)
contactsStatusFgOver: #6f7b74; // contacts (and some other) box row additional text (like last seen stamp) with mouse over
contactsStatusFgOnline: #abc682; // contacts (and some other) box row active additional text (like online status)
photoCropFadeBg: layerBg; // avatar crop box fade background (when choosing a new photo in Settings or for a group)
photoCropPointFg: #e9e6db7f; // avatar crop box corner rectangles (when choosing a new photo in Settings or for a group)
callArrowFg: #abc682; // received phone call arrow (in calls list box)
callArrowMissedFg: #e88384; // missed phone call arrow (in calls list box)
introBg: #0a0e0c; // login background
introTitleFg: #e9e6db; // login title text
introDescriptionFg: #909c92; // login description text
introErrorFg: #e88384; // login error text (like when providing a wrong log in code)
introCoverTopBg: #212c26; // intro gradient top (from)
introCoverBottomBg: #19201c; // intro gradient bottom (to)
introCoverIconsFg: #2c3931; // intro cloud graphics
introCoverPlaneTrace: #424c47; // intro plane traces
introCoverPlaneInner: #b4b6a7; // intro plane part
introCoverPlaneOuter: #909c92; // intro plane part
introCoverPlaneTop: #dbd8c9; // intro plane part
dialogsMenuIconFg: menuIconFg; // main menu and lock telegram icon
dialogsMenuIconFgOver: menuIconFgOver; // main menu and lock telegram icon with mouse over
dialogsBg: #0a0e0c; // chat list background
dialogsNameFg: #dbd8c9; // chat list name text
dialogsChatIconFg: dialogsNameFg; // chat list group or channel icon
dialogsDateFg: #6f7b74; // chat list date text
dialogsTextFg: #909c92; // chat list message text
