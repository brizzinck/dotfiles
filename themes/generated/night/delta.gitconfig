# Everforest night. Generated by themes/palette/render.py. Do not edit.
# Included from ~/.gitconfig (fallback black first, then ~/.local/state/theme/current).
[delta]
	syntax-theme = ansi
	minus-style = syntax "#311b1b"
	minus-emph-style = syntax "#532b2c"
	plus-style = syntax "#1f2c1c"
	plus-emph-style = syntax "#324527"
	line-numbers-minus-style = "#e88384"
	line-numbers-plus-style = "#abc682"
	line-numbers-zero-style = "#6f7b74"
	line-numbers-left-style = "#2c3430"
	line-numbers-right-style = "#2c3430"
	file-style = "#83c3c8" bold
	file-decoration-style = "#424c47" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#424c47" box
	hunk-header-line-number-style = "#6f7b74"
