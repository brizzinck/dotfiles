#!/usr/bin/env bash
# linux-pass: fill the Bitwarden folder `Linux` that SUPER+CTRL+U (vault.sh user-pass) types from.
# One login per Linux user: item name = user name, Username = user name, Password = that user's Linux password.
# Usable on a fresh install too: if `bw` is not logged in yet it offers to run bw-setup first.
#
#   linux-pass                 setup: for every human user of this machine (uid 1000-59999 with a login shell)
#                              plus root, ask for the Linux password (no echo, asked twice, Enter = skip) and create
#                              the missing items; users that already have an item are skipped
#   linux-pass --update NAME   replace the stored password of NAME (after `passwd`), create the item if missing
#   linux-pass --list          names stored in the folder and local users without an item (no passwords)
#   linux-pass --help          this text
#
# Needs a terminal (the passwords are typed here). Reads go through rbw (milliseconds; --list needs no bw at all, and a
# setup with nothing missing does not open bw). When rbw cannot list the vault (locked, cancelled pinentry) the folder is
# read through bw instead; when neither can, nothing is created (an unreadable folder is never an empty one). Writes go
# through vault-bw.py (BW1: the per-session bw server, no 1 s bw process per call): its session is opened with the themed
# pinentry or, with no graphical session, with a master-password prompt on this terminal; when this command unlocked it,
# it locks bw again at the end (rbw is left alone). Passwords never reach argv, the environment of this shell, a file,
# the screen or a log: each one lives in a shell variable and goes to ONE jq process through its environment.
# Test hooks: RBW_BIN, VAULT_BW (path of vault-bw.py), VAULT_RBW_CONF, LINUX_PASS_FOLDER.
set -euo pipefail

RBW=${RBW_BIN:-rbw}
FOLDER=${LINUX_PASS_FOLDER:-Linux}
VAULT_BW=${VAULT_BW:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/vault-bw.py}
RBW_CONF=${VAULT_RBW_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/rbw/config.json}

UNLOCKED_BY_US=0
BW_READY=0
FOLDER_ID=''

die() { echo "linux-pass: $*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

# every bw call goes through vault-bw.py (the per-session server, CLI fallback inside); --stdin = the body is on stdin
bwc() { python3 -I "$VAULT_BW" call "$@" </dev/null; }
bwc_in() { python3 -I "$VAULT_BW" call --stdin "$@"; }

rbw_ready() { command -v "$RBW" >/dev/null 2>&1 && [[ -s $RBW_CONF ]] && jq -e '.email != null' "$RBW_CONF" >/dev/null 2>&1; }

cleanup() {
  local rc=$?
  trap - EXIT
  unset pw pw2 PW 2>/dev/null || true
  if ((UNLOCKED_BY_US)); then
    python3 -I "$VAULT_BW" lock >/dev/null 2>&1 || true
    say "bw locked again."
  fi
  exit "$rc"
}

# make sure bw is logged in and unlocked (only when something has to be written), then sync
ensure_session() {
  ((BW_READY)) && return 0
  [[ -r $VAULT_BW ]] || die "$VAULT_BW is missing (stow the dotfiles)"
  command -v python3 >/dev/null 2>&1 || die "python3 is not installed"
  command -v jq >/dev/null 2>&1 || die "jq is not installed"
  local st ans unlock_args=()
  st=$(python3 -I "$VAULT_BW" state </dev/null 2>/dev/null || true)
  if [[ $st == unconfigured ]]; then
    say "bw is not logged in yet. bw-setup does that (server URL, e-mail, master password)."
    if command -v bw-setup >/dev/null 2>&1; then
      read -r -p "Run bw-setup now? [Y/n] " ans
      [[ ${ans:-y} =~ ^[Yy] ]] || die "run bw-setup first, then linux-pass again"
      bw-setup || die "bw-setup failed"
      st=$(python3 -I "$VAULT_BW" state </dev/null 2>/dev/null || true)
    else
      die "run bw-setup first, then linux-pass again"
    fi
  fi
  case $st in
    unconfigured) die "bw is still not logged in: run bw-setup, then linux-pass again" ;;
    missing | '') die "bw does not answer (vault-bw.py state: ${st:-nothing})" ;;
  esac
  if [[ $st != unlocked ]]; then
    UNLOCKED_BY_US=1
    if [[ -z ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]]; then
      say "Unlock bw: it asks for the master password here."
      unlock_args=(--terminal)
    fi
    python3 -I "$VAULT_BW" unlock "${unlock_args[@]}" || die "could not unlock bw"
  fi
  bwc sync >/dev/null || die "bw sync failed"
  BW_READY=1
}

# set FOLDER_ID (create the folder when asked to); the folder list is one server request
resolve_folder() {
  local create=$1 json
  ensure_session
  json=$(bwc list folders) || die "bw list folders failed"
  FOLDER_ID=$(jq -r --arg n "$FOLDER" '[.[] | select(.name == $n)][0].id // empty' <<<"$json")
  if [[ -z $FOLDER_ID && $create == 1 ]]; then
    FOLDER_ID=$(jq -nc --arg n "$FOLDER" '{name: $n}' | base64 -w0 | bwc_in create folder | jq -r '.id // empty') \
      || die "could not create the folder $FOLDER"
    [[ -n $FOLDER_ID ]] || die "could not create the folder $FOLDER"
    say "Created the Bitwarden folder $FOLDER."
  fi
  return 0
}

# the folder's items as a JSON array [{id, name}] into the global ITEMS (never in a command substitution: the bw fallback
# opens the session, and its state would be lost in the subshell). rbw first (its local copy, synced before); when rbw
# fails (locked, agent down, cancelled pinentry) bw answers instead. Returns 1 when neither could read the folder: the
# callers stop then, because an unreadable folder is not an empty folder (it used to create duplicate items).
ITEMS='[]'
RBW_STALE=0   # 1 when `rbw sync` failed: rbw's local copy may miss items made elsewhere, so the folder is read through bw
load_items() {
  local out
  if [[ $RBW_STALE != 1 ]] && rbw_ready; then
    if out=$("$RBW" list --raw 2>/dev/null) && ITEMS=$(jq -c --arg f "$FOLDER" '[.[] | select(.folder == $f) | {id, name}]' <<<"$out" 2>/dev/null); then
      return 0
    fi
    say "(rbw could not list the vault: asking bw instead)" >&2
  fi
  resolve_folder 0 || return 1
  if [[ -z $FOLDER_ID ]]; then ITEMS='[]'; return 0; fi   # bw answered: the folder does not exist yet
  out=$(bwc list items --folderid "$FOLDER_ID") || return 1
  ITEMS=$(jq -c '[.[] | {id, name}]' <<<"$out") || return 1
}

item_names() { jq -r '.[].name' <<<"$ITEMS" | sort; }

local_users() { # root first, then the human users
  echo root
  getent passwd | awk -F: '$3 >= 1000 && $3 <= 59999 && $7 != "" && $7 !~ /(nologin|false|sync|halt|shutdown)$/ {print $1}' | sort -u
}

valid_name() { [[ $1 =~ ^[a-z_][a-z0-9_.-]*\$?$ ]]; }

# read a password twice into the global pw; return 1 = skipped (empty)
ask_password() {
  local user=$1 tries=0
  pw=''
  while ((tries < 3)); do
    read -rs -p "Linux password of $user (Enter = skip): " pw || true
    echo >&2
    [[ -n $pw ]] || return 1
    read -rs -p "Again to confirm: " pw2 || true
    echo >&2
    if [[ $pw == "$pw2" ]]; then pw2=''; return 0; fi
    echo "The two entries differ, try again." >&2
    pw='' pw2=''
    tries=$((tries + 1))
  done
  pw=''
  return 1
}

create_item() { # NAME, password in the global pw
  local name=$1 out
  out=$(PW=$pw jq -nc --arg n "$name" --arg f "$FOLDER_ID" \
    '{type: 1, name: $n, notes: null, favorite: false, folderId: $f, fields: [], reprompt: 0,
      login: {username: $n, password: env.PW, totp: null, uris: []}}' \
    | base64 -w0 | bwc_in create item) || return 1
  jq -e '.id' >/dev/null <<<"$out"
}

update_item() { # NAME, password in the global pw
  local name=$1 id item
  id=$(jq -r --arg n "$name" '[.[] | select(.name == $n)][0].id // empty' <<<"$ITEMS")
  [[ -n $id ]] || return 2
  item=$(bwc get item "$id") || return 1
  PW=$pw jq -c '.login.password = env.PW' <<<"$item" | base64 -w0 | bwc_in edit item "$id" >/dev/null
}

finish_sync() {
  # bw's own create / edit already reached the server; rbw only has to fetch it
  if command -v "$RBW" >/dev/null 2>&1; then "$RBW" sync >/dev/null 2>&1 || say "(rbw sync failed: SUPER+CTRL+U may see the new items after the next vault sync)"; fi
}

show_list() { # re-reads the folder: it changed since the last load
  load_items || { say "(could not re-read the folder $FOLDER)"; return 0; }
  say "Folder $FOLDER:"
  item_names | sed 's/^/  /'
}

# rbw sees what the web vault / other devices changed after a sync (one network call, no bw)
rbw_refresh() {
  rbw_ready || return 0
  if ! "$RBW" sync >/dev/null 2>&1; then
    RBW_STALE=1
    say "(rbw sync failed: its copy of the vault may be stale, reading the folder through bw)"
  fi
  return 0
}

cmd_setup() {
  local u made=0 skipped=0 existing missing=()
  rbw_refresh
  load_items || die "could not read the folder $FOLDER (rbw and bw both failed): nothing was created"
  existing=$(item_names)
  while IFS= read -r u; do
    grep -Fxq -- "$u" <<<"$existing" || missing+=("$u")
  done < <(local_users)
  if ((${#missing[@]} == 0)); then
    say "Folder $FOLDER already has an item for every local user; nothing to ask. (linux-pass --update NAME replaces one.)"
    show_list
    return 0
  fi
  resolve_folder 1                # bw is only opened now that something has to be written
  say "Folder $FOLDER is ready ($(grep -c . <<<"$existing" || true) item(s))."
  while IFS= read -r -u 3 u; do
    if grep -Fxq -- "$u" <<<"$existing"; then
      say "  $u: already stored, skipped (linux-pass --update $u replaces it)"
      skipped=$((skipped + 1))
      continue
    fi
    if ask_password "$u"; then
      if create_item "$u"; then say "  $u: stored"; made=$((made + 1)); else say "  $u: bw could not create the item" >&2; fi
    else
      say "  $u: skipped"
    fi
    pw=''
  done 3< <(local_users) # fd 3: the password prompts read from the terminal
  unset pw pw2
  finish_sync
  say "Created $made item(s), $skipped already there."
  show_list
}

cmd_update() {
  local name=$1 rc
  valid_name "$name" || die "'$name' is not a valid user name"
  getent passwd "$name" >/dev/null || say "note: there is no local user '$name'."
  rbw_refresh
  resolve_folder 1
  load_items || die "could not read the folder $FOLDER (rbw and bw both failed): nothing was changed"
  ask_password "$name" || die "no password given, nothing changed"
  rc=0
  update_item "$name" || rc=$?
  case $rc in
    0) say "$name: password replaced." ;;
    2) create_item "$name" || die "bw could not create the item"
       say "$name: no item yet, created." ;;
    *) pw=''; die "bw could not update the item" ;;
  esac
  pw=''
  unset pw pw2
  finish_sync
  show_list
}

cmd_list() {
  local names u
  rbw_refresh
  load_items || die "could not read the folder $FOLDER (rbw and bw both failed)"
  names=$(item_names)
  if [[ -z $names ]]; then
    say "The folder $FOLDER has no items yet (or does not exist): run linux-pass."
  else
    show_list
  fi
  say "Local users without an item:"
  local any=0
  while IFS= read -r u; do
    grep -Fxq -- "$u" <<<"$names" && continue
    say "  $u"; any=1
  done < <(local_users)
  ((any)) || say "  (none)"
}

mode=setup name=''
while (($#)); do
  case $1 in
    -h | --help) usage; exit 0 ;;
    --list) mode=list; shift ;;
    --update) name=${2:-}; [[ -n $name ]] || die "--update needs a user name"; mode=update; shift 2 ;;
    *) echo "linux-pass: unknown option $1 (see --help)" >&2; exit 2 ;;
  esac
done

if [[ $mode != list ]]; then
  [[ -t 0 ]] || die "needs a terminal: the passwords are typed here"
fi
trap cleanup EXIT
case $mode in
  setup) cmd_setup ;;
  update) cmd_update "$name" ;;
  list) cmd_list ;;
esac
