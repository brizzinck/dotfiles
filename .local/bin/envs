#!/usr/bin/python3 -I
"""envs: per-project environments with secrets from Bitwarden (DEV-b). Python 3 stdlib only; the shebang is the absolute
/usr/bin/python3 -I (never a PATH lookup: a project's pinned Python or `_.path` must not run in place of envs).

  envs                          the TUI: projects -> environments -> variables
  envs init [--project NAME] [--envs dev,stage,prod] [--default dev]
                                write .envs.toml in the git top-level (or cwd), add .env* to .gitignore, bind (mise trust only on request)
  envs bind                     confirm the root -> Env/<project> binding; needs a terminal (never trusts mise by itself); the project
                                name is typed when Env/<project> is already bound elsewhere or the repository at a bound path changed
  envs trust                    `mise trust` for this root, after a separate question that lists the config files
  envs status [--json]          project, root, binding, active env, declared names; with an unlocked vault per env: set /
                                missing / extra (no values)
  envs use [ENV] [--prod] [--for 60m]   select the active env of this root (picker without ENV); the default env clears it
  envs run [-e ENV] [--prod] [--sync] [--no-mise] [--allow-missing] [--only NAME,NAME] -- CMD [ARGS...]
                                run CMD with the declared secrets of the env in ITS environment only (exec, nothing stays)
  envs set NAME [-e ENV | --all] [--plain] [--stdin] [--description TEXT]
                                secret: value from a hidden prompt (asked twice) or --stdin, into the env item(s); --plain:
                                into .mise.toml [env] (or .mise.ENV.toml with -e). A value on the command line is refused
  envs unset NAME [-e ENV | --all] [--undeclare]
  envs rename OLD NEW           the field in every env item + the declaration (+ mise files when plain)
  envs copy SRC DST [--overwrite]   copy secret values between envs (default: only names missing in DST)
  envs diff [A B]               per name: set/missing in each, same/differs (compared in memory, never printed)
  envs env new|rename|delete ...    manage environments (item + .envs.toml list; delete = Bitwarden trash, typed confirmation)
  envs project rename NEW | delete  folder rename / items to the trash + folder delete, typed confirmation
  envs convert NAME [--prod]    secret <-> plain (the value moves between Bitwarden and .mise*.toml; protected envs: typed name)
  envs import [FILE] [-e ENV] [--secrets A,B] [--plain C,D] [--keep]   move a .env file into Bitwarden / .mise.toml
  envs export-example [-o .env.example]   names only
  envs copy-value NAME [-e ENV] copy one value (wl-copy --sensitive, cleared after 30 s); no command prints a value
  envs check [--all]            the project (or every bound root): toml, names, binding, conflicts with mise [env], untracked
                                .env* files, tracked .env, mise trust and tools, and with an unlocked vault: items, duplicates,
                                missing and undeclared fields

Files. `.envs.toml` (committed, names only): project, environments, default, protected, [secrets] NAME = "description".
Values: Bitwarden folder `Env/<project>`, one Secure Note per environment named exactly like it, one hidden custom field per
secret. Non-secret variables: mise [env] (`.mise.toml`, `.mise.ENV.toml`). State: ~/.local/state/envs/{active,bindings}.tsv.
Secrets go ONLY into the command (`envs run`); nothing here prints a value, puts one in argv, a log or a file. Agents (claude,
codex, gemini, ... as an ancestor process, or $CLAUDECODE) get names-only commands and nothing else. `prod`/`production` and
`protected = [...]` need --prod (or a typed confirmation) and are logged to the journal (no values).
Exit codes: 0 ok, 1 error, 2 usage, 3 vault locked and no tty, 4 refused (agent, protected without --prod, unbound), 130 cancel.
Test hooks (only when ENVS_TOOL_PATH resolves below <repo>/infrastructure/tests/ AND XDG_STATE_HOME / XDG_RUNTIME_DIR point
away from the real ones; otherwise every hook is dropped and rbw, bw, pinentry, wl-copy come from /usr/bin only): ENVS_TOOL_PATH
(fake tools), ENVS_TEST_ROOT_PID, ENVS_TEST_YES, ENVS_NO_JOURNAL, RBW_BIN, BW_BIN, PINENTRY_BIN (inside that directory).
"""
import contextlib
import fcntl
import json
import os
import pwd
import re
import select
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

sys.dont_write_bytecode = True
os.umask(0o077)

SELF = Path(__file__).resolve()
REPO = SELF.parents[2]               # ~/dotfiles for the owner, /srv/dotfiles for managed users
VAULT_BW = REPO / ".config/hypr/scripts/vault-bw.py"
HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)          # the account's home, not $HOME (a project [env] can set that)
SAFE_DIRS = ["/usr/bin", "/usr/local/bin", str(HOME / ".local/bin")]
PY = "/usr/bin/python3" if os.access("/usr/bin/python3", os.X_OK) else sys.executable
ORIG_PATH = os.environ.get("PATH", "")                 # the user's PATH: only the final command gets it back


def _under(path, root):
    rp, rr = os.path.realpath(path), os.path.realpath(root)
    return rp == rr or rp.startswith(rr + os.sep)


def _verified_test_dirs():
    """ENVS_TOOL_PATH counts only when every entry is below <repo>/infrastructure/tests AND the state and runtime directories
    are not the real ones (the fakes must not write bindings or a bw session into the owner's account). Anything else: no
    test mode, no hooks (an agent that sets them gets nothing, a project's [env] cannot switch the checks off)."""
    dirs = [d for d in (os.environ.get("ENVS_TOOL_PATH") or "").split(":") if d]
    if not dirs or not all(_under(d, REPO / "infrastructure/tests") for d in dirs):
        return []
    real = {os.path.realpath(HOME / ".local/state"), os.path.realpath(f"/run/user/{os.getuid()}")}
    for var in ("XDG_STATE_HOME", "XDG_RUNTIME_DIR"):
        v = os.environ.get(var)
        if not v or os.path.realpath(v) in real:
            return []
    return [os.path.realpath(d) for d in dirs]


TEST_DIRS = _verified_test_dirs()
SECRET_TOOLS = {"rbw", "bw", "pinentry", "wl-copy"}    # these never resolve outside the test directory in test mode
# names a test (or a project's [env]) could use to redirect the vault tools; dropped from our environment outside test mode
# and put back for the command we run (envs must not change what a command sees)
HOOK_ENV = ("ENVS_GLOBAL_DIR", "ENVS_TOOL_PATH", "ENVS_TEST_ROOT_PID", "ENVS_TEST_YES", "ENVS_NO_JOURNAL", "RBW_BIN", "BW_BIN", "PINENTRY_BIN",
            "BW_DOWNLOAD_DIR", "VAULT_RBW_CONF", "VAULT_BW_IDLE", "VAULT_BW_SERVE_POLL", "VAULT_BW_RBW_POLL", "VAULT_BW_NODUMP",
            "VAULT_BW_NODUMP_SRC", "VAULT_BW_UNIT", "VAULT_BW_SYSTEMD_RUNTIME", "VAULT_BW_SERVE", "VAULT_BW_LAUNCH",
            "VAULT_TERMINAL", "VAULT_CLEAR_AFTER")
PINNED = {}                                            # name -> the value the shell had (None = unset)


def harden_environment():
    """Outside test mode: no hook variables, our own subprocesses find tools in SAFE_DIRS only, and the state, runtime and
    config directories are the account's (a trusted project's mise [env] may set any variable)."""
    if TEST_DIRS:
        return
    for k in HOOK_ENV:
        if k in os.environ:
            PINNED[k] = os.environ.pop(k)
    for k, v in (("XDG_STATE_HOME", str(HOME / ".local/state")), ("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
                 ("XDG_CONFIG_HOME", str(HOME / ".config"))):
        if os.environ.get(k) != v:
            PINNED[k] = os.environ.get(k)
            os.environ[k] = v
    os.environ["PATH"] = ":".join(SAFE_DIRS)


def command_env(base):
    """The environment of the final command: what the shell had (user PATH, hook variables) plus nothing of ours."""
    out = dict(base)
    for k, v in PINNED.items():
        if v is None:
            out.pop(k, None)
        else:
            out[k] = v
    out["PATH"] = ORIG_PATH
    return out


def git_env():
    """A clean environment for git: GIT_DIR / GIT_WORK_TREE / GIT_CONFIG_* from a project's [env] must not steer it."""
    return {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}


TOML = ".envs.toml"
MASK = "•" * 8

NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,62}$")
ENV_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
RESERVED = {"PATH", "HOME", "USER", "SHELL", "PWD", "TERM", "LANG", "IFS", "PYTHONPATH", "PYTHONSTARTUP", "PYTHONHOME",
            "NODE_OPTIONS", "NODE_PATH", "BW_SESSION", "SSH_AUTH_SOCK", "XDG_RUNTIME_DIR", "XDG_STATE_HOME", "XDG_CONFIG_HOME",
            "WAYLAND_DISPLAY", "BASH_ENV", "ENV", "ZDOTDIR", "GLIBC_TUNABLES", "GCONV_PATH", "PERL5OPT", "PERL5LIB", "RUBYOPT",
            "RUBYLIB", "GIT_DIR", "GIT_WORK_TREE", "GIT_SSH_COMMAND", "GIT_EXEC_PATH", "GIT_ASKPASS", "BW_BIN", "RBW_BIN",
            "PINENTRY_BIN"}
RESERVED_PREFIX = ("MISE_", "ENVS_", "__MISE", "LD_", "GIT_CONFIG", "VAULT_BW_")
ALWAYS_PROTECTED = {"prod", "production"}
AGENTS = {"claude", "codex", "gemini", "claude-agent-ac", "claude-agent-acp", "codex-acp"}   # comm is cut at 15 characters
AGENT_RUNNERS = {"node", "bun", "python3", "python", "deno"}                                 # a script run by an interpreter
AGENT_PATHS = ("/claude-code/", "/gemini-cli/", "/@openai/codex/", "/claude-agent-acp/", "/codex-acp/")
MISE_BASE = [".mise.toml", "mise.toml", ".config/mise.toml", "mise/config.toml"]
MISE_MARKERS = MISE_BASE + [".tool-versions", ".nvmrc", ".node-version", ".python-version", ".mise/config.toml"]
FIELD_LIMIT = 4000
SECRET_HINT = re.compile(r"KEY|SECRET|TOKEN|PASS|PWD|PRIVATE|CREDENTIAL|AUTH|DSN|API", re.I)


class Fail(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.msg, self.code = msg, code


def fail(msg, code=1):
    raise Fail(msg, code)


def say(msg=""):
    print(msg)


def warn(msg):
    print(f"envs: {msg}", file=sys.stderr)


def tty():
    return sys.stdin.isatty() and sys.stderr.isatty()


def test_mode():
    return bool(TEST_DIRS)


# ───────────────────────────── tools and agent check ─────────────────────────────

def tool(name, env=None, required=True):
    """Absolute path of an external tool, from /usr/bin:/usr/local/bin:~/.local/bin only (a trusted project's [env] can
    prepend PATH). Test mode (verified ENVS_TOOL_PATH, see _verified_test_dirs) looks in the fake directory first and, for the
    vault tools (rbw, bw, pinentry, wl-copy), ONLY there, so a test can never reach the real vault. An absolute RBW_BIN /
    BW_BIN / PINENTRY_BIN counts only in test mode and only inside that directory; outside it the variables are ignored."""
    if env and TEST_DIRS:
        v = os.environ.get(env)
        if v and os.path.isabs(v):
            if os.access(v, os.X_OK) and any(_under(v, d) for d in TEST_DIRS):
                return v
        elif v:
            name = os.path.basename(v)
    dirs = list(TEST_DIRS) + ([] if TEST_DIRS and name in SECRET_TOOLS else SAFE_DIRS)
    for d in dirs:
        p = os.path.join(d, name)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    if required:
        fail(f"{name} is not installed", 1)
    return None


def proc_comm(pid):
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def proc_ppid(pid):
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def proc_exe(pid):
    """realpath of the executable of PID (the kernel's view: it cannot be spoofed through argv[0] or exec -a)."""
    try:
        return os.path.realpath(os.readlink(f"/proc/{pid}/exe"))
    except OSError:
        return ""


def proc_argv(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except OSError:
        return []


def agent_context():
    """The name of the agent this process runs under (an ancestor's /proc comm up to pid 1, or an interpreter running an agent
    script), or $CLAUDECODE. Tests stop the walk at ENVS_TEST_ROOT_PID (only in verified test mode)."""
    if os.environ.get("CLAUDECODE"):
        return "claude (CLAUDECODE)"
    stop = 0
    if test_mode():
        try:
            stop = int(os.environ.get("ENVS_TEST_ROOT_PID", "0"))
        except ValueError:
            stop = 0
    pid, seen = os.getpid(), 0
    while pid > 1 and seen < 64:
        if pid == stop:
            break
        comm = proc_comm(pid)
        if comm in AGENTS:
            return comm
        if comm in AGENT_RUNNERS:
            for a in proc_argv(pid)[1:4]:
                text = a.decode("utf-8", "replace")
                base = os.path.basename(text)
                if base in AGENTS or base.removesuffix(".js") in AGENTS or base.removesuffix(".mjs") in AGENTS:
                    return base
                hit = next((m for m in AGENT_PATHS if m in text + "/"), None)    # node .../node_modules/@openai/codex/bin/codex.js
                if hit:
                    return hit.strip("/")
        pid = proc_ppid(pid)
        seen += 1
    return None


def refuse_agent(what):
    a = agent_context()
    if a:
        fail(f"{what} is refused inside an agent ({a}): secrets are never handed to agents; names-only commands "
             "(status, check, diff, export-example) still work", 4)


# ───────────────────────────── state and locks ─────────────────────────────

def state_dir():
    d = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "envs"
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    return d


def run_dir():
    base = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
    d = base / "envs"
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    return d


@contextlib.contextmanager
def write_lock():
    fd = os.open(run_dir() / "write.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_tsv(path):
    try:
        text = Path(path).read_text()
    except OSError:
        return []
    return [line.split("\t") for line in text.splitlines() if line.strip()]


def atomic_write(path, text):
    path = Path(path)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def write_tsv(path, rows):
    atomic_write(path, "".join("\t".join(r) + "\n" for r in rows))


def active_rows(now=None):
    now = now if now is not None else time.time()
    out = []
    for r in read_tsv(state_dir() / "active.tsv"):
        if len(r) >= 4:
            try:
                until = int(r[2])
            except ValueError:
                continue
            if until == 0 or until > now:
                out.append(r[:4])
    return out


def active_get(root):
    """(env, until, kind) of the unexpired selection of this root, else None."""
    for r in active_rows():
        if r[0] == str(root):
            return r[1], int(r[2]), r[3]
    return None


def active_set(root, env, until=0, kind="-"):
    rows = [r for r in active_rows() if r[0] != str(root)]
    if env is not None:
        rows.append([tsv_safe(root), env, str(int(until)), kind])
    write_tsv(state_dir() / "active.tsv", rows)


def tsv_safe(text):
    """Paths go into tab-separated state files: a tab or newline in one would forge extra rows."""
    t = str(text)
    if any(ord(c) < 0x20 or ord(c) == 0x7F for c in t):
        fail(f"{t!r} contains a control character (tab, newline ...): rename the directory", 1)
    return t


def git_common_dir(root):
    """(realpath of the git common dir shared by every worktree of the repo, top-level directory) read from .git without a
    process, or (None, None) = not a git checkout we trust. A `.git` FILE counts only for a real linked worktree: its gitdir
    must hold `commondir` and a `gitdir` back-link that resolves to this very file AND lie inside `<common>/worktrees/`, so an
    unpacked archive whose `.git` says `gitdir: ../billing/.git` or `gitdir: fakegit` (its own forged `commondir` + back-link)
    or is a `.git` symlink cannot borrow another checkout's binding. git itself is never asked: it
    trusts the same file."""
    d = Path(root).resolve()
    for cand in [d, *d.parents]:
        g = cand / ".git"
        try:
            if g.is_symlink():
                return None, None
            if g.is_dir():
                return os.path.realpath(g), cand
            if g.is_file():
                line = g.read_text().strip()
                if not line.startswith("gitdir:"):
                    return None, None
                gd = Path(line[7:].strip())
                gd = gd if gd.is_absolute() else (cand / gd)
                cd, back = gd / "commondir", gd / "gitdir"
                if not (cd.is_file() and back.is_file()):
                    return None, None
                b = Path(back.read_text().strip())
                b = b if b.is_absolute() else (gd / b)
                if os.path.realpath(b) != os.path.realpath(g):
                    return None, None
                c = Path(cd.read_text().strip())
                common = os.path.realpath(c if c.is_absolute() else gd / c)
                # the gitdir must be one of the common dir's own `worktrees/<name>`: an archive can ship `commondir` and the
                # back-link, but it cannot put a directory into another clone's .git/worktrees
                if os.path.realpath(gd.parent) != os.path.join(common, "worktrees"):
                    return None, None
                return common, cand
        except OSError:
            return None, None
    return None, None


def binding_key(root):
    """One binding per (repository, directory in it): the git common dir, plus `//relative/path` for a root below the
    top-level (monorepo); a non-git root is its realpath."""
    common, top = git_common_dir(root)
    real = os.path.realpath(root)
    if common is None:
        return tsv_safe(real)
    rel = os.path.relpath(real, os.path.realpath(top))
    return tsv_safe(common if rel == "." else f"{common}//{rel}")


def key_root(key):
    common, _, rel = key.partition("//")
    if os.path.basename(common) == ".git":
        base = os.path.dirname(common)
        return os.path.join(base, rel) if rel else base
    return key


def bindings():
    return {r[0]: r for r in read_tsv(state_dir() / "bindings.tsv") if len(r) >= 3}


def repo_identity(root):
    """The root commit(s) of the repository ROOT belongs to (comma separated, at most 8), or `-` when it is not a git checkout
    we trust, has no commit yet or git cannot say. Stored with a binding: a different repository that later lands on a bound
    path (the old one deleted or moved) does not have the old one's root commit."""
    common, _top = git_common_dir(root)
    git = tool("git", required=False)
    if common is None or not git:
        return "-"
    try:
        p = subprocess.run([git, "--git-dir", common, "rev-list", "--max-parents=0", "--all"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, env=git_env(), timeout=10)
    except (OSError, subprocess.SubprocessError):
        return "-"
    ids = sorted(set(re.findall(r"^[0-9a-f]{40,64}$", p.stdout, re.M)))[:8]
    return ",".join(ids) or "-"


def stored_identity(row):
    return row[3] if len(row) > 3 and row[3] else "-"


def same_lineage(root, stored):
    """Does the repository at ROOT hold one of the STORED root commits (comma separated)? Either it is among the root commits
    now, or the commit still exists here: a shallow clone reports its shallow boundary as a root, and that set changes after a
    `git fetch --depth` or `--unshallow` (the same repository, a different set)."""
    ids = [i for i in stored.split(",") if re.fullmatch(r"[0-9a-f]{40,64}", i)]
    if not ids:
        return False
    if set(ids) & set(repo_identity(root).split(",")):
        return True
    common, _top = git_common_dir(root)
    git = tool("git", required=False)
    if common is None or not git:
        return False
    for i in ids:
        try:
            p = subprocess.run([git, "--git-dir", common, "cat-file", "-e", f"{i}^{{commit}}"], capture_output=True,
                               stdin=subprocess.DEVNULL, env=git_env(), timeout=10)
        except (OSError, subprocess.SubprocessError):
            return False
        if p.returncode == 0:
            return True
    return False


def binding_state(root, project):
    """('bound'|'unbound'|'changed'|'moved', key, old project): `changed` = the project name differs from the bound one,
    `moved` = same name, but the repository here is not the one that was bound (root commit differs). The identity is the
    LINEAGE of the repository, not trust: a fork or clone shares the root commit (documented limit)."""
    if is_global_root(root):                      # the global scope has no checkout to bind (see load_global)
        return "bound", str(root), project
    key = binding_key(root)
    b = bindings().get(key)
    if not b:
        return "unbound", key, None
    if b[1] != project:
        return "changed", key, b[1]
    stored = stored_identity(b)
    if stored != "-" and not same_lineage(root, stored):
        return "moved", key, b[1]
    return "bound", key, b[1]


def moved_keys(root, project):
    """Keys of rows for Env/PROJECT whose root is GONE and whose stored root commit is in the repository at ROOT: the same
    repository moved or renamed (`~/job/billing` -> `~/work/billing`), not a second place that holds the project's secrets."""
    key = binding_key(root)
    out = []
    for k, r in bindings().items():
        if r[1] != project or k == key or os.path.exists(key_root(k)):
            continue
        st = stored_identity(r)
        if st != "-" and same_lineage(root, st):
            out.append(k)
    return out


def bound_elsewhere(root, project):
    """Roots (other than ROOT's own binding) that are bound to Env/PROJECT; a move of this very repository (see moved_keys)
    is not one."""
    key = binding_key(root)
    moved = set(moved_keys(root, project))
    return [key_root(k) for k, r in bindings().items() if r[1] == project and k != key and k not in moved]


def bind_write(root, project, locked=False):
    """Record the binding; LOCKED = the caller already holds write_lock (flock on a second descriptor would deadlock)."""
    key = binding_key(root)
    ident = repo_identity(root)
    moved = set(moved_keys(root, project))        # the old row of a repository that moved here is replaced, not kept

    def write():
        rows = [r for r in bindings().values() if r[0] != key and r[0] not in moved]
        rows.append([key, project, time.strftime("%Y-%m-%dT%H:%M:%S%z"), ident])
        write_tsv(state_dir() / "bindings.tsv", rows)
    if locked:
        write()
    else:
        with write_lock():
            write()


def upgrade_identity(root, project):
    """A binding written before identities existed (or before the first commit) learns the repository's root commit the
    first time it is used while bound: from then on a different repository at this path is `moved`."""
    key = binding_key(root)
    b = bindings().get(key)
    if not b or b[1] != project or stored_identity(b) != "-":
        return
    ident = repo_identity(root)
    if ident == "-":
        return
    with write_lock():
        b = bindings().get(key)
        if b and b[1] == project and stored_identity(b) == "-":
            rows = [r for r in bindings().values() if r[0] != key]
            rows.append([key, project, b[2], ident])
            write_tsv(state_dir() / "bindings.tsv", rows)


# ───────────────────────────── .envs.toml and mise files ─────────────────────────────

def bad_var_name(n):
    if not isinstance(n, str) or not NAME_RE.match(n):
        return "is not a valid variable name"
    if n in RESERVED or n.startswith(RESERVED_PREFIX):
        return "is a reserved name (PATH, HOME, LD_*, MISE_*, ENVS_*, BW_SESSION ...)"
    return None


def find_root(start=None):
    d = Path(start or os.getcwd()).resolve()
    while True:
        if (d / TOML).is_file():
            tsv_safe(d)
            return d
        if d.parent == d:
            fail(f"no {TOML} here or above: run `envs init` in the project", 1)
        d = d.parent


def mise_files(root):
    """Existing mise config files of the root: [(path, env or None)]."""
    out = []
    for rel in MISE_BASE:
        if (root / rel).is_file():
            out.append((root / rel, None))
    for p in sorted(root.glob(".mise.*.toml")) + sorted(root.glob("mise.*.toml")):
        m = re.match(r"^\.?mise\.([a-z][a-z0-9_-]*)\.toml$", p.name)
        if m and p.name not in ("mise.local.toml",) and m.group(1) != "local":
            out.append((p, m.group(1)))
    return out


def mise_env_keys(root):
    """{variable: [file names]} of the [env] tables of the mise files (the `_` directive table is not a variable)."""
    keys = {}
    for p, _env in mise_files(root):
        try:
            doc = tomllib.loads(p.read_text())
        except (OSError, ValueError):
            continue
        env = doc.get("env")
        if isinstance(env, dict):
            for k in env:
                if k != "_":
                    keys.setdefault(k, []).append(p.name)
    return keys


def parent_mise_overrides(cfg):
    """[(name, file)]: declared secrets that a mise [env] ABOVE the root (parent directories, the global config) also sets;
    `mise exec` would let that value win over the injected secret without a word."""
    out, names = [], set(cfg.secrets)
    if not names:
        return out
    cands = []
    for d in Path(cfg.root).parents:
        cands += [d / rel for rel in MISE_BASE[:3]]
    cands.append(HOME / ".config/mise/config.toml")
    for f in cands:
        try:
            doc = tomllib.loads(f.read_text())
        except (OSError, ValueError):
            continue
        env = doc.get("env")
        if isinstance(env, dict):
            out += [(k, str(f)) for k in env if k in names]
    return out


def has_mise_config(root):
    return any((root / m).exists() for m in MISE_MARKERS) or bool(mise_files(root))


def mise_target(root, env=None, default=None):
    """The file plain variables of ENV go to: the existing base file (or .mise.toml) for the default env / every env,
    .mise.ENV.toml for another one."""
    if env is None or env == default:
        for rel in MISE_BASE:
            if (root / rel).is_file():
                return root / rel
        return root / ".mise.toml"
    return root / f".mise.{env}.toml"


class Cfg:
    def __init__(self, root, data, text, problems):
        self.root, self.data, self.text, self.problems = Path(root), data, text, problems
        self.path = self.root / TOML
        self.project = data.get("project", "")
        self.envs = list(data.get("environments", []))
        self.default = data.get("default", "")
        self.protected = set(data.get("protected", [])) | ALWAYS_PROTECTED
        self.secrets = dict(data.get("secrets", {}))
        self.is_global = False

    def is_protected(self, env):
        return env in self.protected

    @property
    def folder(self):
        return f"Env/{self.project}"


def validate(data, root=None):
    p = []
    known = {"project", "environments", "default", "protected", "secrets", "db", "api", "ci"}
    for k in data:
        if k not in known:
            p.append(f"unknown key {k!r} (allowed: project, environments, default, protected, [secrets], and the tables [db.NAME], "
                     "[api], [ci] that the db / api / ci launchers read)")
    for k in ("db", "api", "ci"):             # the launchers validate their own fields (`db check`); here only the shape
        if k in data and not isinstance(data[k], dict):
            p.append(f"[{k}] must be a table")
    if isinstance(data.get("db"), dict) and not all(isinstance(v, dict) for v in data["db"].values()):
        p.append("[db] holds one table per connection: [db.NAME]")
    proj = data.get("project")
    if not isinstance(proj, str) or not PROJECT_RE.match(proj):
        p.append("project must match ^[a-z0-9][a-z0-9._-]{0,62}$")
    envs = data.get("environments")
    if not isinstance(envs, list) or not envs or not all(isinstance(e, str) for e in envs):
        p.append("environments must be a non-empty list of names")
        envs = []
    else:
        for e in envs:
            if not ENV_RE.match(e):
                p.append(f"environment {e!r} must match ^[a-z][a-z0-9_-]{{0,31}}$")
        if len(set(envs)) != len(envs):
            p.append("environments must be unique")
    default = data.get("default")
    if envs and default not in envs:
        p.append("default must be one of the environments")
    prot = data.get("protected", [])
    if not isinstance(prot, list) or not all(isinstance(e, str) for e in prot):
        p.append("protected must be a list of environment names")
    else:
        for e in prot:
            if envs and e not in envs:
                p.append(f"protected environment {e!r} is not in environments")
        if isinstance(default, str) and (default in ALWAYS_PROTECTED or default in prot):
            p.append(f"default {default!r} is protected: the default environment is the one every plain command uses, "
                     "so a protected environment (prod ...) cannot be it")
    sec = data.get("secrets", {})
    if not isinstance(sec, dict):
        p.append("[secrets] must be a table of NAME = \"description\"")
        sec = {}
    for n, d in sec.items():
        why = bad_var_name(n)
        if why:
            p.append(f"secret {n!r} {why}")
        if not isinstance(d, str):
            p.append(f"secret {n}: the description must be a string (may be empty)")
    if root is not None:
        keys = mise_env_keys(root)
        for n in sec:
            if n in keys:
                p.append(f"{n} is a secret and also a key of mise [env] ({', '.join(keys[n])}): it can be only one")
    return p


def load_cfg(root=None, strict=True):
    root = Path(root) if root else find_root()
    if is_global_root(root):
        return load_global(strict)
    path = root / TOML
    try:
        text = path.read_text()
    except OSError as e:
        fail(f"cannot read {path}: {e}")
    try:
        data = tomllib.loads(text)
    except ValueError as e:
        if strict:
            fail(f"{path}: {e}")
        return Cfg(root, {}, text, [f"toml: {e}"])
    problems = validate(data, root)
    if problems and strict:
        fail(f"{path}:\n  " + "\n  ".join(problems))
    return Cfg(root, data, text, problems)


# the global scope (`envs run -g`): secrets that belong to no repository (GitLab token ...). Folder Env/global, one Secure Note
# `default`. Declared in ~/.config/envs/global.toml (stowed, public: names only) plus the optional, non-repo
# ~/.config/envs/global.local.toml (more [secrets] and [db.*]); no binding (both files are the owner's own, checked below),
# no mise, no active selection.

GLOBAL_TOML, GLOBAL_LOCAL = "global.toml", "global.local.toml"
GLOBAL_LOCAL_HEADER = ("# Extra global secrets and connections of this machine (not in the dotfiles repo): names only, the values are in\n"
                       "# Bitwarden Env/global (item `default`). `envs set NAME -g` declares a new name here.\n")


def global_dir():
    v = os.environ.get("ENVS_GLOBAL_DIR") if TEST_DIRS else None      # test hook, verified test mode only
    return Path(v) if v else HOME / ".config/envs"


def is_global_root(root):
    try:
        return os.path.realpath(root) == os.path.realpath(global_dir())
    except OSError:
        return False


def _own_file_problem(path):
    """The file must belong to this user and not be writable by group or others (a symlink is judged by its target): it names
    the secrets a launcher passes on and the connections it opens."""
    try:
        st = os.stat(path)
    except OSError as e:
        return f"cannot read {path}: {e.strerror}"
    if st.st_uid != os.getuid() and not _published_file(path, st):
        return f"{path} is not owned by you"
    if st.st_mode & 0o022:
        return f"{path} is writable by group or others (chmod go-w)"
    return None


def _published_file(path, st):
    """A managed user's global.toml is a link into the owner's published checkout (/srv/dotfiles): the file belongs to whoever owns
    that checkout, which is also where this very script and every launcher run from, so trusting it adds nothing. Never for the
    owner's own checkout (its files are the owner's, the first rule) or for anything that resolves outside the published tree."""
    try:
        if REPO == HOME or str(REPO).startswith(str(HOME) + os.sep):
            return False
        rp, root = os.path.realpath(path), os.path.realpath(REPO)
        return rp.startswith(root + os.sep) and st.st_uid == os.stat(root).st_uid and not (os.stat(root).st_mode & 0o022)
    except OSError:
        return False


def merge_global(gtext, ltext):
    """(merged data, problems) of global.toml + global.local.toml text."""
    problems = []
    try:
        g = tomllib.loads(gtext)
    except ValueError as e:
        return {}, [f"{GLOBAL_TOML}: {e}"]
    try:
        loc = tomllib.loads(ltext) if ltext else {}
    except ValueError as e:
        return {}, [f"{GLOBAL_LOCAL}: {e}"]
    if g.get("project", "global") != "global":
        problems.append(f"{GLOBAL_TOML}: project must be \"global\"")
    for k in loc:
        if k not in ("secrets", "db"):
            problems.append(f"{GLOBAL_LOCAL}: only [secrets] and [db.NAME] are allowed here, not {k!r}")
    sec, db = dict(g.get("secrets") or {}), dict(g.get("db") or {})
    for n, d in (loc.get("secrets") or {}).items() if isinstance(loc.get("secrets"), dict) else []:
        if n in sec:
            problems.append(f"{n} is declared in {GLOBAL_TOML} and in {GLOBAL_LOCAL}")
        sec[n] = d
    for n, d in (loc.get("db") or {}).items() if isinstance(loc.get("db"), dict) else []:
        if n in db:
            problems.append(f"[db.{n}] is declared in {GLOBAL_TOML} and in {GLOBAL_LOCAL}")
        db[n] = d
    data = {"project": "global", "environments": ["default"], "default": "default", "protected": [], "secrets": sec}
    if db:
        data["db"] = db
    return data, problems + validate(data)


def load_global(strict=True):
    d = global_dir()
    gp, lp = d / GLOBAL_TOML, d / GLOBAL_LOCAL
    if not gp.is_file():
        fail(f"no {gp}: run `stow .` in ~/dotfiles (it links .config/envs/global.toml)", 1)
    for f in (gp, lp):
        if f.exists() or f.is_symlink():
            bad = _own_file_problem(f)
            if bad:
                fail(f"global scope refused: {bad}", 4)
    gtext = gp.read_text()
    ltext = lp.read_text() if lp.is_file() else ""
    data, problems = merge_global(gtext, ltext)
    if problems and strict:
        fail("global scope:\n  " + "\n  ".join(problems))
    cfg = Cfg(d, data, gtext, problems)
    cfg.is_global = True
    return cfg


def edit_global_local(cfg, fn):
    """Apply fn(TomlText) to global.local.toml (created 0600), validate the merged result, write it."""
    lp = cfg.root / GLOBAL_LOCAL
    ed = TomlText(lp.read_text() if lp.is_file() else GLOBAL_LOCAL_HEADER)
    fn(ed)
    new = ed.text()
    data, problems = merge_global(cfg.text, new)
    if problems:
        fail("the edit would make the global scope invalid:\n  " + "\n  ".join(problems))
    write_text(lp, new, 0o600)
    return load_global()


# the line editor: top-level keys and keys inside one table, comments and order kept ------------------------------------

def toml_str(s):
    out = ['"']
    for ch in s:
        o = ord(ch)
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        elif ch == "\r":
            out.append("\\r")
        elif o < 0x20 or o == 0x7F:
            out.append(f"\\u{o:04x}")
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def toml_list(items):
    return "[" + ", ".join(toml_str(i) for i in items) + "]"


KEY_LINE = re.compile(r"^(\s*)([A-Za-z0-9_-]+)(\s*=\s*)(.*)$")
QUOTED_KEY_LINE = re.compile(r"""^\s*["'][^"']*["']\s*=""")


def split_comment(value):
    """(value, comment) of the right-hand side of a key line; # inside quotes does not start a comment."""
    q = None
    i = 0
    while i < len(value):
        c = value[i]
        if q:
            if q == '"' and c == "\\":
                i += 2
                continue
            if c == q:
                q = None
        elif c in "\"'":
            q = c
        elif c == "#":
            head = value[:i].rstrip()
            return head, value[len(head):]
        i += 1
    return value.rstrip(), ""


def multiline_value(rhs):
    rhs = rhs.strip()
    if rhs.startswith(('"""', "'''")):
        return True
    return rhs.startswith("[") and rhs.count("[") != rhs.count("]")


class TomlText:
    """Edit a TOML file as lines: set/replace/remove/rename a key at top level (table=None) or inside [table]."""

    def __init__(self, text):
        self.lines = text.split("\n")

    def text(self):
        t = "\n".join(self.lines)
        return t if t.endswith("\n") else t + "\n"

    def _range(self, table):
        if table is None:
            end = next((i for i, l in enumerate(self.lines) if re.match(r"^\s*\[", l)), len(self.lines))
            return -1, end
        hdr = re.compile(r"^\s*\[\s*" + re.escape(table) + r"\s*\]\s*(#.*)?$")
        start = next((i for i, l in enumerate(self.lines) if hdr.match(l)), None)
        if start is None:
            return None
        end = next((j for j in range(start + 1, len(self.lines)) if re.match(r"^\s*\[", self.lines[j])), len(self.lines))
        return start, end

    def _find(self, table, key):
        r = self._range(table)
        if r is None:
            return None, None
        for i in range(r[0] + 1, r[1]):
            line = self.lines[i]
            if line.lstrip().startswith("#"):
                continue
            if QUOTED_KEY_LINE.match(line):
                fail(f"{TOML or 'file'}: quoted keys cannot be edited here; edit the file by hand", 1)
            m = KEY_LINE.match(line)
            if m and m.group(2) == key:
                if multiline_value(m.group(4)):
                    fail(f"the value of {key} spans several lines: edit the file by hand", 1)
                return i, m
        return r, None

    def has(self, table, key):
        i, m = self._find(table, key)
        return m is not None

    def get_line(self, table, key):
        i, m = self._find(table, key)
        return m

    def set(self, table, key, literal):
        loc, m = self._find(table, key)
        if m is not None:
            value, comment = split_comment(m.group(4))
            self.lines[loc] = f"{m.group(1)}{key}{m.group(3)}{literal}{comment}"
            return
        if loc is None:                           # table missing: append it
            while self.lines and self.lines[-1].strip() == "":
                self.lines.pop()
            if self.lines:
                self.lines.append("")
            self.lines += [f"[{table}]", f"{key} = {literal}", ""]
            return
        start, end = loc
        last = start
        for j in range(start + 1, end):
            if self.lines[j].strip() and not self.lines[j].lstrip().startswith("#") and KEY_LINE.match(self.lines[j]):
                last = j
        if table is None and last == -1:           # no top-level key yet: before the first table, after leading comments
            last = max([j for j in range(0, end) if self.lines[j].strip()] or [-1])
        self.lines.insert(last + 1, f"{key} = {literal}")

    def remove(self, table, key):
        loc, m = self._find(table, key)
        if m is None:
            return False
        del self.lines[loc]
        return True

    def rename(self, table, old, new):
        loc, m = self._find(table, old)
        if m is None:
            return False
        self.lines[loc] = f"{m.group(1)}{new}{m.group(3)}{m.group(4)}"
        return True


def write_text(path, text, new_mode=0o644):
    path = Path(path)
    mode = (path.stat().st_mode & 0o777) if path.exists() else new_mode
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def edit_cfg(cfg, fn):
    """Apply fn(TomlText) to .envs.toml, validate the result and write it (atomically). The global scope edits its
    global.local.toml (global.toml is a stowed repo file)."""
    if cfg.is_global:
        return edit_global_local(cfg, fn)
    ed = TomlText(cfg.path.read_text())
    fn(ed)
    new = ed.text()
    try:
        data = tomllib.loads(new)
    except ValueError as e:
        fail(f"the edit would break {TOML}: {e}")
    prob = validate(data, cfg.root)
    if prob:
        fail("the edit would make .envs.toml invalid:\n  " + "\n  ".join(prob))
    write_text(cfg.path, new)
    return load_cfg(cfg.root)


def edit_mise(path, fn):
    path = Path(path)
    ed = TomlText(path.read_text() if path.exists() else "")
    fn(ed)
    try:
        tomllib.loads(ed.text())
    except ValueError as e:
        fail(f"the edit would break {path.name}: {e}")
    write_text(path, ed.text())


# ───────────────────────────── rbw (read) and bw (write) ─────────────────────────────

def rbw_run(*args, timeout=15):
    try:
        return subprocess.run([tool("rbw", "RBW_BIN"), *args], capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        fail(f"rbw {args[0]} timed out", 1)
    except OSError as e:
        fail(f"rbw: {e}", 1)


def rbw_unlocked():
    return rbw_run("unlocked", timeout=10).returncode == 0


def ensure_rbw(sync=False):
    if not rbw_unlocked():
        if not tty():
            fail("vault is locked: unlock it (any vault action, e.g. SUPER+CTRL+P) and run again", 3)
        try:
            p = subprocess.run([tool("rbw", "RBW_BIN"), "unlock"], timeout=120)
        except subprocess.TimeoutExpired:
            fail("rbw unlock timed out", 3)
        if p.returncode != 0 or not rbw_unlocked():
            fail("the vault is still locked", 3)
    if sync:
        p = rbw_run("sync", timeout=60)
        if p.returncode != 0:
            warn("rbw sync failed: using the local copy")


def rbw_list():
    p = rbw_run("list", "--raw", timeout=15)
    if p.returncode != 0:
        fail("rbw list failed: " + (p.stderr.strip().splitlines() or ["no details"])[0][:200])
    try:
        return json.loads(p.stdout)
    except ValueError:
        fail("rbw list --raw did not return JSON")


def rbw_env_items(items, project, env):
    return [i for i in items if i.get("folder") == f"Env/{project}" and i.get("name") == env
            and str(i.get("type", "")).lower() in ("securenote", "secure note", "note", "2")]


def rbw_fields(item_id):
    """{field name: value} of one item (rbw get --raw); duplicate names are an error."""
    p = rbw_run("get", "--raw", item_id, timeout=15)
    if p.returncode != 0:
        fail("rbw get failed: " + (p.stderr.strip().splitlines() or ["no details"])[0][:200])
    try:
        doc = json.loads(p.stdout)
    except ValueError:
        fail("rbw get --raw did not return JSON")
    out = {}
    for f in doc.get("fields") or []:
        n = f.get("name")
        if n in out:
            fail(f"two fields called {n} in one item: fix it in the vault browser (SUPER+CTRL+SHIFT+P)")
        out[n] = f.get("value") or ""
    return out


def env_fields(project, env, items=None):
    """None when the env has no item, else {name: value}. Two items = error."""
    items = items if items is not None else rbw_list()
    m = rbw_env_items(items, project, env)
    if len(m) > 1:
        fail(f"{len(m)} items called {env} in Env/{project}: fix it in the vault browser (SUPER+CTRL+SHIFT+P)")
    if not m:
        return None
    return rbw_fields(m[0]["id"])


_vbw = None


def vbw():
    """vault-bw.py as a library, made safe for a CLI: no notifications, no 'press Enter', errors raise Fail."""
    global _vbw
    if _vbw is None:
        import importlib.util
        spec = importlib.util.spec_from_file_location("vault_bw", VAULT_BW)
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        m.notify = lambda *a, **k: None
        m.interactive = lambda: False

        def die(msg, code=1):
            raise Fail(msg, code)
        m.die = die
        m.BW = tool("bw", "BW_BIN", required=False) or m.BW
        m.RBW = tool("rbw", "RBW_BIN", required=False) or m.RBW
        m.WL_COPY = tool("wl-copy", required=False) or m.WL_COPY      # the secret goes to its stdin: no PATH lookup
        orig_pinentry = m.pinentry_bin

        def pinentry_bin():                                           # the master password goes to its stdin
            v = os.environ.get("PINENTRY_BIN")
            if v and not (TEST_DIRS and os.path.isabs(v) and any(_under(v, d) for d in TEST_DIRS)):
                os.environ.pop("PINENTRY_BIN", None)
            return orig_pinentry()
        m.pinentry_bin = pinentry_bin
        if not os.environ.get("WAYLAND_DISPLAY"):
            m.TERMINAL_UNLOCK = True
        elif not os.access(Path(os.environ.get("XDG_RUNTIME_DIR", "/x")) / os.environ["WAYLAND_DISPLAY"], os.W_OK):
            m.TERMINAL_UNLOCK = True
        _vbw = m
    return _vbw


def bw_open():
    """vault-bw.py with an unlocked bw session (pinentry once per login); bw not set up = a clear message."""
    m = vbw()
    st = m.state()
    if st == "missing":
        fail("bw is not installed (sudo ~/dotfiles/apply-system.sh --only install)")
    if st == "unconfigured":
        fail("bw is not logged in: run bw-setup in a terminal first")
    if st != "unlocked":
        try:
            m.ensure()
        except SystemExit:
            fail("cancelled", 130)
    return m


def new_item(folder_id, env, project):
    return {"type": 2, "name": env, "folderId": folder_id, "favorite": False, "reprompt": 0,
            "notes": f"envs: project {project}, environment {env}. Values are the hidden custom fields; names are declared "
                     "in .envs.toml.",
            "secureNote": {"type": 0}, "login": None, "card": None, "identity": None, "fields": []}


def bw_env_item(m, project, env, create=False):
    """The (full, current) bw item of an environment: None when missing and not created."""
    fid = m.folder_id(f"Env/{project}", create=False)
    items = m.bw_json("list", "items", "--folderid", fid) if fid else []
    hits = [i for i in items if i.get("name") == env and i.get("type") == 2]
    if len(hits) > 1:
        fail(f"{len(hits)} items called {env} in Env/{project}: fix it in the vault browser (SUPER+CTRL+SHIFT+P)")
    if hits:
        return m.bw_json("get", "item", hits[0]["id"])
    if not create:
        return None
    m.folder_id("Env", create=True)
    fid = m.folder_id(f"Env/{project}", create=True)
    return m.bw_json("create", "item", stdin=m.b64(new_item(fid, env, project)))


def item_field_names(item):
    names = [f.get("name") for f in item.get("fields") or []]
    for n in names:
        if names.count(n) > 1:
            fail(f"two fields called {n} in the item {item.get('name')}: fix it in the vault browser")
    return names


def item_set_field(item, name, value):
    item_field_names(item)
    fields = item.setdefault("fields", [])
    for f in fields:
        if f.get("name") == name:
            f["value"], f["type"] = value, 1
            return
    fields.append({"name": name, "value": value, "type": 1, "linkedId": None})


def item_drop_field(item, name):
    before = len(item.get("fields") or [])
    item["fields"] = [f for f in item.get("fields") or [] if f.get("name") != name]
    return len(item["fields"]) != before


def bw_save(m, item):
    m.bw_json("edit", "item", item["id"], stdin=m.b64(item))


# ───────────────────────────── prompts ─────────────────────────────

def confirm(question, default=False, timeout=60):
    """[y/N] on the terminal; no terminal = False. ENVS_TEST_YES only in test mode (no terminal there)."""
    if test_mode() and os.environ.get("ENVS_TEST_YES") == "1":
        return True
    if not tty():
        return False
    sys.stderr.write(f"{question} [{'Y/n' if default else 'y/N'}] ")
    sys.stderr.flush()
    r, _, _ = select.select([sys.stdin], [], [], timeout)
    if not r:
        sys.stderr.write("\n")
        return False
    ans = sys.stdin.readline().strip().lower()
    return default if not ans else ans.startswith("y")


def typed_confirm(word, what):
    if not tty():
        return False
    sys.stderr.write(f"{what}\nType {word} to confirm: ")
    sys.stderr.flush()
    return sys.stdin.readline().strip() == word


def pick(rows, prompt, header=""):
    """One of ROWS (strings) through the modal fzf menu, else a numbered prompt; None = cancelled."""
    fm = tool("fzf-menu", required=False)
    if fm and (tty() or os.environ.get("WAYLAND_DISPLAY")):
        cmd = [fm, "--here", "-p", prompt] + (["--header", header] if header else [])
        p = subprocess.run(cmd, input="\n".join(rows) + "\n", capture_output=True, text=True)
        return p.stdout.strip("\n") if p.returncode == 0 and p.stdout.strip() else None
    if not tty():
        return None
    for n, r in enumerate(rows, 1):
        sys.stderr.write(f"  {n}) {r}\n")
    sys.stderr.write(f"{prompt}: ")
    sys.stderr.flush()
    ans = sys.stdin.readline().strip()
    if ans.isdigit() and 1 <= int(ans) <= len(rows):
        return rows[int(ans) - 1]
    return ans if ans in rows else None


def read_value(name, stdin_flag):
    if stdin_flag:
        data = sys.stdin.read()
        if data.endswith("\n"):
            data = data[:-1]
        if not data:
            fail("empty value on stdin", 2)
        return data
    if not tty():
        fail("no terminal for the hidden prompt: pipe the value with --stdin", 2)
    import getpass
    a = getpass.getpass(f"Value of {name} (hidden): ")
    b = getpass.getpass("Again: ")
    if a != b:
        fail("the two entries differ", 1)
    if not a:
        fail("empty value", 1)
    return a


# ───────────────────────────── bind, guards, environment choice ─────────────────────────────

def trust_files(root):
    """The mise config files `mise trust` would accept for this root (what can run commands)."""
    out = [rel for rel in MISE_BASE + [".mise/config.toml"] if (root / rel).is_file()]
    out += [p.name for p, env in mise_files(root) if env and p.name not in out]
    return out


def mise_trust(root, ask=True):
    """`mise trust` for ROOT after its OWN question: a mise config can run commands (templates, hooks, `_.source`), with the
    secrets of the environment present, and trust is path-based (a later `git pull` that edits the file is trusted too).
    Never implied by bind or init, never repeated silently."""
    mise = tool("mise", required=False)
    files = trust_files(root)
    if not mise or not files:
        return False
    if ask and not confirm(f"Trust the mise config of this project ({', '.join(files)})? mise can run commands from it, with "
                           "this environment's secrets, and trusts later edits of the files too."):
        warn("mise config not trusted (`envs trust` asks again); `mise exec` refuses an untrusted config")
        return False
    subprocess.run([mise, "trust"], cwd=str(root), stdin=subprocess.DEVNULL, capture_output=True)
    return True


def root_label(o):
    return short_path(o) + ("" if os.path.exists(o) else " (gone)")


def other_binding_note(cfg):
    """A line that names where Env/<project> is already bound, '' when nowhere else."""
    others = bound_elsewhere(cfg.root, cfg.project)
    if not others:
        return ""
    shown = ", ".join(root_label(o) for o in others[:3]) + (f" (+{len(others) - 3})" if len(others) > 3 else "")
    return (f"{cfg.folder} is already bound to {shown}. If this is not a clone of that repository, binding gives it that "
            "project's secrets.")


def require_bound(cfg):
    st, key, old = binding_state(cfg.root, cfg.project)
    if st == "bound":
        upgrade_identity(cfg.root, cfg.project)
        return
    if st == "changed":
        fail(f"project name changed: this checkout was bound to Env/{old}, .envs.toml now says Env/{cfg.project}; "
             "run `envs bind` to confirm the change (a cloned repo must not pull another project's secrets)", 4)
    if st == "moved":
        fail(f"this path is bound to {cfg.folder}, but the repository here is not the one that was bound (its root commit "
             "differs: replaced or re-cloned); run `envs bind` to confirm it", 4)
    if other_binding_note(cfg):                  # never offered inline: the typed confirmation lives in `envs bind`
        fail(f"{cfg.root} is not bound, and {other_binding_note(cfg)} Run `envs bind` in a terminal.", 4)
    if not tty() and not (test_mode() and os.environ.get("ENVS_TEST_YES") == "1"):
        fail(f"{cfg.root} is not bound to Bitwarden folder {cfg.folder}: run `envs bind` in a terminal", 4)
    if not confirm(f"Bind {cfg.root} to Bitwarden folder {cfg.folder}?"):
        fail("not bound", 4)
    bind_write(cfg.root, cfg.project)


def choose_env(cfg, explicit=None):
    if explicit:
        if explicit not in cfg.envs:
            fail(f"unknown environment {explicit!r} (have: {', '.join(cfg.envs)})", 2)
        return explicit
    a = active_get(cfg.root)
    if a and a[0] in cfg.envs:
        return a[0]
    return cfg.default


def guard_protected(cfg, env, prod_flag, verb="run"):
    """Gate for a protected env: --prod or a [y/N] on the terminal (a terminal prompt: see "what the fence is" in CLAUDE.md).
    Every pass is logged (no values), so reading prod is never silent."""
    if not cfg.is_protected(env):
        return
    if not prod_flag and not (tty() and confirm(f"{env} is a protected environment. {verb.capitalize()} in {env}?")):
        fail(f"{env} is protected: pass --prod to {verb} in it", 4)
    journal(f"{verb} project={cfg.project} env={env} (protected)")


def parse_duration(s):
    m = re.fullmatch(r"(\d+)([mh])", s or "")
    if not m:
        fail("--for takes a duration like 30m or 2h", 2)
    secs = int(m.group(1)) * (60 if m.group(2) == "m" else 3600)
    if secs <= 0 or secs > 8 * 3600:
        fail("--for must be between 1m and 8h", 2)
    return secs


def journal(msg):
    if test_mode() and os.environ.get("ENVS_NO_JOURNAL"):
        return
    lg = tool("logger", required=False)
    if lg:
        subprocess.run([lg, "-t", "envs", "--", msg], stdin=subprocess.DEVNULL, capture_output=True)


# ───────────────────────────── commands ─────────────────────────────

def slug(name):
    s = re.sub(r"[^a-z0-9._-]+", "-", name.lower()).strip("-._")
    return s[:63] or "project"


def cmd_init(a):
    refuse_agent("init")
    top = None
    git = tool("git", required=False)
    if git:
        p = subprocess.run([git, "rev-parse", "--show-toplevel"], capture_output=True, text=True, stdin=subprocess.DEVNULL,
                       env=git_env())
        if p.returncode == 0:
            top = Path(p.stdout.strip())
    root = top or Path.cwd()
    path = root / TOML
    if path.exists():
        fail(f"{path} exists already")
    project = a.project or slug(root.name)
    envs = [e.strip() for e in a.envs.split(",") if e.strip()]
    default = a.default or envs[0]
    prot = [e for e in envs if e in ALWAYS_PROTECTED]
    data = {"project": project, "environments": envs, "default": default, "protected": prot}
    prob = validate(data)
    if prob:
        fail("\n".join(prob), 2)
    text = (f"# Project environments for `envs` (~/dotfiles/CLAUDE.md \"Dev environments\"). Names only: the values live in "
            f"Bitwarden, folder\n# \"Env/<project>\", one Secure Note per environment, one hidden custom field per secret. "
            f"Non-secret variables go to .mise.toml\n# [env] (every environment) or .mise.<env>.toml [env] (one environment).\n"
            f"project = {toml_str(project)}\nenvironments = {toml_list(envs)}\ndefault = {toml_str(default)}\n"
            f"protected = {toml_list(prot)}\n\n[secrets]\n")
    write_text(path, text)
    say(f"wrote {path}")
    gi = root / ".gitignore"
    want = [".env", ".env.*", "!.env.example"]
    have = gi.read_text().splitlines() if gi.exists() else []
    missing = [w for w in want if w not in have]
    if missing and (not tty() or confirm(f"Add {', '.join(missing)} to .gitignore?", default=True)):
        body = gi.read_text() if gi.exists() else ""
        if body and not body.endswith("\n"):
            body += "\n"
        write_text(gi, body + "\n".join(missing) + "\n")
        say(f"added {', '.join(missing)} to .gitignore")
    elsewhere = bound_elsewhere(root, project)
    if elsewhere:
        warn(f"Env/{project} is already bound to {', '.join(root_label(o) for o in elsewhere[:3])}: not binding this one "
             "(a clone that names an existing project would get its secrets); run `envs bind` in a terminal to confirm")
    else:
        bind_write(root, project)
        say(f"bound {root} to Bitwarden folder Env/{project}")
    if not elsewhere and trust_files(root) and tool("mise", required=False):
        if tty():
            if mise_trust(root):
                say("mise trust: done")
        else:
            say("mise config present and not trusted: run `envs trust` in a terminal")


def cmd_bind(a):
    refuse_agent("bind")
    if a.yes and test_mode():
        os.environ["ENVS_TEST_YES"] = "1"
    cfg = load_cfg()
    st, key, old = binding_state(cfg.root, cfg.project)
    if st == "bound":
        say(f"already bound: {cfg.root} -> {cfg.folder}")
        return
    note = f" (was Env/{old})" if st == "changed" else (" (the repository here is not the one bound before)" if st == "moved" else "")
    elsewhere = other_binding_note(cfg) if st != "changed" else ""
    if elsewhere or st == "moved":
        # a clone of something that names a project you already have, or a replaced repository: the secrets of that project
        # go to this code, so `y` is not enough: the project name is typed (same rule as `project delete`)
        if elsewhere:
            warn(elsewhere)
        if not typed_confirm(cfg.project, f"Bind {cfg.root} to {cfg.folder}{note}?"):
            fail("not bound" + ("" if tty() else ": a terminal is needed to confirm"), 4)
    elif not confirm(f"Bind {cfg.root} to Bitwarden folder {cfg.folder}{note}?"):
        fail("not bound" + ("" if tty() else ": a terminal is needed to confirm"), 4)
    bind_write(cfg.root, cfg.project)
    say(f"bound {cfg.root} -> {cfg.folder}")
    if trust_files(cfg.root) and tool("mise", required=False):
        mise_trust(cfg.root)                    # its own question: binding is not trust


def cmd_trust(a):
    refuse_agent("trust")
    cfg = load_cfg()
    if binding_state(cfg.root, cfg.project)[0] != "bound":
        fail("this checkout is not bound: run `envs bind` first", 4)
    if not trust_files(cfg.root):
        fail("no mise config file here", 1)
    if not tool("mise", required=False):
        fail("mise is not installed", 1)
    if not tty() and not test_mode():
        fail("a terminal is needed to confirm", 4)
    if not mise_trust(cfg.root):
        fail("not trusted", 4)
    say(f"mise config of {cfg.root.name} trusted")


def vault_matrix(cfg):
    """{env: (fields dict or None)} when rbw is unlocked, else None. Values stay in memory."""
    try:
        if not rbw_unlocked():
            return None
        items = rbw_list()
    except Fail:
        return None
    out = {}
    for e in cfg.envs:
        try:
            out[e] = env_fields(cfg.project, e, items)
        except Fail as ex:
            out[e] = ex
    return out


def classify(cfg, fields):
    """(set, missing, extra) name lists of one env item."""
    if not isinstance(fields, dict):
        return [], list(cfg.secrets), []
    return ([n for n in cfg.secrets if n in fields and fields[n] != ""], [n for n in cfg.secrets if n not in fields or fields[n] == ""],
            [n for n in fields if n not in cfg.secrets])


def cmd_status(a):
    cfg = cfg_for(a, strict=False)
    st, key, old = binding_state(cfg.root, cfg.project)
    act = active_get(cfg.root)
    env = choose_env(cfg) if not cfg.problems else None
    left = max(0, int((act[1] - time.time()) / 60)) if act and act[1] else None
    matrix = vault_matrix(cfg) if not cfg.problems else None
    doc = {"project": cfg.project, "root": str(cfg.root), "binding": st, "environments": cfg.envs, "default": cfg.default,
           "protected": sorted(cfg.protected & set(cfg.envs)), "active": env, "active_minutes_left": left,
           "names": list(cfg.secrets), "vault": "unlocked" if matrix is not None else "locked", "problems": cfg.problems, "env": {}}
    if matrix is not None:
        for e, f in matrix.items():
            if isinstance(f, Fail):
                doc["env"][e] = {"error": f.msg}
            elif f is None:
                doc["env"][e] = {"item": False, "set": [], "missing": list(cfg.secrets), "extra": []}
            else:
                s, m, x = classify(cfg, f)
                doc["env"][e] = {"item": True, "set": s, "missing": m, "extra": x}
    if a.json:
        say(json.dumps(doc, indent=1))
        return
    say(f"project  {cfg.project}")
    say(f"root     {cfg.root}")
    say(f"binding  {st}" + (f" (was Env/{old})" if st == "changed" else (" (another repository than the bound one)" if st == "moved" else "")))
    if env:
        extra = f" (active selection, {left} min left)" if act and left is not None and act[1] else \
            (" (active selection)" if act else " (default)")
        say(f"env      {env}{extra}" + ("  [protected]" if cfg.is_protected(env) else ""))
    say(f"names    {', '.join(cfg.secrets) or '-'}")
    for p in cfg.problems:
        say(f"problem  {p}")
    say(f"vault    {doc['vault']}")
    for e, d in doc["env"].items():
        if "error" in d:
            say(f"  {e}: error: {d['error']}")
        elif not d["item"]:
            say(f"  {e}: no item")
        else:
            say(f"  {e}: {len(d['set'])} set, missing: {', '.join(d['missing']) or '-'}, extra: {', '.join(d['extra']) or '-'}")


def cmd_use(a):
    refuse_agent("use")
    cfg = load_cfg()
    env = a.env
    if not env:
        rows = [f"{e}{'  [protected]' if cfg.is_protected(e) else ''}" for e in cfg.envs]
        got = pick(rows, "environment")
        if not got:
            fail("no environment chosen", 2 if not tty() else 130)
        env = got.split()[0]
    if env not in cfg.envs:
        fail(f"unknown environment {env!r} (have: {', '.join(cfg.envs)})", 2)
    with write_lock():
        if env == cfg.default:
            active_set(cfg.root, None)
            say(f"{cfg.root.name}: back to the default environment ({env})")
            return
        prot = cfg.is_protected(env)
        if prot and not a.prod:
            if not typed_confirm(env, f"{env} is a protected environment: commands will run against it for the next hour."):
                fail(f"{env} is protected: pass --prod to use it", 4)
        secs = parse_duration(a.for_) if a.for_ else (3600 if prot else 0)
        until = time.time() + secs if secs else 0
        active_set(cfg.root, env, until, "p" if prot else "-")
    say(f"{cfg.root.name}: using {env}" + (f" for {secs // 60} min" if secs else ""))


MISE_LOG_ENV = ("MISE_LOG_FILE", "MISE_LOG_FILE_LEVEL", "MISE_DEBUG", "MISE_TRACE", "MISE_VERBOSE")


def mise_cmd(cfg, cmd, env):
    mise = tool("mise", required=False)
    if mise and has_mise_config(cfg.root):
        return [mise, "exec", "--", *cmd], True
    return list(cmd), False


def cfg_for(a, strict=True):
    """The project of the cwd, or the global scope with -g."""
    if getattr(a, "global_", False):
        return load_global(strict)
    return load_cfg(strict=strict)


def cmd_run(a, cmd):
    refuse_agent("run")
    cfg = cfg_for(a)
    require_bound(cfg)
    env = choose_env(cfg, a.env)
    guard_protected(cfg, env, a.prod)
    only = a.only.split(",") if isinstance(a.only, str) else (a.only or [])
    if [n for n in only if n not in cfg.secrets]:
        fail(f"--only names {', '.join(n for n in only if n not in cfg.secrets)}, which {'is' if len([n for n in only if n not in cfg.secrets]) == 1 else 'are'} not declared in [secrets]", 2)
    values = {}
    if cfg.secrets:
        ensure_rbw(a.sync)
        fields = env_fields(cfg.project, env)
        fields = fields or {}
        wanted = [n for n in cfg.secrets if not only or n in only]
        missing = [n for n in wanted if fields.get(n, "") == ""]
        if missing and not a.allow_missing:
            fail(f"{env}: missing {', '.join(missing)}: set them with `envs set NAME {'-g' if cfg.is_global else '-e ' + env}` "
                 "(or run with --allow-missing)", 1)
        values = {n: fields[n] for n in wanted if fields.get(n, "") != ""}
        fields = None
    use_mise = not a.no_mise and not cfg.is_global
    argv, mised = mise_cmd(cfg, cmd, env) if use_mise else (list(cmd), False)
    child = command_env(os.environ)
    child.update(values)
    child["ENVS_PROJECT"], child["ENVS_ENV"] = cfg.project, env
    child["ENVS_SECRETS"] = " ".join(values)       # the names that were injected (names only): a launcher knows what is secret
    if mised:
        child["MISE_ENV"] = env
        # a legacy file (.tool-versions, .nvmrc ...) needs no `mise trust`, so mise would install what it names (npm:/cargo:/
        # pipx: lifecycle and build scripts) with the secrets already in this environment: a missing tool stops the command
        for k in ("MISE_AUTO_INSTALL", "MISE_NOT_FOUND_AUTO_INSTALL", "MISE_EXEC_AUTO_INSTALL", "MISE_TASK_RUN_AUTO_INSTALL"):
            child[k] = "0"             # newer mise has separate switches for `exec` and `run`: ert runs `mise run` in here
        for k in MISE_LOG_ENV:                    # mise may print or write its environment at debug/trace level
            child.pop(k, None)
        child["MISE_LOG_LEVEL"] = "warn"
        for n, f in parent_mise_overrides(cfg):
            warn(f"{n} is also set by mise [env] in {f}: that value overrides the secret")
    if cfg.is_protected(env):
        journal(f"run project={cfg.project} env={env} cmd={os.path.basename(cmd[0])} vars={len(values)}")
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execvpe(argv[0], argv, child)
    except OSError as e:
        fail(f"cannot run {argv[0]}: {e.strerror}", 127)


def targets(cfg, a):
    if getattr(a, "all", False):
        return list(cfg.envs)
    return [choose_env(cfg, a.env)]


def cmd_set(a):
    refuse_agent("set")
    cfg = cfg_for(a)
    if "=" in a.name or a.extra:
        fail("values never go on the command line: history and ps would see them. Use the hidden prompt or --stdin. "
             "If you just typed a real value: rotate it and delete the line from the shell history (atuin: `atuin history "
             "prune`, zsh: `fc -W` and edit ~/.zsh_history)", 2)
    why = bad_var_name(a.name)
    if why:
        fail(f"{a.name} {why}", 2)
    if a.plain:
        if cfg.is_global:
            fail("--plain does not exist for the global scope (no mise file)", 2)
        return set_plain(cfg, a)
    require_bound(cfg)
    envs = targets(cfg, a)
    if a.name in mise_env_keys(cfg.root):
        fail(f"{a.name} is a plain variable in mise [env]: `envs set --plain` or remove it there first", 1)
    value = read_value(a.name, a.stdin)
    if len(value) > FIELD_LIMIT:
        warn(f"the value is {len(value)} characters; Bitwarden fields stop working at about 5000 (use an attachment)")
    with write_lock():
        m = bw_open()
        for e in envs:
            item = bw_env_item(m, cfg.project, e, create=True)
            item_set_field(item, a.name, value)
            bw_save(m, item)
        value = None
        if a.name not in cfg.secrets or a.description is not None:
            def decl(ed):
                ed.set("secrets", a.name, toml_str(a.description if a.description is not None
                                                   else cfg.secrets.get(a.name, "")))
            cfg = edit_cfg(cfg, decl)
        m.refresh_rbw()
    say(f"{a.name}: set in {', '.join(envs)}")


def set_plain(cfg, a):
    if a.name in cfg.secrets:
        fail(f"{a.name} is declared as a secret: `envs unset {a.name} --all --undeclare` first", 1)
    env = None if a.all else (a.env or None)
    if env and env not in cfg.envs:
        fail(f"unknown environment {env!r}", 2)
    if a.stdin:
        value = read_value(a.name, True)
    elif tty():
        value = input(f"Value of {a.name}: ")
    else:
        fail("no terminal: pipe the value with --stdin", 2)
    path = mise_target(cfg.root, env, cfg.default)
    edit_mise(path, lambda ed: ed.set("env", a.name, toml_str(value)))
    say(f"{a.name}: set in {path.name} [env] (plain, committed)")


def cmd_unset(a):
    refuse_agent("unset")
    cfg = cfg_for(a)
    require_bound(cfg)
    removed = []
    if a.name in cfg.secrets:
        with write_lock():
            m = bw_open()
            for e in targets(cfg, a):
                item = bw_env_item(m, cfg.project, e)
                if item is not None and item_drop_field(item, a.name):
                    bw_save(m, item)
                    removed.append(e)
            m.refresh_rbw()
        if a.undeclare:
            edit_cfg(cfg, lambda ed: ed.remove("secrets", a.name))
            say(f"{a.name}: no longer declared")
    else:                                         # a plain variable: the mise file(s) of the chosen scope
        want = None if a.all else mise_target(cfg.root, a.env, cfg.default)
        for p, _env in mise_files(cfg.root):
            if want is not None and p != want:
                continue
            try:
                has = a.name in (tomllib.loads(p.read_text()).get("env") or {})
            except (OSError, ValueError):
                has = False
            if has:
                edit_mise(p, lambda ed: ed.remove("env", a.name))
                removed.append(p.name)
    say(f"{a.name}: removed from {', '.join(removed) or 'nothing (it was not set)'}")


def cmd_rename(a):
    refuse_agent("rename")
    cfg = load_cfg()
    require_bound(cfg)
    for n in (a.old, a.new):
        why = bad_var_name(n)
        if why:
            fail(f"{n} {why}", 2)
    if a.new in cfg.secrets or a.new in mise_env_keys(cfg.root):
        fail(f"{a.new} exists already", 1)
    done = []
    if a.old in cfg.secrets:
        with write_lock():
            m = bw_open()
            for e in cfg.envs:
                item = bw_env_item(m, cfg.project, e)
                if item is None:
                    continue
                names = item_field_names(item)
                if a.old in names:
                    if a.new in names:
                        fail(f"{e}: the item has a field {a.new} already", 1)
                    for f in item["fields"]:
                        if f.get("name") == a.old:
                            f["name"] = a.new
                    bw_save(m, item)
                    done.append(e)
            m.refresh_rbw()
        edit_cfg(cfg, lambda ed: ed.rename("secrets", a.old, a.new))
    for p, _env in mise_files(cfg.root):
        try:
            if a.old in (tomllib.loads(p.read_text()).get("env") or {}):
                edit_mise(p, lambda ed: ed.rename("env", a.old, a.new))
                done.append(p.name)
        except (OSError, ValueError):
            pass
    if not done and a.old not in cfg.secrets:
        fail(f"{a.old} is neither a declared secret nor a mise [env] variable", 1)
    say(f"{a.old} -> {a.new}: {', '.join(done) or 'declaration only'}")


# copy, diff ---------------------------------------------------------------------------------------------------------

def need_env(cfg, name):
    if name not in cfg.envs:
        fail(f"unknown environment {name!r} (have: {', '.join(cfg.envs)})", 2)
    return name


def cmd_copy(a):
    refuse_agent("copy")
    cfg = load_cfg()
    require_bound(cfg)
    src, dst = need_env(cfg, a.src), need_env(cfg, a.dst)
    if src == dst:
        fail("source and destination are the same environment", 2)
    guard_protected(cfg, dst, a.prod, "copy into")
    guard_protected(cfg, src, a.prod, "copy from")      # reading prod is a read of prod, whoever the destination is
    ensure_rbw()
    sfields = env_fields(cfg.project, src)
    if sfields is None:
        fail(f"{src} has no item in {cfg.folder}", 1)
    names = [n for n in cfg.secrets if sfields.get(n, "") != ""]
    copied, kept = [], []
    with write_lock():
        m = bw_open()
        item = bw_env_item(m, cfg.project, dst, create=True)
        have = set(item_field_names(item))
        for n in names:
            if n in have and not a.overwrite:
                kept.append(n)
                continue
            item_set_field(item, n, sfields[n])
            copied.append(n)
        if copied:
            bw_save(m, item)
            m.refresh_rbw()
    sfields = None
    say(f"{src} -> {dst}: copied {', '.join(copied) or 'nothing'}" + (f"; kept (already set, use --overwrite): {', '.join(kept)}" if kept else ""))


def cmd_diff(a):
    cfg = load_cfg()
    if bool(a.a) != bool(a.b):
        fail("diff takes two environments or none", 2)
    matrix = vault_matrix(cfg)
    if matrix is None:
        fail("vault is locked: unlock it (any vault action, e.g. SUPER+CTRL+P) and run again", 3)
    for e, f in matrix.items():
        if isinstance(f, Fail):
            fail(f"{e}: {f.msg}")
    pairs = [(need_env(cfg, a.a), need_env(cfg, a.b))] if a.a else \
        [(x, y) for i, x in enumerate(cfg.envs) for y in cfg.envs[i + 1:]]
    for x, y in pairs:
        fx, fy = matrix[x] or {}, matrix[y] or {}
        say(f"{x} vs {y}")
        for n in cfg.secrets:
            vx, vy = fx.get(n, ""), fy.get(n, "")
            if vx and vy:
                verdict = "same" if vx == vy else "differs"
            elif vx:
                verdict = f"only in {x}"
            elif vy:
                verdict = f"only in {y}"
            else:
                verdict = "missing in both"
            say(f"  {n:<28} {verdict}")


# environments and projects -------------------------------------------------------------------------------------------

def cfg_set_envs(cfg, envs, default=None, protected=None):
    def fn(ed):
        ed.set(None, "environments", toml_list(envs))
        if default is not None:
            ed.set(None, "default", toml_str(default))
        if protected is not None:
            ed.set(None, "protected", toml_list(protected))
    return edit_cfg(cfg, fn)


def declared_protected(cfg):
    return [e for e in cfg.data.get("protected", [])]


def cmd_env(a):
    refuse_agent("env")
    cfg = load_cfg()
    require_bound(cfg)
    if a.action == "new":
        n = a.names[0]
        if not ENV_RE.match(n) or n in cfg.envs:
            fail(f"{n!r} is not a valid new environment name", 2)
        with write_lock():
            m = bw_open()
            bw_env_item(m, cfg.project, n, create=True)
            cfg = cfg_set_envs(cfg, cfg.envs + [n])
            m.refresh_rbw()
        say(f"environment {n} created (an empty item in {cfg.folder}); fill it with `envs copy` or `envs set -e {n}`")
    elif a.action == "rename":
        if len(a.names) != 2:
            fail("env rename OLD NEW", 2)
        old, new = need_env(cfg, a.names[0]), a.names[1]
        if not ENV_RE.match(new) or new in cfg.envs:
            fail(f"{new!r} is not a valid new environment name", 2)
        with write_lock():
            m = bw_open()
            item = bw_env_item(m, cfg.project, old)
            if item is not None:
                item["name"] = new
                item["notes"] = (item.get("notes") or "").replace(f"environment {old}", f"environment {new}")
                bw_save(m, item)
            envs = [new if e == old else e for e in cfg.envs]
            prot = [new if e == old else e for e in declared_protected(cfg)]
            if cfg.is_protected(old) and new not in prot:      # a protected environment stays protected under any name
                prot.append(new)
            cfg = cfg_set_envs(cfg, envs, new if cfg.default == old else None, prot)
            m.refresh_rbw()
        for p, env in mise_files(cfg.root):
            if env == old:
                p.rename(p.with_name(p.name.replace(f".{old}.", f".{new}.")))
        with write_lock():
            act = active_get(cfg.root)
            if act and act[0] == old:
                active_set(cfg.root, new, act[1], act[2])
        say(f"environment {old} -> {new}")
    elif a.action == "delete":
        n = need_env(cfg, a.names[0])
        if n == cfg.default or len(cfg.envs) == 1:
            fail("the default environment cannot be deleted: change `default` first", 1)
        if not typed_confirm(n, f"Delete environment {n}: its Bitwarden item goes to the trash and it leaves .envs.toml."):
            fail("not confirmed" + ("" if tty() else ": a terminal is needed"), 4 if not tty() else 130)
        with write_lock():
            m = bw_open()
            item = bw_env_item(m, cfg.project, n)
            if item is not None:
                p = m.bw("delete", "item", item["id"])
                if p.returncode != 0:
                    fail("bw delete failed: " + m.first_line(p.stderr or p.stdout))
            cfg = cfg_set_envs(cfg, [e for e in cfg.envs if e != n], None, [e for e in declared_protected(cfg) if e != n])
            if (active_get(cfg.root) or ("",))[0] == n:
                active_set(cfg.root, None)
            m.refresh_rbw()
        say(f"environment {n} deleted (the item is in the Bitwarden trash)")


def cmd_project(a):
    refuse_agent("project")
    cfg = load_cfg()
    require_bound(cfg)
    if a.action == "rename":
        new = a.new
        if not new or not PROJECT_RE.match(new):
            fail("project rename NEW: the name must match ^[a-z0-9][a-z0-9._-]{0,62}$", 2)
        with write_lock():
            m = bw_open()
            fid = m.folder_id(cfg.folder, create=False)
            if m.folder_id(f"Env/{new}", create=False):
                fail(f"the folder Env/{new} exists already")
            if fid:
                p = m.bw("edit", "folder", fid, stdin=m.b64({"name": f"Env/{new}"}))
                if p.returncode != 0:
                    fail("bw edit folder failed: " + m.first_line(p.stderr or p.stdout))
            edit_cfg(cfg, lambda ed: ed.set(None, "project", toml_str(new)))
            bind_write(cfg.root, new, locked=True)
            m.refresh_rbw()
        say(f"project {cfg.project} -> {new}; other checkouts of it need `envs bind` once")
    elif a.action == "delete":
        if not typed_confirm(cfg.project, f"Delete project {cfg.project}: every item of {cfg.folder} goes to the Bitwarden "
                                          "trash and the folder is removed (.envs.toml stays)."):
            fail("not confirmed" + ("" if tty() else ": a terminal is needed"), 4 if not tty() else 130)
        with write_lock():
            m = bw_open()
            fid = m.folder_id(cfg.folder, create=False)
            if fid:
                for it in m.bw_json("list", "items", "--folderid", fid):
                    r = m.bw("delete", "item", it["id"])
                    if r.returncode != 0:                      # a failed delete would leave the item outside Env/ with its secrets
                        fail(f"bw delete item failed ({m.first_line(r.stderr or r.stdout)}): stopped before the folder; "
                             "nothing else was removed, run it again", 1)
                p = m.bw("delete", "folder", fid)
                if p.returncode != 0:
                    fail("bw delete folder failed: " + m.first_line(p.stderr or p.stdout))
            key = binding_key(cfg.root)
            write_tsv(state_dir() / "bindings.tsv", [r for r in bindings().values() if r[0] != key])
            m.refresh_rbw()
        say(f"project {cfg.project} deleted from Bitwarden (items are in the trash); {TOML} is still in the repository")


# import, export-example, copy-value ------------------------------------------------------------------------------------

DOTENV_KEY = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")


def parse_dotenv(text):
    """(values dict in file order, warnings, errors); messages carry line numbers and names, never values."""
    lines = text.split("\n")
    vals, warns, errs = {}, [], []
    i = 0
    while i < len(lines):
        raw, no = lines[i], i + 1
        i += 1
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = DOTENV_KEY.match(line)
        if not m:
            errs.append(f"line {no}: not KEY=value")
            continue
        key, rest = m.group(1), m.group(2).lstrip()
        if rest[:1] in ('"', "'"):
            q = rest[0]
            body, tail, buf = [], None, rest[1:]
            start = no
            while True:
                j, esc = 0, False
                out = []
                while j < len(buf):
                    c = buf[j]
                    if q == '"' and esc:
                        out.append({"n": "\n", "t": "\t", '"': '"', "\\": "\\"}.get(c, "\\" + c))
                        esc = False
                    elif q == '"' and c == "\\":
                        esc = True
                    elif c == q:
                        tail = buf[j + 1:]
                        break
                    else:
                        out.append(c)
                    j += 1
                body.append("".join(out))
                if tail is not None:
                    break
                if i >= len(lines):
                    errs.append(f"line {start}: unterminated quote")
                    break
                buf = lines[i]
                i += 1
                body.append("\n")
            if tail is None:
                continue
            t = tail.strip()
            if t and not t.startswith("#"):
                errs.append(f"line {start}: text after the closing quote")
                continue
            value = "".join(body)
        else:
            value = re.split(r"\s#", rest, maxsplit=1)[0].rstrip()
        if "${" in value:
            warns.append(f"{key}: contains ${{...}}, kept literally (no variable expansion)")
        if key in vals:
            warns.append(f"{key}: defined twice, the later one wins")
        vals[key] = value
    return vals, warns, errs


def looks_secret(name, value):
    return bool(SECRET_HINT.search(name)) or bool(re.search(r"://[^/\s:@]+:[^@/\s]+@", value))


def find_env_files(root):
    out = []
    base = len(root.parts)
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in (".git", "node_modules", ".venv", "vendor", "target") and len(Path(d).parts) - base < 4]
        for f in files:
            if re.fullmatch(r"\.env(\..+)?", f) and not f.endswith(".example") and not (Path(d) / f).is_symlink():
                out.append(Path(d) / f)
    return sorted(out)


def pick_multi(rows, prompt, preselect, header=""):
    """Rows chosen in a multi-select fzf-menu (preselected indexes marked); None = cancelled, no menu = the preselection."""
    fm = tool("fzf-menu", required=False)
    if fm and (tty() or os.environ.get("WAYLAND_DISPLAY")):
        start = "+".join(f"pos({i + 1})+select" for i in preselect) + ("+first" if preselect else "")
        cmd = [fm, "--here", "--multi", "-p", prompt, "--bind", f"start:{start}" if start else "start:first"]
        if header:
            cmd += ["--header", header]
        p = subprocess.run(cmd, input="\n".join(rows) + "\n", capture_output=True, text=True)
        if p.returncode != 0:
            return None
        return [r for r in p.stdout.split("\n") if r]
    return [rows[i] for i in preselect]


def tracked_in_git(root, path):
    git = tool("git", required=False)
    if not git or not (root / ".git").exists():
        return False
    return subprocess.run([git, "-C", str(root), "ls-files", "--error-unmatch", "--", str(path)], capture_output=True,
                          stdin=subprocess.DEVNULL, env=git_env()).returncode == 0


def cmd_import(a):
    refuse_agent("import")
    cfg = load_cfg()
    require_bound(cfg)
    if a.file:
        path = Path(os.path.abspath(a.file))
    else:
        files = find_env_files(cfg.root)
        if (cfg.root / ".env") in files:
            path = cfg.root / ".env"
        elif len(files) == 1:
            path = files[0]
        elif files:
            got = pick([str(f.relative_to(cfg.root)) for f in files], ".env file")
            if not got:
                fail("no file chosen", 130)
            path = cfg.root / got
        else:
            fail("no .env file found (up to 4 levels below the project root)", 1)
    # a symlink (a build step can drop `.env -> ~/dotfiles/env.secret.sh`) or a file outside the project is never imported, and
    # never shredded (shred -u follows links); the open itself refuses a link that appears after the check
    if path.is_symlink() or not _under(path.parent, cfg.root) or _under(path.parent, cfg.root / ".git"):
        fail(f"{path} is a symbolic link or outside the project root {cfg.root}: copy the file into the project first", 1)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "r") as fh:
            # a hard link shares its inode with a file we cannot see (`ln ~/x/secrets .env`): the shred would empty that one
            if os.fstat(fh.fileno()).st_nlink > 1:
                fail(f"{path} has more than one hard link (the same file is also reachable under another name): copy it to a "
                     "fresh file first (`cp .env .env.new && mv .env.new .env`)", 1)
            text = fh.read()
    except OSError as e:
        fail(f"cannot read {path}: {e.strerror}")
    vals, warns, errs = parse_dotenv(text)
    for w in warns:
        warn(w)
    for er in errs:
        warn(er)
    if not vals:
        fail("nothing to import" + (" (the file has errors)" if errs else ""), 1)
    env = a.env
    if not env:
        got = None if not tty() else pick([e + ("  (default)" if e == cfg.default else "") for e in cfg.envs],
                                          "import into environment")
        env = got.split()[0] if got else (None if tty() else cfg.default)
        if not env:
            fail("no environment chosen", 130)
    need_env(cfg, env)
    guard_protected(cfg, env, a.prod, "import into")
    names = list(vals)
    secrets, plain = [], []
    if a.secrets is not None or a.plain is not None:
        secrets = [n for n in (a.secrets or "").split(",") if n]
        plain = [n for n in (a.plain or "").split(",") if n]
        for n in secrets + plain:
            if n not in vals:
                fail(f"{n} is not in {path.name}", 2)
        if set(secrets) & set(plain):
            fail("a name cannot be both secret and plain", 2)
        left = [n for n in names if n not in secrets and n not in plain]
        if left:
            warn(f"not imported (neither --secrets nor --plain): {', '.join(left)}")
    elif tty():
        rows = [f"{n}  {'secret' if looks_secret(n, vals[n]) else 'plain'}" for n in names]
        pre = [i for i, n in enumerate(names) if looks_secret(n, vals[n])]
        chosen = pick_multi(rows, "secrets (selected = secret)", pre, "Tab toggles, Enter imports: selected rows go to Bitwarden, "
                            "the others to mise [env] (committed in plain text)")
        if chosen is None:
            fail("cancelled", 130)
        secrets = [r.split()[0] for r in chosen]
        plain = [n for n in names if n not in secrets]
    else:
        fail("no terminal to classify the variables: pass --secrets A,B and --plain C,D", 2)
    for n in secrets + plain:
        why = bad_var_name(n)
        if why:
            warn(f"{n} {why}: skipped")
    secrets = [n for n in secrets if not bad_var_name(n)]
    plain = [n for n in plain if not bad_var_name(n)]
    # conflicts: a name that is already set where it would go
    target = mise_target(cfg.root, env, cfg.default)
    existing_plain = {}
    try:
        existing_plain = (tomllib.loads(target.read_text()).get("env") or {}) if target.exists() else {}
    except (OSError, ValueError):
        pass
    for n in list(plain):
        if n in cfg.secrets:
            warn(f"{n} is declared as a secret: skipped as plain")
            plain.remove(n)
    for n in list(secrets):
        if n in mise_env_keys(cfg.root):
            warn(f"{n} is a plain variable in mise [env]: skipped as secret")
            secrets.remove(n)
    n_sec = n_plain = 0
    skipped = []
    with write_lock():
        if secrets:
            m = bw_open()
            item = bw_env_item(m, cfg.project, env, create=True)
            have = set(item_field_names(item))
            for n in secrets:
                if n in have and not a.overwrite and not (tty() and confirm(f"{n} is already set in {env}. Overwrite?")):
                    skipped.append(n)
                    continue
                item_set_field(item, n, vals[n])
                n_sec += 1
            if n_sec:
                bw_save(m, item)
            newdecl = [n for n in secrets if n not in cfg.secrets and n not in skipped]
            if newdecl:
                def decl(ed):
                    for n in newdecl:
                        ed.set("secrets", n, '""')
                cfg = edit_cfg(cfg, decl)
            m.refresh_rbw()
        for n in plain:
            if n in existing_plain and not a.overwrite and not (tty() and confirm(f"{n} is already in {target.name}. Overwrite?")):
                skipped.append(n)
                continue
            edit_mise(target, lambda ed, n=n: ed.set("env", n, toml_str(vals[n])))
            n_plain += 1
    vals = None
    say(f"imported {n_sec} secret(s) into {cfg.folder}/{env} and {n_plain} plain variable(s) into {target.name}"
        + (f"; skipped (already set): {', '.join(skipped)}" if skipped else ""))
    if tracked_in_git(cfg.root, path):
        say(f"{path.name} is tracked in git: the values are in the history; rotate them and `git rm --cached {path.name}`")
    elif a.keep:
        say(f"{path.name} kept (--keep)")
    elif not tty():
        say(f"{path.name} kept (no terminal to confirm): `shred -u {path.name}` when you are sure")
    elif confirm(f"Shred {path.name} now?", default=True):
        sh = tool("shred", required=False)
        if sh and subprocess.run([sh, "-u", str(path)]).returncode == 0:
            say(f"{path.name} shredded (best effort on SSDs: rotate secrets that were ever committed or synced)")
        else:
            path.unlink(missing_ok=True)
            say(f"{path.name} removed")


EXAMPLE_HEAD = "# generated by envs export-example; values: envs run (secrets) / .mise.toml (plain)"


def cmd_export_example(a):
    cfg = load_cfg()
    out = Path(a.output) if a.output else cfg.root / ".env.example"
    if out.exists() and not a.force and not out.read_text().startswith(EXAMPLE_HEAD):
        fail(f"{out} was not written by envs export-example: pass --force to overwrite it", 1)
    lines = [EXAMPLE_HEAD]
    for n, desc in cfg.secrets.items():
        if desc:
            lines.append(f"# {desc}")
        lines.append(f"{n}=")
    plain = [k for k in mise_env_keys(cfg.root) if k not in cfg.secrets]
    if plain:
        lines.append("# set by mise")
        lines += [f"{k}=" for k in plain]
    out.write_text("\n".join(lines) + "\n")
    say(f"wrote {out} ({len(cfg.secrets)} secret names, {len(plain)} plain names; no values)")


def cmd_copy_value(a):
    refuse_agent("copy-value")
    cfg = load_cfg()
    require_bound(cfg)
    if a.name not in cfg.secrets:
        fail(f"{a.name} is not a declared secret", 2)
    env = choose_env(cfg, a.env)
    guard_protected(cfg, env, a.prod, "copy from")
    ensure_rbw()
    fields = env_fields(cfg.project, env) or {}
    if fields.get(a.name, "") == "":
        fail(f"{a.name} is not set in {env}", 1)
    vbw().copy(fields[a.name], True)
    fields = None
    say(f"{a.name} ({env}) copied: it is cleared from the clipboard after 30 seconds")


# check ---------------------------------------------------------------------------------------------------------------

def check_root(cfg, out):
    def add(level, msg):
        out.append((level, msg))
    for p in cfg.problems:
        add("error", p)
    if cfg.problems:
        return
    st, key, old = binding_state(cfg.root, cfg.project)
    add("ok" if st == "bound" else "warn", f"binding: {st}" + (f" (was Env/{old})" if old and st == "changed" else "")
        + (" (another repository than the bound one)" if st == "moved" else "")
        + ("" if st == "bound" else "; run `envs bind`"))
    git = tool("git", required=False)
    if git and (cfg.root / ".git").exists():
        tracked = subprocess.run([git, "-C", str(cfg.root), "ls-files", "--", ".env", ".env.*"], capture_output=True, text=True,
                                 stdin=subprocess.DEVNULL, env=git_env()).stdout.split()
        for t in tracked:
            if t != ".env.example":
                add("error", f"{t} is tracked in git: its values are in the history; rotate them and `git rm --cached {t}`")
    for n, f in parent_mise_overrides(cfg):
        add("warn", f"{n} is also set by mise [env] in {f}: that value overrides the injected secret")
    for f in sorted(cfg.root.glob(".env*")):
        if f.is_file() and f.name != ".env.example" and not f.name.endswith(".example"):
            add("warn", f"{f.name} is a plain env file: `envs import` moves it into Bitwarden")
    mise = tool("mise", required=False)
    if has_mise_config(cfg.root):
        if not mise:
            add("warn", "a mise config exists but mise is not installed")
        else:
            p = subprocess.run([mise, "ls", "--current", "--missing"], cwd=str(cfg.root), capture_output=True, text=True,
                               stdin=subprocess.DEVNULL)
            if p.returncode != 0:
                add("warn", "mise does not trust this config (run `envs trust`) or reports an error")
            elif p.stdout.strip():
                add("warn", f"mise tools are missing: {len(p.stdout.strip().splitlines())} (run `mise install`)")
            else:
                add("ok", "mise: trusted, no tools missing")
    matrix = vault_matrix(cfg)
    if matrix is None:
        add("info", "vault locked: items and fields not checked (unlock it and run again)")
        return
    for e, f in matrix.items():
        if isinstance(f, Fail):
            add("error", f"{e}: {f.msg}")
        elif f is None:
            add("warn", f"{e}: no item {cfg.folder}/{e} (created by the first `envs set NAME -e {e}`)")
        else:
            s, m, x = classify(cfg, f)
            add("ok" if not m else "warn", f"{e}: {len(s)} set" + (f", missing: {', '.join(m)}" if m else ""))
            if x:
                add("warn", f"{e}: undeclared fields (never injected): {', '.join(x)}")
            for n, v in f.items():
                if len(v) > FIELD_LIMIT:
                    add("warn", f"{e}: {n} is {len(v)} characters (Bitwarden fields fail above about 5000)")


def cmd_check(a):
    roots = []
    if a.all:
        for key in bindings():
            r = Path(key_root(key))
            if (r / TOML).is_file() and r not in roots:
                roots.append(r)
        try:
            here = find_root()
            if here not in roots:
                roots.insert(0, here)
        except Fail:
            pass
        if not roots and not (global_dir() / GLOBAL_TOML).is_file():
            say("no bound projects yet")
            return
    elif getattr(a, "global_", False):
        roots = [global_dir()]
    else:
        roots = [find_root()]
    if a.all and (global_dir() / GLOBAL_TOML).is_file() and global_dir() not in roots:
        roots.append(global_dir())
    bad = 0
    for r in roots:
        out = []
        check_root(load_cfg(r, strict=False), out)
        say(f"{r}")
        for level, msg in out:
            say(f"  {level:5} {msg}")
            bad += level == "error"
    if bad:
        raise Fail(f"{bad} error(s)", 1)


# ───────────────────────────── TUI ─────────────────────────────
# Same pattern as vault-browse.py: a Python loop around `fzf-menu --here`; rows are `ID<TAB>text` (the id column is hidden),
# NORMAL letters come through FZF_MENU_NORMAL_BINDS as become(printf query, ACTION, id), Alt keys through --expect (both
# work in both modes), Esc in NORMAL (fzf exit 1) goes one level up and quits at the top. Actions run in this terminal
# (prompts, then the list reopens at the same row). Values are masked everywhere; `v` shows one for 15 s.
# static.tsv rows mirror these tables (doctor keymap-doc checks that docs/keymap.md is generated from them).

NORMAL_KEYS = {
    "projects": [("l", "open"), ("n", "init"), ("i", "import"), ("x", "export"), ("c", "check"), ("s", "sync"),
                 ("r", "rename"), ("d", "delete"), ("b", "bind")],
    "envs": [("l", "open"), ("h", "back"), ("u", "use"), ("c", "copyto"), ("D", "diff"), ("n", "new"), ("r", "rename"),
             ("d", "delete")],
    "vars": [("h", "back"), ("y", "copy"), ("v", "reveal"), ("e", "edit"), ("a", "add"), ("r", "rename"), ("d", "delete"),
             ("p", "convert")],
}
ALT_KEYS = {
    "projects": {"alt-r": "rename", "alt-d": "delete"},   # no alt-s: Hyprland grabs Alt+S
    "envs": {"alt-u": "use", "alt-c": "copyto", "alt-n": "new", "alt-r": "rename", "alt-d": "delete"},
    "vars": {"alt-y": "copy", "alt-e": "edit", "alt-n": "add", "alt-a": "add", "alt-r": "rename", "alt-d": "delete",
             "alt-v": "reveal"},
}
HINTS = {
    "projects": "Enter/l open  n init  i import  x example  c check  s sync  r rename  d delete  b bind  Esc quit",
    "envs": "Enter/l variables  u use  c copy to  D diff  n new  r rename  d delete  h/Esc back",
    "vars": "Enter/y copy  v reveal  e edit  a add  r rename  d delete  p secret<->plain  h/Esc back",
}
RED, DIM, RST = "\033[31m", "\033[2m", "\033[0m"
REVEAL_SECONDS = 15


def reveal_file():
    """The reveal flag of THIS TUI run: `reveal-<pid>-<random>` in the runtime dir, handed to its fzf (and so to the preview
    commands) through ENVS_REVEAL_FILE and removed at exit. A preview started any other way has none: no value is ever shown;
    the flag counts only while the pid in its name is an ancestor of the preview and runs the TUI (see tui_ancestor)."""
    p = os.environ.get("ENVS_REVEAL_FILE")
    if not p:
        return None
    pp = Path(p)
    m = re.fullmatch(r"reveal-(\d+)-[0-9a-f]{12}", pp.name)
    if pp.parent != run_dir() or not m or not tui_ancestor(int(m.group(1))):
        return None
    return pp


def tui_ancestor(pid):
    """True when `pid` is an ancestor of this process AND runs the TUI (executable PY, argv `-I /abs/SELF`, no arguments). The flag name carries the
    pid of the run that wrote it, so a preview started by anything else (setsid, tmux, systemd-run: a process of its own that
    writes a flag and calls `_preview`) is not a reveal, and neither is a flag naming some other ancestor."""
    me, seen = os.getpid(), 0
    while me > 1 and seen < 64:
        if me == pid:
            break
        me = proc_ppid(me)
        seen += 1
    else:
        return False
    argv = proc_argv(pid)
    if len(argv) != 4 or argv[3] != b"" or argv[1] != b"-I":
        return False
    # the executable is what the kernel runs (/proc/PID/exe), never argv[0] (`exec -a` spoofs it, and a script that perl or
    # sh reads from stdin looks like `python3 -I envs`); the script path must be absolute and be this file (a relative one is
    # resolved against a cwd that the process can change after it started)
    a2 = argv[2].decode("utf-8", "replace")
    return proc_exe(pid) == os.path.realpath(PY) and os.path.isabs(a2) and os.path.realpath(a2) == str(SELF)


def read_reveal():
    """(project, env, name) while a reveal is active, else None; an expired or foreign flag is removed."""
    f = reveal_file()
    if f is None:
        return None
    try:
        parts = f.read_text().split("\t")
        if len(parts) == 4 and float(parts[3]) > time.time():
            return parts[0], parts[1], parts[2]
    except (OSError, ValueError):
        pass
    f.unlink(missing_ok=True)
    return None


def stale_reveal_files():
    """Flags of TUI runs that are gone (killed terminal): removed when a new TUI starts."""
    for f in run_dir().glob("reveal-*"):
        m = re.fullmatch(r"reveal-(\d+)-[0-9a-f]{12}", f.name)
        if m and not Path(f"/proc/{m.group(1)}").exists():
            f.unlink(missing_ok=True)


def project_roots():
    """{project: root} from the bound checkouts (and the one we stand in)."""
    out = {}
    for key, row in bindings().items():
        r = Path(key_root(key))
        if (r / TOML).is_file():
            out.setdefault(row[1], r)
    if (global_dir() / GLOBAL_TOML).is_file():
        out["global"] = global_dir()
    try:
        here = find_root()
        c = load_cfg(here, strict=False)
        if c.project:
            out[c.project] = here
    except Fail:
        pass
    return out


def vault_projects():
    """{project: [env names]} from the Env/* folders rbw knows; None when the vault is locked."""
    try:
        if not rbw_unlocked():
            return None
        items = rbw_list()
    except Fail:
        return None
    out = {}
    for i in items:
        f = i.get("folder") or ""
        if f.startswith("Env/") and "/" not in f[4:]:
            out.setdefault(f[4:], [])
            if str(i.get("type", "")).lower() in ("securenote", "secure note", "note", "2"):
                out[f[4:]].append(i.get("name"))
    return out


def short_path(p):
    p = str(p)
    h = str(HOME)
    return "~" + p[len(h):] if p.startswith(h) else p


def tui_header(project=None, env=None, cfg=None):
    rb = "rbw unlocked" if rbw_run("unlocked", timeout=10).returncode == 0 else "rbw locked"
    sess = run_dir().parent / "vault" / "bw-session"
    bw = "bw ready" if sess.exists() else ("bw locked" if tool("bw", "BW_BIN", required=False) else "bw not set up")
    left = " · ".join(x for x in (project, env) if x) or "projects"
    return f"{left} · {rb} · {bw}"


def reveal_ticker(sock, flag, key):
    """Refresh the preview once when a reveal expires (the cursor moving refreshes it by itself). The fzf listener needs the
    run's FZF_API_KEY: without it any process of this user could POST become(...) / execute(...) into the TUI."""
    import threading
    stop = threading.Event()

    def loop():
        while not stop.wait(1.0):
            try:
                text = flag.read_text().split("\t")
                expired = float(text[3]) <= time.time()
            except (OSError, ValueError, IndexError):
                continue
            curl = tool("curl", required=False)
            if expired and curl and os.path.exists(sock):
                subprocess.run([curl, "-s", "--max-time", "1", "--unix-socket", sock, "-K", "-", "-X", "POST",
                                "http://localhost", "-d", "refresh-preview"], input=f'header = "x-api-key: {key}"\n', text=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    threading.Thread(target=loop, daemon=True).start()
    return stop


_REVEAL = None                                   # this run's flag path (set by tui())


def preview_command(level, project, root, env):
    """The fzf --preview command line: every field quoted for `sh -c` (a checkout path can hold spaces or `$(...)`), the
    interpreter and script absolute."""
    fields = " ".join(shlex.quote(str(x)) for x in (level, project or "-", root or "-", env or "-"))
    return f"{shlex.quote(PY)} -I {shlex.quote(str(SELF))} _preview {fields} {{1}}"


def fzf_menu(rows, level, header, preview, here_row=None):
    """Run the list; returns (exit code, key/action, id). Actions are NORMAL letters (become) or Alt keys (--expect)."""
    binds = "\n".join(f'{k}:become(printf "%s\\n%s\\n%s\\n" {{q}} {a} {{1}})' for k, a in NORMAL_KEYS[level])
    args = ["--here", "-p", "envs", "--delimiter=\t", "--with-nth=2..", "--tabstop=4", "--ansi", "--print-query",
            "--expect=" + ",".join(ALT_KEYS[level]), f"--header={header}\n{HINTS[level]}"]
    if preview:
        args += [f"--preview={preview}", "--preview-window=right,50%,wrap,border-left"]
    if here_row is not None:
        args.append(f"--bind=load:pos({here_row + 1})")
    env = dict(os.environ, FZF_MENU_NORMAL_BINDS=binds, FZF_API_KEY=os.urandom(16).hex())
    if _REVEAL is not None:
        env["ENVS_REVEAL_FILE"] = str(_REVEAL)
    stop = None
    if level == "vars":
        sock = str(run_dir() / f"fzf-{os.getpid()}.sock")
        args.append(f"--listen={sock}")
        stop = reveal_ticker(sock, _REVEAL, env["FZF_API_KEY"])
    try:
        p = subprocess.run([tool("fzf-menu")] + args, input="\n".join(rows) + "\n", stdout=subprocess.PIPE, text=True, env=env)
    finally:
        if stop:
            stop.set()
    lines = p.stdout.split("\n")
    key = lines[1] if len(lines) > 1 else ""
    ident = (lines[2] if len(lines) > 2 else "").split("\t")[0]
    return p.returncode, key, ident


def run_self(*args, cwd=None, pause=False):
    """Run one of our own subcommands in this terminal (prompts work), optionally waiting for Enter afterwards."""
    p = subprocess.run([PY, "-I", str(SELF), *args], cwd=str(cwd) if cwd else None)
    if pause or p.returncode not in (0, 130):
        try:
            input("\n[Enter]")
        except (EOFError, KeyboardInterrupt):
            pass
    return p.returncode


def ask_line(label):
    try:
        return input(f"{label}: ").strip()
    except (EOFError, KeyboardInterrupt):
        return ""


def project_rows(cwd_project, roots):
    vp = vault_projects()
    names = sorted(set(roots) | set(vp or {}))
    rows = []
    for n in names:
        envs = (vp or {}).get(n)
        root = roots.get(n)
        sel = ""
        if root:
            a = active_get(root)
            sel = f"  [{a[0]}]" if a else ""
        text = f"{n:<22} {(str(len(envs)) + ' envs') if envs is not None else '? envs':<9} {short_path(root) if root else '(no checkout bound)'}{sel}"
        if n == cwd_project:
            text += "  <- here"
        rows.append(f"{n}\t{text}")
    return rows


def env_rows(cfg, vp_envs):
    rows = []
    act = active_get(cfg.root) if cfg else None
    cur = choose_env(cfg) if cfg else None
    names = list(cfg.envs) if cfg else sorted(vp_envs or [])
    for e in names:
        mark = "*" if e == cur else " "
        prot = cfg is not None and cfg.is_protected(e)
        tag = "protected" if prot else ""
        text = f"{mark} {e:<12} {tag:<10}" + (" (default)" if cfg and e == cfg.default else "")
        rows.append(f"{e}\t{RED + text + RST if prot else text}")
    return rows


def var_rows(cfg, fields, env):
    rows = []
    declared = list(cfg.secrets) if cfg else []
    for n in declared:
        state = "set" if isinstance(fields, dict) and fields.get(n, "") != "" else "missing"
        rows.append(f"{n}\t{n:<28} secret {state:<8} {cfg.secrets[n]}")
    for n in (fields or {}):
        if n not in declared:
            rows.append(f"{n}\t{n:<28} secret extra    {DIM}(not declared: never injected){RST}")
    if cfg:
        seen = set()
        for pth, fenv in mise_files(cfg.root):
            if fenv not in (None, env):
                continue
            try:
                for n in (tomllib.loads(pth.read_text()).get("env") or {}):
                    if n != "_" and n not in seen and n not in declared:
                        seen.add(n)
                        rows.append(f"{n}\t{n:<28} plain  {pth.name}")
            except (OSError, ValueError):
                pass
    return rows


def cmd_preview(a):
    """Internal: the preview pane of the TUI. Masked values only, except the one a `v` of THIS run revealed, and only for a
    bound checkout. Never for an agent."""
    refuse_agent("preview")
    level, project, ident = a.level, a.project, a.ident
    root = Path(a.root) if a.root and a.root != "-" else None
    if level == "projects":
        root = project_roots().get(ident)
    cfg = load_cfg(root, strict=False) if root else None
    if cfg and cfg.problems:
        cfg = None
    if level == "projects":
        say(f"project  {ident}")
        if root:
            c = load_cfg(root, strict=False)
            st = binding_state(root, c.project)[0] if c.project else "?"
            say(f"checkout {short_path(root)}   binding: {st}")
            say("")
            say(f"{'':<22} " + "  ".join(f"{e:<7}" for e in c.envs))
            mat = vault_matrix(c) if not c.problems else None
            for n in c.secrets:
                cells = []
                for e in c.envs:
                    f = (mat or {}).get(e)
                    cells.append("?" if mat is None else ("-" if not isinstance(f, dict) or f.get(n, "") == "" else "set"))
                say(f"{n:<22} " + "  ".join(f"{x:<7}" for x in cells))
        else:
            say("no checkout of this project is bound here: cd into it and run `envs bind`")
        return
    env = a.env
    if level == "envs":
        say(f"environment {ident}" + ("   [protected]" if cfg and cfg.is_protected(ident) else ""))
        try:
            fields = env_fields(project, ident) if rbw_unlocked() else None
        except Fail as e:
            say(f"error: {e.msg}")
            return
        if fields is None:
            say("no item yet" if rbw_unlocked() else "vault locked")
            return
        s, m, x = classify(cfg, fields) if cfg else ([], [], list(fields))
        for n in s:
            say(f"  {n:<26} {MASK}")
        for n in m:
            say(f"  {n:<26} missing")
        for n in x:
            say(f"  {n:<26} extra (not declared)")
        return
    # variables
    say(f"{ident}   ({project} / {env})")
    r = read_reveal()
    plain = cfg and any(ident in (tomllib.loads(pth.read_text()).get("env") or {}) for pth, fe in mise_files(cfg.root)
                        if fe in (None, env))
    if plain:
        for pth, fe in mise_files(cfg.root):
            if fe in (None, env):
                v = (tomllib.loads(pth.read_text()).get("env") or {}).get(ident)
                if v is not None:
                    say(f"plain value in {pth.name}: {v}")
        return
    try:
        fields = env_fields(project, env) if rbw_unlocked() else None
    except Fail as e:
        say(f"error: {e.msg}")
        return
    if fields is None or ident not in fields:
        say("not set" if fields is not None else "vault locked")
        if cfg and ident in cfg.secrets and cfg.secrets[ident]:
            say(cfg.secrets[ident])
        return
    if r and r == (project, env, ident) and cfg and cfg.project == project \
            and binding_state(cfg.root, cfg.project)[0] == "bound":
        if cfg.is_protected(env):
            journal(f"preview shows project={cfg.project} env={env} name={ident} (protected)")
        say(fields[ident])
        say("")
        say(f"(shown for {REVEAL_SECONDS} s or until the cursor moves)")
    else:
        if r and r != (project, env, ident) and reveal_file():
            reveal_file().unlink(missing_ok=True)
        say(MASK)
        if cfg and cfg.secrets.get(ident):
            say("")
            say(cfg.secrets[ident])
    fields = None


def cmd_convert(a):
    """secret -> plain (the values are written to .mise*.toml and COMMITTED) or plain -> secret, for every environment. Protected
    environments need --prod or their typed name, like any other read of them, and the read is logged."""
    refuse_agent("convert")
    cfg = load_cfg()
    require_bound(cfg)
    name, root = a.name, cfg.root
    if name in cfg.secrets:
        if not confirm(f"{name}: the value(s) will be written to .mise*.toml and COMMITTED in plain text. Continue?"):
            fail("not confirmed" + ("" if tty() else ": a terminal is needed"), 130 if tty() else 4)
        ensure_rbw()
        with write_lock():
            m = bw_open()
            found = {}
            for e in cfg.envs:
                item = bw_env_item(m, cfg.project, e)
                if item is None:
                    continue
                val = next((f.get("value") for f in item.get("fields") or [] if f.get("name") == name), None)
                if val is not None:
                    found[e] = (item, val)
            for e in found:
                if cfg.is_protected(e):
                    if not a.prod and not typed_confirm(e, f"{e} is protected: its value of {name} would go to a committed "
                                                           "plain-text file."):
                        fail(f"{e} is protected: pass --prod or type its name", 4 if not tty() else 130)
                    journal(f"convert project={cfg.project} env={e} name={name} (protected, to plain)")
            for e, (item, val) in found.items():
                edit_mise(mise_target(root, e, cfg.default), lambda ed, v=val: ed.set("env", name, toml_str(v)))
                item_drop_field(item, name)
                bw_save(m, item)
            m.refresh_rbw()
        edit_cfg(cfg, lambda ed: ed.remove("secrets", name))
        say(f"{name} is now a plain variable (mise [env])")
    else:
        found = []
        for pth, fenv in mise_files(root):
            v = (tomllib.loads(pth.read_text()).get("env") or {}).get(name)
            if v is not None:
                found.append((pth, fenv, v))
        if not found:
            fail(f"{name} is not a mise [env] variable", 1)
        with write_lock():
            m = bw_open()
            per_env = {fenv: v for _p, fenv, v in found if fenv}
            base = next((v for _p, fenv, v in found if fenv is None), None)
            for e in cfg.envs:
                v = per_env.get(e, base)
                if v is None:
                    continue
                item = bw_env_item(m, cfg.project, e, create=True)
                item_set_field(item, name, v)
                bw_save(m, item)
            m.refresh_rbw()
        for pth, _fenv, _v in found:
            edit_mise(pth, lambda ed: ed.remove("env", name))
        cfg = load_cfg(root)
        edit_cfg(cfg, lambda ed: ed.set("secrets", name, '""'))
        say(f"{name} is now a secret (Bitwarden), removed from the mise files")


def tui():
    global _REVEAL
    refuse_agent("the TUI")
    if not tty():
        fail("the TUI needs a terminal: run `envs` in one (tmux prefix v, hub row, SUPER+; j e)", 2)
    tool("fzf-menu")
    stale_reveal_files()
    _REVEAL = run_dir() / f"reveal-{os.getpid()}-{os.urandom(6).hex()}"
    try:
        tui_loop()
    finally:
        _REVEAL.unlink(missing_ok=True)


def tui_loop():
    cwd_cfg, cwd_project = None, None
    try:
        cwd_cfg = load_cfg(find_root(), strict=False)
        cwd_project = cwd_cfg.project
    except Fail:
        pass
    level = "envs" if cwd_cfg and not cwd_cfg.problems else "projects"
    project = cwd_cfg.project if level == "envs" else None
    env = None
    last = {"projects": None, "envs": None, "vars": None}
    try:
        ensure_rbw()
    except Fail as e:
        warn(e.msg)
    while True:
        roots = project_roots()
        root = roots.get(project) if project else None
        cfg = load_cfg(root, strict=False) if root else None
        if cfg and cfg.problems:
            warn("; ".join(cfg.problems))
            cfg = None
        if level == "projects":
            rows, header = project_rows(cwd_project, roots), tui_header()
        elif level == "envs":
            vp = vault_projects()
            rows = env_rows(cfg, (vp or {}).get(project))
            header = tui_header(project, None, cfg)
        else:
            try:
                fields = env_fields(project, env) if rbw_unlocked() else None
            except Fail as e:
                warn(e.msg)
                fields = None
            rows = var_rows(cfg, fields, env)
            header = tui_header(project, env, cfg)
        here = next((i for i, r in enumerate(rows) if r.split("\t")[0] == last[level]), None)
        if not rows:
            rows = ["-\t(nothing here yet: n adds one)"]
        code, key, ident = fzf_menu(rows, level, header, preview_arg(level, project, root, env), here)
        if code != 0:
            if level == "projects" or code == 130:
                return
            level = "envs" if level == "vars" else "projects"
            continue
        action = ALT_KEYS[level].get(key) or key or "enter"
        if ident in ("", "-") and action not in ("init", "sync", "new", "add", "check", "import", "bind", "back"):
            continue
        last[level] = ident
        try:
            level, project, env = tui_action(level, action, ident, project, env, cfg, root, cwd_project)
        except Fail as e:
            warn(e.msg)
            try:
                input("\n[Enter]")
            except (EOFError, KeyboardInterrupt):
                pass
        except (KeyboardInterrupt, EOFError):
            pass


def preview_arg(level, project, root, env):
    return preview_command(level, project, root, env)


def tui_action(level, action, ident, project, env, cfg, root, cwd_project):
    """One key. Returns the new (level, project, env)."""
    here = Path.cwd()
    if action == "back":
        return ("envs" if level == "vars" else "projects"), project, env
    if level == "projects":
        proot = project_roots().get(ident)
        if action in ("enter", "open"):
            return "envs", ident, None
        if action == "init":
            run_self("init", cwd=here, pause=True)
        elif action == "sync":
            rbw_run("sync", timeout=60)
            warn("synced")
        elif not proot:
            raise Fail(f"{ident}: no checkout of this project is bound here: cd into it and run `envs bind` first")
        elif action == "import":
            run_self("import", cwd=proot, pause=True)
        elif action == "export":
            run_self("export-example", cwd=proot, pause=True)
        elif action == "check":
            run_self("check", cwd=proot, pause=True)
        elif action == "bind":
            run_self("bind", cwd=proot, pause=True)
        elif action == "rename":
            new = ask_line(f"New name for {ident}")
            if new:
                run_self("project", "rename", new, cwd=proot, pause=True)
        elif action == "delete":
            run_self("project", "delete", cwd=proot, pause=True)
        return level, project, env
    if level == "envs":
        if action in ("enter", "open"):
            return "vars", project, ident
        if not cfg:
            raise Fail("no checkout of this project is bound here: cd into it and run `envs bind` first")
        if action == "use":
            run_self("use", ident, cwd=cfg.root, pause=cfg.is_protected(ident))
        elif action == "copyto":
            dst = pick([e for e in cfg.envs if e != ident], f"copy {ident} to")
            if dst:
                run_self("copy", ident, dst.split()[0], cwd=cfg.root, pause=True)
        elif action == "diff":
            other = pick([e for e in cfg.envs if e != ident], f"diff {ident} with")
            if other:
                run_self("diff", ident, other.split()[0], cwd=cfg.root, pause=True)
        elif action == "new":
            name = ask_line("New environment name")
            if name:
                run_self("env", "new", name, cwd=cfg.root, pause=True)
        elif action == "rename":
            new = ask_line(f"New name for {ident}")
            if new:
                run_self("env", "rename", ident, new, cwd=cfg.root, pause=True)
        elif action == "delete":
            run_self("env", "delete", ident, cwd=cfg.root, pause=True)
        return level, project, env
    # variables
    if not cfg:
        raise Fail("no checkout of this project is bound here: cd into it and run `envs bind` first")
    plain = any(ident in (tomllib.loads(pth.read_text()).get("env") or {}) for pth, fe in mise_files(cfg.root) if fe in (None, env))
    if action in ("enter", "copy"):
        if plain:
            raise Fail(f"{ident} is a plain variable: its value is in the mise file (visible in the preview)")
        rc = run_self("copy-value", ident, "-e", env, cwd=cfg.root)
        if rc == 0:
            warn("copied; cleared from the clipboard after 30 s")
    elif action == "reveal":
        if plain:
            raise Fail(f"{ident} is a plain variable: it is not hidden")
        if cfg.is_protected(env):
            if not typed_confirm(env, f"{env} is a protected environment: {ident} will be shown on this screen for "
                                      f"{REVEAL_SECONDS} s."):
                raise Fail(f"not confirmed: {ident} stays hidden", 4)
            journal(f"reveal project={cfg.project} env={env} name={ident} (protected)")
        atomic_write(_REVEAL, f"{project}\t{env}\t{ident}\t{time.time() + REVEAL_SECONDS}")
    elif action == "edit":
        run_self("set", ident, "-e", env, *(["--plain"] if plain else []), cwd=cfg.root)
    elif action == "add":
        name = ask_line("New variable name")
        if not name:
            return level, project, env
        kind = pick(["secret  (Bitwarden, hidden)", "plain   (mise [env], committed)"], "kind")
        if kind:
            run_self("set", name, "-e", env, *(["--plain"] if kind.startswith("plain") else []), cwd=cfg.root)
    elif action == "rename":
        new = ask_line(f"New name for {ident}")
        if new:
            run_self("rename", ident, new, cwd=cfg.root, pause=True)
    elif action == "delete":
        opts = [f"this environment ({env})", "all environments", "all environments and the declaration"]
        got = pick(opts, f"delete {ident}")
        if got == opts[0]:
            run_self("unset", ident, "-e", env, cwd=cfg.root, pause=True)
        elif got == opts[1]:
            run_self("unset", ident, "--all", cwd=cfg.root, pause=True)
        elif got:
            run_self("unset", ident, "--all", "--undeclare", cwd=cfg.root, pause=True)
    elif action == "convert":
        run_self("convert", ident, cwd=cfg.root, pause=True)
    return level, project, env


# ───────────────────────────── main ─────────────────────────────

def build_parser():
    import argparse
    ap = argparse.ArgumentParser(prog="envs", add_help=True, description="project environments and secrets (see the header of this file)")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("init")
    p.add_argument("--project")
    p.add_argument("--envs", default="dev,stage,prod")
    p.add_argument("--default")
    sub.add_parser("bind").add_argument("--yes", action="store_true")
    p = sub.add_parser("status")
    p.add_argument("-g", "--global", dest="global_", action="store_true")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("use")
    p.add_argument("env", nargs="?")
    p.add_argument("--prod", action="store_true")
    p.add_argument("--for", dest="for_")
    p = sub.add_parser("run")
    p.add_argument("-e", "--env")
    p.add_argument("--prod", action="store_true")
    p.add_argument("--sync", action="store_true")
    p.add_argument("--no-mise", action="store_true")
    p.add_argument("--allow-missing", action="store_true")
    p.add_argument("--only")
    p = sub.add_parser("set")
    p.add_argument("-g", "--global", dest="global_", action="store_true")
    p.add_argument("name")
    p.add_argument("extra", nargs="*")
    p.add_argument("-e", "--env")
    p.add_argument("--all", action="store_true")
    p.add_argument("--plain", action="store_true")
    p.add_argument("--stdin", action="store_true")
    p.add_argument("--description")
    p = sub.add_parser("unset")
    p.add_argument("-g", "--global", dest="global_", action="store_true")
    p.add_argument("name")
    p.add_argument("-e", "--env")
    p.add_argument("--all", action="store_true")
    p.add_argument("--undeclare", action="store_true")
    p = sub.add_parser("rename")
    p.add_argument("old")
    p.add_argument("new")
    p = sub.add_parser("copy")
    p.add_argument("src")
    p.add_argument("dst")
    p.add_argument("--overwrite", action="store_true")
    p.add_argument("--prod", action="store_true")
    p = sub.add_parser("diff")
    p.add_argument("a", nargs="?")
    p.add_argument("b", nargs="?")
    p = sub.add_parser("env")
    p.add_argument("action", choices=["new", "rename", "delete"])
    p.add_argument("names", nargs="+")
    p = sub.add_parser("project")
    p.add_argument("action", choices=["rename", "delete"])
    p.add_argument("new", nargs="?")
    p = sub.add_parser("import")
    p.add_argument("file", nargs="?")
    p.add_argument("-e", "--env")
    p.add_argument("--secrets")
    p.add_argument("--plain")
    p.add_argument("--keep", action="store_true")
    p.add_argument("--overwrite", action="store_true")
    p.add_argument("--prod", action="store_true")
    p = sub.add_parser("export-example")
    p.add_argument("-o", "--output")
    p.add_argument("--force", action="store_true")
    p = sub.add_parser("copy-value")
    p.add_argument("name")
    p.add_argument("-e", "--env")
    p.add_argument("--prod", action="store_true")
    p = sub.add_parser("_preview")
    p.add_argument("level")
    p.add_argument("project")
    p.add_argument("root")
    p.add_argument("env")
    p.add_argument("ident")
    p = sub.add_parser("check")
    p.add_argument("-g", "--global", dest="global_", action="store_true")
    p.add_argument("--all", action="store_true")
    sub.add_parser("trust")
    p = sub.add_parser("convert")
    p.add_argument("name")
    p.add_argument("--prod", action="store_true")
    return ap


HANDLERS = {"init": cmd_init, "bind": cmd_bind, "status": cmd_status, "use": cmd_use, "set": cmd_set, "unset": cmd_unset,
            "rename": cmd_rename, "check": cmd_check, "copy": cmd_copy, "diff": cmd_diff, "env": cmd_env,
            "project": cmd_project, "import": cmd_import, "export-example": cmd_export_example,
            "copy-value": cmd_copy_value, "_preview": cmd_preview, "trust": cmd_trust, "convert": cmd_convert}


class RunArgs:
    env, prod, sync, no_mise, allow_missing, global_, only = None, False, False, False, False, False, None


def usage_error(msg):
    print(f"envs: {msg}\nusage: envs run [-g] [-e ENV] [--prod] [--sync] [--no-mise] [--allow-missing] [--only NAME,NAME] -- CMD [ARGS...]", file=sys.stderr)
    return 2


def run_main(argv):
    """`envs run` is parsed by hand: argparse costs about 7 ms of imports, and this is the path every command of a project takes."""
    if "--" not in argv:
        return usage_error("run needs `--` before the command")
    i = argv.index("--")
    opts, cmd = argv[:i], argv[i + 1:]
    if not cmd:
        return usage_error("no command after --")
    a, k = RunArgs(), 0
    while k < len(opts):
        o = opts[k]
        if o in ("-e", "--env") and k + 1 < len(opts):
            a.env = opts[k + 1]
            k += 1
        elif o.startswith("--env="):
            a.env = o[6:]
        elif o == "--prod":
            a.prod = True
        elif o == "--sync":
            a.sync = True
        elif o == "--no-mise":
            a.no_mise = True
        elif o == "--allow-missing":
            a.allow_missing = True
        elif o in ("-g", "--global"):
            a.global_ = True
        elif o == "--only" and k + 1 < len(opts):
            a.only = [n for n in opts[k + 1].split(",") if n]
            k += 1
        else:
            return usage_error(f"unknown option {o}")
        k += 1
    try:
        return cmd_run(a, cmd) or 0
    except Fail as e:
        warn(e.msg)
        return e.code


def main(argv):
    harden_environment()
    if argv[:1] == ["run"]:
        return run_main(argv[1:])
    ap = build_parser()
    a = ap.parse_args(argv)
    try:
        if not a.cmd:
            tui()
            return 0
        HANDLERS[a.cmd](a)
    except Fail as e:
        warn(e.msg)
        return e.code
    except (KeyboardInterrupt, EOFError):
        if os.environ.get("ENVS_TRACE"):
            raise
        print(file=sys.stderr)
        return 130
    except SystemExit as e:
        return e.code if isinstance(e.code, int) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
