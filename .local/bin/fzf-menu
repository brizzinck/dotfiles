#!/usr/bin/env bash
# fzf-menu: a dmenu replacement. Rows on stdin, the choice on stdout, exit code 0 = chosen, 1 = cancelled.
# It opens the shared Telescope-like modal list (~/.config/fzf/vimfzf.sh: INSERT/NORMAL, Ctrl+j/k, Esc, ua/ru twins)
# in a floating ghostty (class float.tui) and refocuses the window that was active before.
#
#   printf '%s\n' a b c | fzf-menu -p pick
#   fzf-menu -p emoji --image 2 < rows.tsv       (image preview of the file named in tab field 2)
#
# Options (dmenu-compatible ones first):
#   -p, --prompt TEXT        prompt label (default: menu)
#   -i                       accepted and ignored (matching is smart-case)
#   -l N                     accepted and ignored
#   -m, --multi              multi-select (Tab / v), one line per choice
#   --header TEXT            header line (usually the key hints)
#   --preview CMD            preview command, `{}` = the row, `{1}` = a tab field (fzf syntax)
#   --preview-window OPTS    fzf preview window options (default: right,55%,wrap,border-left)
#   --image [FIELD]          preview the image file named in tab field FIELD (default 1) with chafa
#   --index                  print the 0-based line number of the chosen row instead of its text (rofi -format i);
#                            `{}` in a preview is then "N<TAB>row", use `{2..}` for the row text
#   --title TEXT             window title (default: "menu: PROMPT")
#   --size normal|large      window size: normal = 60% x 65% of the monitor (the float.tui rule), large = 85% x 85% (wide lists
#                            such as the shortcut search); the hidden server resizes + centres its window when it differs
#   --here                   run in the current terminal instead of a new window (python/zsh/tmux popups)
#   --no-restore             do not refocus the previously active window afterwards
#   Any other fzf option goes to fzf as it is (`--delimiter=$'\t'`, `--with-nth=2..`, `--accept-nth=1`, `--expect=alt-p`,
#   `--bind=...`, `--print-query`, `--query=...`). Options with a value must use the `--opt=value` form, except
#   --bind/--expect/--with-nth/--nth/--accept-nth/--delimiter/--query/--tiebreak/--tabstop which may also take a
#   separate argument.
#   FZF_MENU_HERE=1 in the environment acts like --here (test hook for scripts that call fzf-menu).
#   Extra NORMAL-mode letter binds: FZF_MENU_NORMAL_BINDS='d:execute(x)' (newline separated KEY:ACTION).
#
# Subcommands:
#   --server [a|b]           hold a hidden menu terminal (special workspace "menu-a" / "menu-b") that answers ONE request at once
#                            and then exits: the window closes like any window (the hub closes the same way, no jerk), and a
#                            standby terminal of the other slot, started 250 ms after a menu opened, takes the next request
#                            (~40 ms instead of a 0.4 s cold ghostty)
#                            A request is claimed with an atomic `mkdir req/owner` and `req/started` holds the serving pid, which the
#                            client watches (a closed menu window ends the call as cancelled); one terminal per slot (slot-a.lock)
#   --server-start           start the server unless one runs or waits (Hyprland autostart)
#   --self-test              headless check of the modal (private tmux server), exit 0 = every case passed
#   --cold                   force the cold path for this call (latency comparison)
#
# Toggle: calling it again while a menu is open closes that menu (the second press of a bind).
# State and requests live in $XDG_RUNTIME_DIR/fzf-menu (mode 700).
set -u

SELF=$(readlink -f "${BASH_SOURCE[0]}")
RUN="${XDG_RUNTIME_DIR:-/tmp}/fzf-menu"
LIB="${XDG_CONFIG_HOME:-$HOME/.config}/fzf/vimfzf.sh"
PREVIEW_IMG="${XDG_CONFIG_HOME:-$HOME/.config}/fzf/image-preview.sh"
SERVER_TITLE="fzf-menu-server"
SPECIAL="menu"                       # becomes menu-a / menu-b in server_main
TERMINAL=${FZF_MENU_TERMINAL:-ghostty}   # test hook: a fake terminal that starts the command in a private tmux

die() { echo "fzf-menu: $*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }
now_ms() { local t=${EPOCHREALTIME/./}; echo $((t / 1000)); }
in_hypr() { [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && have hyprctl; }
hdispatch() { hyprctl dispatch "$1" >/dev/null 2>&1; }

active_addr() { in_hypr && hyprctl activewindow -j 2>/dev/null | sed -n 's/^[[:space:]]*"address": "\(0x[0-9a-f]*\)".*/\1/p' | head -1; }

# ───────────────────────────── arguments ─────────────────────────────

PROMPT=menu HERE=0 NORESTORE=0 COLD=0 INDEX=0 TITLE="" SIZE=normal
FZF_ARGS=()
parse_args() {
  local image="" delim=$'\t'
  while (($#)); do
    case $1 in
      -p | --prompt) PROMPT=${2-}; shift ;;
      --prompt=*) PROMPT=${1#*=} ;;
      -i) ;;
      -l) shift ;;
      -m | --multi) FZF_ARGS+=(--multi) ;;
      --header) FZF_ARGS+=("--header=${2-}"); shift ;;
      --preview) FZF_ARGS+=("--preview=${2-}"); shift ;;
      --preview-window) FZF_ARGS+=("--preview-window=${2-}"); shift ;;
      --image)
        image=1
        if [[ ${2-} =~ ^[0-9]+$ ]]; then image=$2; shift; fi
        ;;
      --title) TITLE=${2-}; shift ;;
      --size) SIZE=${2-normal}; shift ;;
      --size=*) SIZE=${1#*=} ;;
      --here) HERE=1 ;;
      --index) INDEX=1 ;;
      --no-restore) NORESTORE=1 ;;
      --cold) COLD=1 ;;
      --bind | --expect | --with-nth | --nth | --accept-nth | --delimiter | --query | --tiebreak | --tabstop | --scheme)
        FZF_ARGS+=("$1=${2-}"); shift ;;
      --) shift; FZF_ARGS+=("$@"); break ;;
      -h | --help) sed -n '2,/^set -u/p' "$SELF" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
      *) FZF_ARGS+=("$1") ;;
    esac
    shift
  done
  if [[ -n $image ]]; then
    local has_delim=0 a
    for a in "${FZF_ARGS[@]}"; do [[ $a == --delimiter=* ]] && has_delim=1; done
    ((has_delim)) || FZF_ARGS+=("--delimiter=$delim")
    FZF_ARGS+=("--preview=$PREVIEW_IMG {$image}")
    local has_pw=0
    for a in "${FZF_ARGS[@]}"; do [[ $a == --preview-window=* ]] && has_pw=1; done
    ((has_pw)) || FZF_ARGS+=("--preview-window=right,60%,border-left")
  fi
  local has_pw2=0 a
  for a in "${FZF_ARGS[@]}"; do [[ $a == --preview-window=* ]] && has_pw2=1; done
  if ((!has_pw2)); then
    for a in "${FZF_ARGS[@]}"; do
      [[ $a == --preview=* ]] && { FZF_ARGS+=("--preview-window=right,55%,wrap,border-left"); break; }
    done
  fi
  if ((INDEX)); then FZF_ARGS+=(--delimiter=$'\t' --with-nth=2.. --accept-nth=1); fi
  [[ -n $TITLE ]] || TITLE="menu: $PROMPT"
  case $SIZE in normal | large) ;; *) die "--size takes normal or large" ;; esac
}

# window size of a menu in percent of the monitor (logical pixels): "W H"
size_pct() { case ${1:-normal} in large) echo "85 85" ;; *) echo "60 65" ;; esac; }

# rows on stdin; --index prepends the 0-based line number as a hidden first field
rows_in() { if ((INDEX)); then awk '{ printf "%d\t%s\n", NR - 1, $0 }'; else cat; fi; }

# ───────────────────────────── the list itself ─────────────────────────────

# run_list [IN OUT]: rows from IN (default stdin), the selection into OUT (default stdout); the fzf status is
# mapped to 0 (chosen) / 1 (cancelled or no match) / the fzf error code
run_list() {
  local in=${1:-/dev/stdin} out=${2:-/dev/stdout} rc b
  [[ -r $LIB ]] || die "missing $LIB"
  # shellcheck source=/dev/null
  . "$LIB"
  export VF_PROMPT=$PROMPT
  VF_NORMAL_BINDS=()
  if [[ -n ${FZF_MENU_NORMAL_BINDS:-} ]]; then
    while IFS= read -r b; do [[ -n $b ]] && VF_NORMAL_BINDS+=("$b"); done <<<"$FZF_MENU_NORMAL_BINDS"
  fi
  rc=0
  # a menu window closes right after fzf: --no-clear keeps the menu itself as the last frame (fzf would leave the alternate
  # screen and show the blank terminal during the close animation); --here keeps the terminal clean for the caller
  local keep=()
  ((HERE)) || keep=(--no-clear)
  vimfzf "${FZF_ARGS[@]}" "${keep[@]}" <"$in" >"$out" || rc=$?
  case $rc in 0) return 0 ;; 1 | 130 | 143) return 1 ;; *) return "$rc" ;; esac
}

# ───────────────────────────── requests (cold window or hidden server) ─────────────────────────────

# a request directory holds: in (rows), out (selection), rc, cfg (bash: PROMPT, FZF_ARGS, TITLE, NORESTORE), env
write_request() {
  local req=$1
  rows_in >"$req/in"
  {
    declare -p PROMPT TITLE NORESTORE SIZE
    declare -p FZF_ARGS
    [[ -n ${FZF_MENU_NORMAL_BINDS:-} ]] && declare -p FZF_MENU_NORMAL_BINDS
  } >"$req/cfg"
  env -0 >"$req/env"
}

# serve_request DIR: runs in the terminal that shows the list
serve_request() {
  local req=$1 rc=0 kv
  [[ -d $req && -r $req/cfg ]] || die "bad request $req"
  (
    # fzf and every execute / preview child it starts inherit the open descriptors: the fifo (3), the slot lock (5), the standby and
    # server locks (6, 7), the request pipe (8) and the client's menu lock (9). A detached app started from a menu action must not
    # keep any of them (it would hold server.lock for ever: the standby never gets its turn and every later menu goes cold)
    exec 3>&- 5>&- 6>&- 7>&- 8>&- 9>&-
    echo "$BASHPID" >"$RUN/active.pid"
    # the caller's environment (CLIP_*, preview helpers, ...) without the terminal identity of the caller
    while IFS= read -r -d '' kv; do
      case ${kv%%=*} in
        _ | SHLVL | PWD | OLDPWD | SHELL | TERM | COLORTERM | TERM_* | GHOSTTY_* | TMUX | TMUX_PANE | KITTY_* | COLUMNS | LINES | BASH* | PPID | UID | EUID) continue ;;
      esac
      # shellcheck disable=SC2163 # kv is a NAME=value pair
      export "$kv" 2>/dev/null || true
    done <"$req/env"
    # shellcheck source=/dev/null
    . "$req/cfg"
    printf '\033]2;%s\007' "$TITLE"
    # a cold window opens at the float.tui rule size; a server window was already sized by server_show
    if [[ $SERVER_MODE != 1 && $SIZE != normal ]] && in_hypr; then geometry_apply "$(server_window)" "$SIZE"; fi
    [[ -n ${FZF_MENU_TRACE:-} ]] && echo "list_start $(now_ms)" >>"$req/trace"
    run_list "$req/in" "$req/out"
  ) || rc=$?
  # no terminal reset here: the window closes right after, and fzf --no-clear left the menu itself as the last frame
  echo "$rc" >"$req/rc"
}

SERVER_MODE=0

server_alive() {
  local pid
  pid=$(cat "$RUN/server.pid" 2>/dev/null) || return 1
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && [[ -p $RUN/server.fifo ]]
}

# a standby terminal holds standby.lock while it waits for the active server to finish
standby_waiting() { ( exec 6>"$RUN/standby.lock"; flock -n 6 ) && return 1; return 0; }

# the hand-over gap of a one-shot server: the active one just finished and the standby takes over within milliseconds
wait_server() {
  local i
  server_alive && return 0
  standby_waiting || return 1
  for ((i = 0; i < 30; i++)); do
    server_alive && return 0
    sleep 0.01
  done
  return 1
}

active_menu_pid() { cat "$RUN/active.pid" 2>/dev/null; }

# the menu in flight is a fzf child of the server or of the cold terminal's request process
close_active_menu() {
  local p
  p=$(active_menu_pid)
  [[ -n $p ]] && kill -0 "$p" 2>/dev/null && pkill -TERM -P "$p" -x fzf 2>/dev/null
}

# A one-shot server claims a request with an atomic `mkdir $req/owner` and then writes its OWN pid into `$req/started`. The client
# gives up on a request only by taking that claim itself, so a request is served by exactly one side (the late server skips it).
# While the menu is open the client watches that pid: a window closed with SUPER+W (or a crash) must end the call, whoever else
# serves the next request (the standby becomes a live server at that moment, so "a server is alive" says nothing about this menu).
hot_request() { # REQ -> 0 when answered (also cancelled by a dead server), 1 when the server did not take it
  local req=$1 i spid deadline
  mkfifo "$req/done"
  exec 8<>"$req/done"
  if [[ -p $RUN/server.fifo ]]; then printf '%s\n' "$req" >"$RUN/server.fifo"; else exec 8>&-; return 1; fi
  # the server answers at once; no `started` within 0.5 s means it is busy or gone (the cold path takes over)
  for ((i = 0; i < 50; i++)); do
    [[ -e $req/started ]] && break
    read -r -t 0.01 -u 8 && return 0
  done
  if [[ ! -e $req/started ]]; then
    # claim the request for the cold path; when the claim fails the server owns it (it may stall for seconds under load between
    # its `mkdir owner` and writing `started`): never go cold then, that would be a second menu. Wait for `started` (or an
    # answer) as long as the server process lives; when it died without either, the request counts as cancelled.
    if mkdir "$req/owner" 2>/dev/null; then exec 8>&-; return 1; fi
    # The pid is read ONCE, now: server.pid belongs to the server that holds the claim. Following the file would make a NEW server
    # (a standby that took over after this one died before `started`) keep the wait alive for ever; the wait is bounded as well.
    spid=$(cat "$RUN/server.pid" 2>/dev/null)
    deadline=$((SECONDS + ${FZF_MENU_CLAIM_WAIT:-30}))
    while [[ ! -e $req/started && ! -e $req/rc ]]; do
      if [[ -z $spid ]] || ! kill -0 "$spid" 2>/dev/null || ((SECONDS >= deadline)); then
        [[ -e $req/started || -e $req/rc ]] || echo 1 >"$req/rc"
        break
      fi
      sleep 0.01
    done
    [[ -e $req/rc ]] && { exec 8>&-; return 0; }
  fi
  spid=$(cat "$req/started" 2>/dev/null)
  while ! read -r -t 0.5 -u 8; do
    # a one-shot server writes `rc` before it reports `finished` and exits: an rc file is an answer
    [[ -e $req/rc ]] && break
    if [[ -n $spid ]]; then
      kill -0 "$spid" 2>/dev/null && continue
      # the serving terminal died without an answer: the menu is gone, count it as cancelled (never run it again cold)
      [[ -e $req/rc ]] || echo 1 >"$req/rc"
      break
    fi
    # a server that does not write its pid (an older one): the old rule, any live server keeps the wait going
    server_alive && continue
    exec 8>&-
    return 1
  done
  exec 8>&-
  return 0
}

cold_request() { # REQ: a fresh ghostty that exits with the list
  local req=$1
  # 8 and 9 closed: a detached app started from the menu must not keep the client's menu.lock (it would swallow every later menu)
  env -u TMUX -u TMUX_PANE "$TERMINAL" --class=float.tui --title="$TITLE" -e "$SELF" --serve-request "$req" 8>&- 9>&- >/dev/null 2>&1
}

REQ=""
cleanup_req() { [[ -n $REQ && -d $REQ ]] && rm -rf "$REQ"; exec 9>&-; }

menu_gui() {
  local req prev rc=0 t0 hot=0
  t0=$(now_ms)
  mkdir -p "$RUN" && chmod 700 "$RUN"
  have "$TERMINAL" || die "$TERMINAL not found (use --here)"
  # toggle: a second call closes the menu that is open
  exec 9>"$RUN/menu.lock"
  if ! flock -n 9; then close_active_menu; cat >/dev/null; exit 1; fi
  prev=$(active_addr)
  [[ -n $prev ]] && printf '%s\n' "$prev" >"$RUN/prev-window"
  # requests of crashed callers older than an hour
  find "$RUN" -maxdepth 1 -name 'req.*' -mmin +60 -exec rm -rf {} + 2>/dev/null
  req=$(mktemp -d "$RUN/req.XXXXXX") || die "cannot create a request directory"
  REQ=$req
  trap cleanup_req EXIT
  write_request "$req"
  [[ -n ${FZF_MENU_TRACE:-} ]] && echo "t0 $t0" >"$req/trace"
  if ((!COLD)) && wait_server; then
    hot=1
    if ! hot_request "$req"; then hot=0; rm -f "$req/started" "$req/rc"; fi
  fi
  if ((!hot)); then
    : >"$req/started"
    cold_request "$req"
    # a menu terminal that died before answering counts as a cancel
    [[ -e $req/rc ]] || echo 1 >"$req/rc"
    ensure_server
  fi
  rc=$(cat "$req/rc" 2>/dev/null || echo 1)
  [[ -r $req/out ]] && cat "$req/out"
  [[ -n ${FZF_MENU_TRACE:-} ]] && { cat "$req/trace" >&2; echo "t_end $(now_ms) hot=$hot" >&2; }
  restore_focus "$prev"
  return "$rc"
}

restore_focus() {
  local prev=${1:-} cur
  ((NORESTORE)) && return 0
  [[ -n $prev ]] && in_hypr || return 0
  cur=$(active_addr)
  [[ $cur == "$prev" ]] && return 0
  hdispatch "hl.dsp.focus({ window = \"address:$prev\" })"
}

other_slot() { [[ $1 == a ]] && echo b || echo a; }

# start one hidden terminal of a slot (it blocks on the locks in server_main until it is its turn)
spawn_slot() {
  local slot=${1:-a}
  # the lock descriptors of the caller must not leak into the new terminal (the active server's lock would never be released)
  env -u TMUX -u TMUX_PANE setsid -f "$TERMINAL" --class=float.tui --title="$SERVER_TITLE-$slot" -e "$SELF" --server "$slot" \
    3>&- 5>&- 6>&- 7>&- 8>&- 9>&- >/dev/null 2>&1 </dev/null
}

# start the first hidden terminal: only when no server is running and none waits (a lock keeps two callers from starting two)
spawn_server() {
  mkdir -p "$RUN" && chmod 700 "$RUN"
  server_alive && return 0
  in_hypr || return 0
  (
    exec 9>"$RUN/spawn.lock"
    flock -n 9 || exit 0
    server_alive && exit 0
    standby_waiting && exit 0
    spawn_slot a
    sleep 2
  )
}

# after a cold menu: make sure the next one is fast
ensure_server() {
  [[ ${FZF_MENU_NO_SERVER:-} == 1 ]] && return 0
  # without 8 / 9 the background spawn (it sleeps 2 s) would keep the client's menu.lock and every menu in that time would exit 1
  spawn_server >/dev/null 2>&1 8>&- 9>&- &
  disown 2>/dev/null || true
}

# ───────────────────────────── geometry (server windows) ─────────────────────────────

# window_state ADDR: "WIDTH HEIGHT MONITOR_ID FOCUSED_MONITOR_ID FOCUSED_W FOCUSED_H" (sizes in logical pixels)
window_state() {
  jq -rn --arg a "$1" --argjson c "$(hyprctl -j clients 2>/dev/null || echo '[]')" --argjson m "$(hyprctl -j monitors 2>/dev/null || echo '[]')" '
    ([$m[] | select(.focused)][0]) as $f | ([$c[] | select(.address == $a)][0]) as $w
    | if $f == null then empty
      else "\(($w.size[0]) // 0) \(($w.size[1]) // 0) \(($w.monitor) // -1) \($f.id) \(($f.width / $f.scale) | floor) \(($f.height / $f.scale) | floor)" end'
}

# geometry_lua ADDR SIZE [TOGGLE_SPECIAL]: the Lua chunk for ONE `hyprctl eval` (one IPC round trip for the whole show).
# Plain toggle when the window already has the target size on the focused monitor; otherwise toggle + resize + centre with the
# window's own animations off for those dispatches (the resize must not be seen as a move). Prints nothing when there is
# nothing to do and no toggle was asked for.
geometry_lua() {
  local addr=$1 size=$2 toggle=${3:-} st cw ch cmon fmon fw fh pw ph tw th w lua=""
  [[ -n $toggle ]] && lua="hl.dispatch(hl.dsp.workspace.toggle_special(\"$toggle\"))"
  # window not found: only the toggle (every window dispatcher with `address:` and nothing after it is a no-op or an INFO error)
  [[ -n $addr ]] || { printf '%s' "$lua"; return 0; }
  st=$(window_state "$addr") && [[ -n $st ]] || { printf '%s' "$lua"; return 0; }
  read -r cw ch cmon fmon fw fh <<<"$st"
  read -r pw ph <<<"$(size_pct "$size")"
  tw=$((fw * pw / 100)) th=$((fh * ph / 100))
  if ((cmon == fmon && cw - tw <= 2 && tw - cw <= 2 && ch - th <= 2 && th - ch <= 2)); then printf '%s' "$lua"; return 0; fi
  w="address:$addr"
  printf '%s\n' \
    "hl.dispatch(hl.dsp.window.set_prop({ prop = \"no_anim\", value = \"1\", window = \"$w\" }))" \
    "$lua" \
    "hl.dispatch(hl.dsp.window.resize({ x = $tw, y = $th, relative = false, window = \"$w\" }))" \
    "hl.dispatch(hl.dsp.window.center({ window = \"$w\" }))" \
    "hl.dispatch(hl.dsp.window.set_prop({ prop = \"no_anim\", value = \"unset\", window = \"$w\" }))"
}

geometry_apply() { # ADDR SIZE: resize + centre only (cold window)
  local lua
  [[ -n ${1:-} ]] || return 0
  lua=$(geometry_lua "$1" "$2")
  [[ -n $lua ]] && hyprctl eval "$lua" >/dev/null 2>&1
  return 0
}

# ───────────────────────────── the hidden server ─────────────────────────────

SHOWN=0
server_window() { # address of the ghostty window that runs this server (its pid is our parent)
  [[ -n ${FZF_MENU_SERVER_ADDR:-} ]] && { printf '%s\n' "$FZF_MENU_SERVER_ADDR"; return 0; }
  hyprctl clients -j 2>/dev/null | jq -r --argjson p "$PPID" '[.[] | select(.pid == $p)][0].address // empty'
}

# show the server window: the special workspace opens instantly (no animation in), the size is fixed in the same eval
server_show() {
  local addr=$1 lua
  ((SHOWN)) && return 0
  SHOWN=1
  in_hypr || return 0
  lua=$(geometry_lua "$addr" "$SIZE" "$SPECIAL")
  [[ -n $lua ]] && hyprctl eval "$lua" >/dev/null 2>&1
  return 0
}

# the window rule parks the window on its special workspace; do it by hand when the rule is missing
park_window() { # ADDR
  local addr=$1 ws
  [[ -n $addr && -z ${FZF_MENU_SERVER_ADDR:-} ]] || return 0
  ws=$(hyprctl clients -j 2>/dev/null | jq -r --arg a "$addr" '.[] | select(.address == $a) | .workspace.name')
  [[ $ws == "special:$SPECIAL" ]] || hdispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"special:$SPECIAL\", follow = false })"
}

# only the active server owns the fifo and the pid file (a standby of the other slot may already have made its own)
server_cleanup() {
  if [[ $(cat "$RUN/server.pid" 2>/dev/null) == "$$" ]]; then rm -f "$RUN/server.fifo" "$RUN/server.pid"; fi
  # after the files are gone (the standby that takes the lock makes its own), and also on SIGHUP: a copy of the descriptor in a
  # child must not keep server.lock
  flock -u 7 2>/dev/null
  exec 5>&- 2>/dev/null   # the slot lock too: a server that lingers after its answer must not keep its slot
  return 0
}

# One-shot server terminal of a slot (a or b): waits hidden, serves exactly ONE request, then exits. The window therefore
# closes like any window (the hub does the same): Hyprland fades the last frame (the menu itself, fzf --no-clear) and closes
# the empty special workspace by itself (misc:close_special_on_empty). 250 ms after a menu opened a standby of the other slot
# is started, so the next menu is hot again.
server_main() {
  local slot=${1:-a} req="" addr ws i
  case $slot in a | b) ;; *) slot=a ;; esac
  SPECIAL="menu-$slot"
  mkdir -p "$RUN" && chmod 700 "$RUN"
  SERVER_MODE=1
  # one terminal per slot for its whole life: a second one of the same slot (a cold menu spawning slot a while the standby a is still
  # on its way) would put two windows on the same special workspace and its toggle would hide the menu instead of showing it
  exec 5>"$RUN/slot-$slot.lock"
  flock -w 0.5 5 || exit 0
  # at most one waiting standby (a probe of standby_waiting takes the lock for a moment, hence the short wait); then wait
  # (blocking) until the active server is done
  exec 6>"$RUN/standby.lock"
  flock -w 0.2 6 || exit 0
  # the window lookup (hyprctl clients + jq, slow under load) is done now, while this terminal only waits: once it is the active
  # server a client finds the fifo and `started` comes at once
  addr=$(server_window)
  park_window "$addr"
  exec 7>"$RUN/server.lock"
  flock 7
  flock -u 6
  exec 6>&-
  rm -f "$RUN/server.fifo"
  mkfifo "$RUN/server.fifo"
  echo $$ >"$RUN/server.pid"
  echo "$slot" >"$RUN/server.slot"
  trap server_cleanup EXIT
  trap 'exit 0' TERM INT HUP
  exec 3<>"$RUN/server.fifo"
  printf '\033]2;%s\007' "$SERVER_TITLE-$slot"
  if [[ -z $addr ]]; then   # the window was not mapped yet at the first try (a fresh server): a few more tries
    for ((i = 0; i < 5 && ${#addr} == 0; i++)); do sleep 0.1; addr=$(server_window); done
    park_window "$addr"
  fi
  clear
  # a request is ours only when the atomic claim works (a client that gave up took it first: skip, wait for the next one)
  while read -r -u 3 req; do
    [[ $req == "$RUN"/req.* && -d $req ]] && mkdir "$req/owner" 2>/dev/null && break
    req=""
  done
  if [[ -n $req ]]; then
    echo $$ >"$req/started.tmp" && mv -f "$req/started.tmp" "$req/started"   # our pid: the client watches it
    [[ -n ${FZF_MENU_TRACE:-} || -e $req/trace ]] && echo "server_got $(now_ms)" >>"$req/trace"
    # the standby of the other slot, detached (the window and this shell are gone by then)
    setsid -f "$SELF" --spawn-standby "$(other_slot "$slot")" 3>&- 5>&- 6>&- 7>&- 8>&- 9>&- >/dev/null 2>&1 </dev/null
    # the size of THIS request (the cfg is bash `declare` output; only its SIZE line is read here)
    SIZE=$(sed -n 's/^declare -- SIZE="\(.*\)"$/\1/p' "$req/cfg")
    [[ $SIZE == large ]] || SIZE=normal
    server_show "$addr"
    [[ -e $req/trace ]] && echo "shown $(now_ms)" >>"$req/trace"
    serve_request "$req"
  fi
  server_cleanup
  trap - EXIT
  # O_RDWR on the fifo never blocks (a write-only open blocks for ever when the client already gave up and closed its end: it
  # returns on seeing the `rc` file after a 0.5 s read timeout, which can fall between our `rc` and this line)
  [[ -n $req ]] && { exec 4<>"$req/done" && echo finished >&4; exec 4>&-; } 2>/dev/null
  exit 0
}

# ───────────────────────────── self-test ─────────────────────────────

self_test() {
  local sock="fzfmenu-selftest-$$" fails=0 out name
  have tmux || { echo "self-test: tmux is required"; return 2; }
  have fzf || { echo "self-test: fzf is required"; return 2; }
  [[ -r $LIB ]] || { echo "self-test: missing $LIB"; return 2; }
  # poll the pane until it matches (a fixed sleep flaked under load): wait_pane PATTERN SECONDS
  wait_pane() { local i; for ((i = 0; i < $2 * 20; i++)); do [[ $(tmux -L "$sock" capture-pane -p -t t 2>/dev/null) == *"$1"* ]] && return 0; sleep 0.05; done; return 1; }
  case_run() { # NAME EXPECT KEYS...  (keys: literal text with = prefix, otherwise tmux key names)
    local name=$1 want=$2 k
    shift 2
    tmux -L "$sock" kill-session -t t 2>/dev/null
    tmux -L "$sock" new-session -d -s t -x 100 -y 24 \
      "bash -c 'out=\$($SELF --here -p \"\${TEST_PROMPT:-test}\" < <(seq 30)); echo \"RES[\$out]\"; sleep 3'"
    wait_pane '[I] test>' 5
    for k in "$@"; do
      if [[ $k == =* ]]; then tmux -L "$sock" send-keys -t t -l "${k#=}"; else tmux -L "$sock" send-keys -t t "$k"; fi
      # an Escape from INSERT is only done when the tag says NORMAL (the next key must not arrive inside fzf's escape delay)
      if [[ $k == Escape ]] && [[ $(tmux -L "$sock" capture-pane -p -t t) == *"[I] test>"* ]]; then wait_pane '[N] test>' 2; fi
      sleep 0.15
    done
    wait_pane 'RES[' 3
    out=$(tmux -L "$sock" capture-pane -p -t t | grep -a 'RES\[' | head -1)
    if [[ $out == "RES[$want]" ]]; then printf 'ok    %s\n' "$name"; else printf 'FAIL  %s (got %s, want RES[%s])\n' "$name" "${out:-nothing}" "$want"; fails=$((fails + 1)); fi
  }
  prompt_case() { # prompt text with fzf action delimiters in it: the menu opens, shows it, keeps the [I]/[N] tag
    local want=$1 shot ok=1 p='Pick: a (b), c [d] + e, f = g'
    tmux -L "$sock" kill-session -t t 2>/dev/null
    tmux -L "$sock" new-session -d -s t -x 100 -y 24 -e "TEST_PROMPT=$p" \
      "bash -c 'out=\$($SELF --here -p \"\$TEST_PROMPT\" < <(seq 30)); echo \"RES[\$out]\"; sleep 3'"
    sleep 0.7
    shot=$(tmux -L "$sock" capture-pane -p -t t)
    [[ $shot == *"[I] $p>"* ]] || ok=0
    tmux -L "$sock" send-keys -t t Escape; sleep 0.3
    shot=$(tmux -L "$sock" capture-pane -p -t t)
    [[ $shot == *"[N] $p>"* ]] || ok=0
    tmux -L "$sock" send-keys -t t -l i; sleep 0.3
    shot=$(tmux -L "$sock" capture-pane -p -t t)
    [[ $shot == *"[I] $p>"* ]] || ok=0
    tmux -L "$sock" send-keys -t t -l 7; sleep 0.2
    tmux -L "$sock" send-keys -t t Enter; sleep 0.5
    shot=$(tmux -L "$sock" capture-pane -p -t t | grep -a 'RES\[' | head -1)
    [[ $shot == "RES[$want]" ]] || ok=0
    if ((ok)); then printf 'ok    %s\n' "prompt with ( ) [ ] , + = : keeps the modal"; else printf 'FAIL  %s\n' "prompt with ( ) [ ] , + = : keeps the modal"; fails=$((fails + 1)); fi
  }
  case_run "INSERT: type filters" 2 '=2' Enter
  case_run "INSERT: Ctrl+j moves down" 2 C-j Enter
  case_run "INSERT: Ctrl+n / Ctrl+p" 2 C-n C-n C-p Enter
  case_run "INSERT: Esc then j" 2 Escape '=j' Enter
  case_run "NORMAL: G last, g first" 1 Escape '=G' '=g' Enter
  case_run "NORMAL: G" 30 Escape '=G' Enter
  case_run "NORMAL: stray keys are ignored" 3 Escape '=z' '=;' '=(' '=j' '=j' Enter
  case_run "NORMAL: i resumes typing" 3 Escape '=i' '=3' Enter
  case_run "NORMAL: / resumes typing" 3 Escape '=/' '=3' Enter
  case_run "NORMAL: q quits" "" Escape '=q'
  case_run "NORMAL: Esc quits" "" Escape Escape
  case_run "NORMAL: Cyrillic twins (о о, П)" 3 Escape '=о' '=о' Enter
  case_run "NORMAL: Cyrillic G twin" 30 Escape '=П' Enter
  prompt_case 7
  tmux -L "$sock" kill-server 2>/dev/null
  rm -f "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$sock"   # kill-server leaves the socket file behind
  name=${FUNCNAME[0]}
  ((fails == 0)) && { echo "$name: all cases passed"; return 0; }
  echo "$name: $fails case(s) failed"
  return 1
}

# ───────────────────────────── main ─────────────────────────────

case ${1:-} in
  --serve-request) serve_request "${2:?request dir}"; exit 0 ;;
  --server) server_main "${2:-a}" ;;
  --server-start) spawn_server; exit 0 ;;
  --spawn-standby) mkdir -p "$RUN"; sleep 0.25; standby_waiting || spawn_slot "${2:-b}"; exit 0 ;;
  --self-test) self_test; exit $? ;;
esac

parse_args "$@"
[[ ${FZF_MENU_HERE:-} == 1 ]] && HERE=1   # test hook: run in the current terminal (headless tmux drives)
if ((HERE)); then
  rows_in | run_list
  exit $?
fi
menu_gui
