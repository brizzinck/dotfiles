#!/usr/bin/env bash
# voicebox-tunnel - on-demand switch for the owner's user unit voicebox-tunnel.service (ssh -L 17493 to the bredllm
# Voicebox). The unit file lives in ~/.config/systemd/user/ and is deliberately NOT in this repo (LAN address and user
# name); it is disabled, so it only runs after `voicebox-tunnel on` (hub row "Voicebox tunnel", leader s v).
#
#   voicebox-tunnel on|start     start the tunnel now (not at login)
#   voicebox-tunnel off|stop     stop it
#   voicebox-tunnel toggle       flip it and show a notification (hub / leader)
#   voicebox-tunnel status       unit status; exit 0 only while the tunnel is active (hub row state)
#   voicebox-tunnel --help
# A stopped, disabled unit is inactive, so the waybar health badge (failed.sh) never counts it.
set -u

UNIT=voicebox-tunnel.service

sc() { systemctl --user "$@"; }
note() { notify-send -a voicebox -u "${3:-low}" -t 3500 -h string:x-dunst-stack-tag:voicebox "$1" "${2:-}" 2>/dev/null || true; }
exists() { [[ $(sc show -p LoadState --value -- "$UNIT" 2>/dev/null) == loaded ]]; }

exists || { echo "voicebox-tunnel: $UNIT is not installed (expected in ~/.config/systemd/user/)" >&2; note "Voicebox tunnel" "$UNIT is not installed" normal; exit 1; }

case ${1:-status} in
  on | start) sc start -- "$UNIT" && note "Voicebox tunnel" "started (localhost:17493)" ;;
  off | stop) sc stop -- "$UNIT" && note "Voicebox tunnel" "stopped" ;;
  toggle)
    if sc is-active --quiet -- "$UNIT"; then "$0" off; else "$0" on; fi ;;
  status)
    sc status --no-pager -l -- "$UNIT"
    sc is-active --quiet -- "$UNIT" ;;
  -h | --help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "usage: voicebox-tunnel on|off|toggle|status" >&2; exit 2 ;;
esac
