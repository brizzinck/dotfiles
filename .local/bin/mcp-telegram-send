#!/usr/bin/env python3
"""mcp-telegram-send - switch for agent-requested Telegram messages (gateway server `telegram-send`, broker `tgconfirm`).

  mcp-telegram-send on [--ttl MIN]   ask the broker to enable sending (default 60 minutes, at most 120): the broker shows its OWN
                                     popup "Allow AI agents to send Telegram messages?" and you press the key code there, so an
                                     agent cannot switch it on silently; then a notification and a timer that notifies when it expires
  mcp-telegram-send off              switch it off (no confirmation needed), notification
  mcp-telegram-send toggle           on <-> off
  mcp-telegram-send status           ON (minutes left) / OFF / not set up; exit 0 only when ON (used by the hub toggle row and waybar)

ON only lets the AI ASK: every single message still opens a popup with the recipient and the full text, and nothing leaves until
you press that popup's key code (Esc or 60 s = cancelled). Off by default; the broker switches it off by itself after the TTL.
State is read from /run/tgconfirm/state.json (no secret in it); changes go through the broker socket /run/tgconfirm/req.sock.
Test hooks: MCP_TGSEND_SOCK, MCP_TGSEND_STATE, MCP_TGSEND_NO_TIMER=1, MCP_TGSEND_NO_NOTIFY=1, MCP_TGSEND_NO_POKE=1.
"""
from __future__ import annotations

import json
import os
import shutil
import socket
import subprocess
import sys
import time

SOCK = os.environ.get("MCP_TGSEND_SOCK", "/run/tgconfirm/req.sock")
STATE = os.environ.get("MCP_TGSEND_STATE", "/run/tgconfirm/state.json")
SELF = os.path.realpath(__file__)
UNIT = "mcp-telegram-send-off"
WAIT = 125   # the broker bounds an enable request to 115 s (lock 10 + popup 65)


def notify(title: str, body: str, urgency: str = "normal") -> None:
    if os.environ.get("MCP_TGSEND_NO_NOTIFY") == "1" or not shutil.which("notify-send"):
        return
    subprocess.run(["notify-send", "-a", "mcp-telegram-send", "-u", urgency, title, body], stderr=subprocess.DEVNULL, check=False)


def poke_bar() -> None:
    if os.environ.get("MCP_TGSEND_NO_POKE") != "1":
        # the toggles summary is cached for both bars (waybar-cache/toggles.json); drop it so the poke shows the new state
        try:
            os.unlink(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "waybar-cache", "toggles.json"))
        except OSError:
            pass
        subprocess.run(["pkill", "-o", "-u", str(os.getuid()), "-RTMIN+8", "-x", "waybar"], stderr=subprocess.DEVNULL, check=False)


def ask(msg: dict, wait: float = WAIT) -> dict | None:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(wait)
    try:
        s.connect(SOCK)
        s.sendall(json.dumps(msg).encode() + b"\n")
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        out = json.loads(buf)
        return out if isinstance(out, dict) else None
    except (OSError, ValueError):
        return None
    finally:
        s.close()


def state() -> dict | None:
    """The broker's state.json, or None when the broker is not running."""
    try:
        with open(STATE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        return None
    return st if isinstance(st, dict) else None


def minutes_left(st: dict) -> int | None:
    if st.get("enabled") and float(st.get("until", 0)) > time.time():
        return max(1, int((float(st["until"]) - time.time() + 59) // 60))
    return None


def schedule_off(minutes: int) -> None:
    if os.environ.get("MCP_TGSEND_NO_TIMER") == "1" or not shutil.which("systemd-run"):
        return
    subprocess.run(["systemctl", "--user", "stop", f"{UNIT}.timer"], stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["systemd-run", "--user", "--quiet", "--collect", f"--unit={UNIT}", f"--on-active={minutes}m", SELF, "expired"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def cancel_timer() -> None:
    if os.environ.get("MCP_TGSEND_NO_TIMER") != "1":
        subprocess.run(["systemctl", "--user", "stop", f"{UNIT}.timer"], stderr=subprocess.DEVNULL, check=False)


def cmd_on(minutes: int) -> int:
    st = state()
    if st is None and not os.path.exists(SOCK):
        print("mcp-telegram-send: the confirmation broker is not running (owner: sudo apply-system.sh --only users,mcp, then mcp-telegram-setup send-chats)", file=sys.stderr)
        notify("Telegram sending is not set up", "Run mcp-telegram-setup send-chats (hub: Telegram: choose the chats the AI may write to).", "critical")
        return 1
    print("Asking the broker (it shows the confirmation popup; press its key code to allow sending, Esc cancels) ...", file=sys.stderr)
    out = ask({"op": "enable", "minutes": minutes})
    poke_bar()
    if out is None:
        print("mcp-telegram-send: no answer from the broker", file=sys.stderr)
        notify("Telegram sending", "The confirmation broker did not answer.", "critical")
        return 1
    status = out.get("status")
    if status == "enabled":
        left = (minutes_left(state() or {}) or minutes)
        schedule_off(left)
        notify("AI may now ask to send Telegram messages", f"ON for {left} min. Every message still needs your confirmation in a popup.")
        print(f"telegram-send: ON ({left} min, every message still needs the popup)")
        return 0
    why = out.get("reason") or {"cancelled": "you did not confirm", "timeout": "the popup timed out"}.get(status, status)
    notify("Telegram sending stays OFF", str(why), "low")
    print(f"telegram-send: still OFF ({why})")
    return 1


def cmd_off(quiet: bool = False) -> int:
    out = ask({"op": "disable"}, 10)
    cancel_timer()
    poke_bar()
    if out is None:
        print("mcp-telegram-send: the broker did not answer (it may not run; sending is off anyway)", file=sys.stderr)
        return 0 if state() is None else 1
    if not quiet:
        notify("Telegram sending is OFF", "AI agents can no longer ask to send messages.", "low")
        print("telegram-send: OFF")
    return 0


def cmd_expired() -> int:
    cmd_off(quiet=True)
    notify("Telegram sending switched off", "The time you allowed is over. Turn it on again in the hub if needed.", "low")
    return 0


def cmd_status() -> int:
    st = state()
    if st is None:
        print("not set up (the confirmation broker is not running)")
        return 1
    left = minutes_left(st)
    if left is not None:
        print(f"ON ({left} min left)")
        return 0
    print("OFF" if st.get("token") else "OFF (not set up: mcp-telegram-setup send-chats)")
    return 1


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print((__doc__ or "").strip())
        return 0 if argv else 2
    action, rest = argv[0], argv[1:]
    minutes = 60
    while rest:
        if rest[0] == "--ttl" and len(rest) > 1 and rest[1].isdigit() and 1 <= int(rest[1]) <= 9999:
            minutes, rest = int(rest[1]), rest[2:]
        else:
            print(f"mcp-telegram-send: unknown argument: {rest[0]}", file=sys.stderr)
            return 2
    if action == "on":
        return cmd_on(minutes)
    if action == "off":
        return cmd_off()
    if action == "toggle":
        return cmd_off() if minutes_left(state() or {}) is not None else cmd_on(minutes)
    if action == "status":
        return cmd_status()
    if action == "expired":
        return cmd_expired()
    print("usage: mcp-telegram-send on [--ttl MIN] | off | toggle | status", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
