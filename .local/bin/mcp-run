#!/usr/bin/env python3
"""mcp-run NAME - launch a user stdio MCP server with its secrets injected from Bitwarden (rbw).

  mcp-run NAME [-- EXTRA_ARGS...]   fetch the secrets, exec the server (stdio stays attached to the MCP client)
  mcp-run --list                    entries of ~/.config/mcp/stdio.json
  mcp-run --dry-run NAME            show command, env variable NAMES and where each secret would come from (no fetch)

Secrets: `rbw get --folder MCP --field FIELD ITEM` (the vault is unlocked once per login; a locked vault asks for the master
password through pinentry). Values go straight into the child's environment: never argv, never a file, never stdout/stderr.
Registry: ~/.config/mcp/stdio.json (no secrets, only references). Test hooks: MCP_CONFIG_DIR, MCP_RBW (rbw binary).
"""

import json
import os
import subprocess
import sys
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("MCP_CONFIG_DIR") or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "mcp")
RBW = os.environ.get("MCP_RBW", "rbw")
DEFAULT_FOLDER = "MCP"


def die(msg: str, code: int = 1) -> "None":
    print(f"mcp-run: {msg}", file=sys.stderr)
    sys.exit(code)


def load() -> dict:
    try:
        data = json.loads((CONFIG_DIR / "stdio.json").read_text())
    except (OSError, json.JSONDecodeError) as e:
        die(f"cannot read {CONFIG_DIR / 'stdio.json'}: {e}")
    servers = data.get("servers")
    if not isinstance(servers, dict):
        die("stdio.json has no `servers` object")
    return servers


def fetch(var: str, ref: dict, name: str) -> str:
    item = ref.get("item") or name
    field = ref.get("field")
    folder = ref.get("folder") or DEFAULT_FOLDER
    if not field:
        die(f"{name}: secret {var} has no `field`")
    argv = [RBW, "get", "--folder", folder, "--field", field, item]
    try:
        cp = subprocess.run(argv, capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        die("rbw is not installed")
    except subprocess.TimeoutExpired:
        die("rbw did not answer (is the vault locked? run: rbw unlock)")
    value = cp.stdout.rstrip("\n")
    if cp.returncode != 0 or not value:
        # rbw's stderr never contains the secret; show the first line so a missing item or a locked vault is clear
        first = (cp.stderr.strip().splitlines() or ["no output"])[0]
        die(f"{name}: cannot read {folder}/{item} field {field} for {var}: {first}")
    return value


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print((__doc__ or "").strip())
        sys.exit(0 if argv else 2)
    servers = load()
    if argv[0] == "--list":
        for n, s in sorted(servers.items()):
            print(f"{n}\t{s.get('command', '')} {' '.join(s.get('args', []))}\tsecrets: {','.join(s.get('secrets', {})) or '-'}")
        return
    dry = argv[0] == "--dry-run"
    if dry:
        argv = argv[1:]
    if not argv:
        die("missing server name", 2)
    name, rest = argv[0], argv[1:]
    if rest[:1] == ["--"]:
        rest = rest[1:]
    spec = servers.get(name)
    if not spec or not spec.get("command"):
        die(f"unknown server: {name} (known: {', '.join(sorted(servers)) or 'none'})")
    cmd = [os.path.expandvars(spec["command"]), *[os.path.expandvars(a) for a in spec.get("args", [])], *rest]
    env = dict(os.environ)
    env.update({k: str(v) for k, v in (spec.get("env") or {}).items()})
    secrets = spec.get("secrets") or {}
    if dry:
        print("command:", " ".join(cmd))
        print("env:", ", ".join(sorted(spec.get("env") or {})) or "-")
        for var, ref in secrets.items():
            print(f"secret: {var} <- {ref.get('folder') or DEFAULT_FOLDER}/{ref.get('item') or name} field {ref.get('field')}")
        return
    for var, ref in secrets.items():
        env[var] = fetch(var, ref, name)
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as e:
        die(f"cannot start {cmd[0]}: {e}")


if __name__ == "__main__":
    main(sys.argv[1:])
