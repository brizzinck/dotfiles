            '.sh', '.sql', '.html', '.css', '.c', '.h', '.cpp', '.java', '.kt', '.swift', '.rb', '.php', '.lua'}
IMAGE_EXT = {'.jpg', '.jpeg', '.png', '.webp', '.bmp', '.tif', '.tiff'}
MAX_CANDIDATES = 80
