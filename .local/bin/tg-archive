RATE_GUESS = 5e6         # bytes/s for the time estimate before a rate is measured: Telegram's cap for one account
BACKOFF = float(os.environ.get('TG_ARCHIVE_BACKOFF') or 5)   # first pause after no progress, doubling up to 60 s
