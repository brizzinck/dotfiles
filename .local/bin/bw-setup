#!/usr/bin/env bash
# bw-setup: one-time setup of the Bitwarden / Vaultwarden clients (rbw, then the official CLI bw).
# Asks for the server URL and your e-mail (neither is stored in the dotfiles repo: rbw keeps them in
# ~/.config/rbw/config.json, which is not under stow), configures rbw, logs in, syncs and shows a test list.
# Then, when `bw` is installed and not logged in yet, it points bw at the same server and runs `bw login`
# (interactive: master password and 2FA are asked by bw itself; nothing is echoed). Safe to run again: an
# existing bw login is detected (bw status) and left alone.
#
#   bw-setup [--url URL] [--email MAIL]
#
# Lock policy: for the owner lock_timeout is one year, so the master password is asked once per login session. Hyprland
# runs `vault.sh session-start` (rbw stop-agent) at every session start, which locks the vault again for the new login.
# A managed user (the checkout belongs to someone else, e.g. td, yc via /srv/dotfiles) gets one hour.
set -euo pipefail

url=${BW_URL:-} email=${BW_EMAIL:-}
while (($#)); do
  case $1 in
    --url) url=${2:?--url needs a value}; shift 2 ;;
    --email) email=${2:?--email needs a value}; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done

# BW-ORG: a managed user (td, yc) has no vault of its own: the owner's broker serves its scope (vault-share), so nothing here may
# configure rbw or log bw in. BW_SETUP_AS_USER (test hook) can only make the run count as managed, never as the owner.
managed_lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../infrastructure/users/lib.sh"
if [[ -r $managed_lib ]]; then
  # shellcheck source=../../infrastructure/users/lib.sh
  . "$managed_lib"
  managed_list=$(managed_users interactive)       # not `managed_users | grep -q`: the early exit of grep + pipefail would be 141
  for who in "$(id -un)" "${BW_SETUP_AS_USER:-}"; do
    if [[ -n $who ]] && grep -qx -- "$who" <<<"$managed_list"; then
      echo "$who gets vault values through vault-share (the owner's broker); no rbw or bw of its own." >&2
      echo "\`vault-share status\` shows your scope; secrets for commands: envs run." >&2
      exit 4
    fi
  done
fi

command -v rbw >/dev/null || { echo "rbw is not installed. Run: sudo ~/dotfiles/apply-system.sh --only install" >&2; exit 1; }

self_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# Always keep the marker-aware wrapper, including on a tty: it chooses curses itself and suppresses broker prompts.
pinentry="$self_dir/pinentry-themed"
[[ -x $pinentry ]] && grep -q 'vault-share:no-prompt' "$pinentry" || {
  echo "The supported pinentry-themed wrapper is missing; update/stow the dotfiles first." >&2
  exit 1
}
# vault-bw.py lives next to this script's repo (the owner's ~/dotfiles, /srv/dotfiles for managed users: the cli profile links
# envs, bw-setup and fzf-menu, not .config/hypr)
vbw_py="$self_dir/../../.config/hypr/scripts/vault-bw.py"
[[ -f $vbw_py ]] || vbw_py="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/vault-bw.py"

cur_url=$(rbw config show 2>/dev/null | jq -r '.base_url // empty' 2>/dev/null || true)
cur_email=$(rbw config show 2>/dev/null | jq -r '.email // empty' 2>/dev/null || true)

if [[ -z $url ]]; then
  read -r -p "Vaultwarden URL, e.g. https://vault.example.com${cur_url:+ [$cur_url]}: " url
  url=${url:-$cur_url}
fi
if [[ -z $email ]]; then
  read -r -p "Account e-mail${cur_email:+ [$cur_email]}: " email
  email=${email:-$cur_email}
fi
[[ $url =~ ^https?://[^[:space:]]+$ ]] || { echo "the URL must start with https:// (or http:// for a LAN test server)" >&2; exit 1; }
[[ $email == *@* ]] || { echo "that does not look like an e-mail address" >&2; exit 1; }
url=${url%/}

rbw stop-agent >/dev/null 2>&1 || true
rbw config set base_url "$url"
rbw config set email "$email"
# The owner (the user whose account owns this checkout) unlocks once per login. A managed user (td, yc ...) holds the owner's
# whole vault while unlocked and runs agents: one hour, then the master password again.
# BW_SETUP_FAKE_OWNER (test hook, any value) can only make this run count as a managed user: it never gives the long timeout
repo_owner=$(stat -c %U "$self_dir/../.." 2>/dev/null || true)
if [[ -z ${BW_SETUP_FAKE_OWNER:-} && ( -z $repo_owner || $repo_owner == "$(id -un)" ) ]]; then lock_timeout=31536000; else lock_timeout=3600; fi
rbw config set lock_timeout "$lock_timeout"
rbw config set pinentry "$pinentry"
[[ $(rbw config show | jq -r '.pinentry // empty') == "$pinentry" ]] || {
  echo "rbw did not keep the supported pinentry wrapper." >&2
  exit 1
}
echo "rbw configured (pinentry: $pinentry)."

echo "Logging in: pinentry asks for the master password."
if ! rbw login; then
  cat <<'MSG'

Login failed. On a self-hosted Vaultwarden this is usually a wrong password or a wrong URL.
The official bitwarden.com server needs the device registered with your personal API key first:
  rbw register
Then run bw-setup again.
MSG
  exit 1
fi
rbw sync
echo
echo "Synced. First entries (names only):"
rbw list | head
setup_bw() {
  local st ans key rundir
  command -v bw >/dev/null 2>&1 || { echo "bw (bitwarden-cli) is not installed: skipping the official CLI."; return 0; }
  st=$(BW_NOINTERACTION=true NODE_NO_WARNINGS=1 bw status 2>/dev/null | jq -r '.status // empty' 2>/dev/null || true)
  case $st in
    unauthenticated) ;;
    locked | unlocked) echo "bw is already logged in (status: $st): skipping the official CLI setup."; return 0 ;;
    *) echo "bw status gave no answer: skipping the official CLI setup."; return 0 ;;
  esac
  read -r -p "Also set up the official Bitwarden CLI (bw) for the hub actions? [Y/n] " ans
  [[ ${ans:-y} =~ ^[Yy] ]] || return 0
  NODE_NO_WARNINGS=1 bw config server "$url" >/dev/null
  echo "bw login: bw asks for the master password (and the 2FA code) itself."
  if ! key=$(NODE_NO_WARNINGS=1 bw login "$email" --raw); then
    echo "bw login failed; run bw-setup again to retry."
    return 1
  fi
  # the login leaves a session: keep it on tmpfs (mode 600) like vault.sh does, so no second prompt is needed today
  rundir="${XDG_RUNTIME_DIR:-/tmp}/vault"
  ( umask 077; mkdir -p "$rundir"; printf '%s' "$key" >"$rundir/bw-session.tmp" && mv -f "$rundir/bw-session.tmp" "$rundir/bw-session" )
  key=
  # a per-session bw server of an earlier login holds the old key: stop it, the next bw action starts one with the new key
  python3 -I "$vbw_py" serve-stop >/dev/null 2>&1 || true
  # the sync goes through vault-bw.py like every other bw call: the process that holds the session key runs non-dumpable
  if python3 -I -B "$vbw_py" sync >/dev/null 2>&1; then echo "bw synced."; else echo "bw sync failed (python3 ~/dotfiles/.config/hypr/scripts/vault-bw.py sync); run it again later, the hub actions need a synced vault."; fi
}
echo
setup_bw || true
echo
echo "Done. SUPER+CTRL+P opens the passwords, SUPER+CTRL+O the 2FA codes. The master password is asked once per login."
echo "Migrating from Google Authenticator: 2fa-import (also in the hub, SUPER+M)."
echo "New login, Send, attachments, generator, delete: hub (SUPER+M), group Vault."
