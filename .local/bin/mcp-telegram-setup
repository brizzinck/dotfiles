#!/usr/bin/env python3
"""mcp-telegram-setup - one-time setup (and later upkeep) of the Telegram MCP service (read tools; owner-confirmed sending). Run it in a terminal.

  mcp-telegram-setup              first setup: log in by QR (or reuse the session stored in Bitwarden), tick the chats the AI
                                  may read, store everything, start the service, check it through the gateway
  mcp-telegram-setup chats        change the allowlist (extend or shrink it): a checkbox list, `[x]` = the AI may read it
  mcp-telegram-setup send-chats [--account NAME]
                                  choose the chats the AI may ASK to write to (a subset of the readable chats; same checkbox
                                  list). Sending stays off until you switch it on (hub: Telegram: allow sending) and
                                  every message needs your confirmation in a popup. Run it once to set sending up at all.
  mcp-telegram-setup status       service, gateway and credential state
  mcp-telegram-setup --new-login  ignore the stored session and log in by QR again (a terminated or lost session)
  mcp-telegram-setup --resume     finish a setup whose fresh session could not be written to Bitwarden (see below)

What you do: scan a QR code with your phone, tick chats, confirm the summary, type the sudo password (and the Bitwarden master
password when the vault is locked). Nothing else.

The chat picker is a real checkbox list (`[x]` ticked, `[ ]` not; Saved Messages first, then Telegram's order): Tab, Shift+Tab or
Space (NORMAL mode) toggles the chat under the cursor and moves down, a `+` / `-` after the box marks what you changed, the header
counts `Selected N (+added / -removed)`, Enter saves, Esc cancels. Afterwards the summary lists `Adding (n)` / `Removing (n)` with
titles, kinds and ids and asks `Save these chats? [Y/n]`. Unchanged work is skipped: no change = `No change.` (no Bitwarden write,
no sudo, no restart); only the fields that changed go to Bitwarden and to the root helper (the allowlist, plus api_id / api_hash /
session / token on a fresh login, a first seal or a new token file); the gateway restart and the service check only follow a seal;
mcp-add only runs when the served servers changed or after a fresh login. Every phase prints its time and the run ends with
`Total N s (without your input)`.

Where things go:
  * Bitwarden folder MCP, item telegram-mcp (master copy): fields api_id and api_hash (you made them), `session` (hidden, written
    here with `bw edit`, never typed) and `allowlist` (text, chat ids).
  * /etc/credstore.encrypted/telegram-mcp.* : the same values as systemd credentials sealed to the TPM2 + host key, written by
    the root helper /usr/local/lib/telegram-mcp/creds-install through `sudo` (password required; it receives the values on
    stdin). telegram-mcp.service (user aimcp, 127.0.0.1:8765) loads them with LoadCredentialEncrypted=: no plaintext session
    file anywhere. The MCP tools are read-only (no send, edit, delete, mark-read) and the service fails closed without an allowlist; sending
    exists only as the separate owner-confirmed route (see send-chats).
  * ~/.local/state/mcp/telegram.token (0600): bearer token between the gateway and the service, also stored in the credstore.
A fresh QR login is never lost: the full Bitwarden item is read BEFORE the QR is shown (a broken bw stops you before you scan),
rbw is synced before its copy is read, a failed write to Bitwarden is retried once, and when it still fails the new session is
kept in a 0600 file under $XDG_RUNTIME_DIR/mcp-telegram-setup/ (tmpfs: it survives the terminal, not a reboot) and the command
tells you to run `mcp-telegram-setup --resume` after fixing bw (unlock, network). Until then a new setup refuses to start.
Sending (M1-send): `send-chats` starts from the SEALED send list (read by the root helper), shows the final list with title, kind
and id, asks for an explicit confirmation, then seals it for the send route inside telegram-mcp and records it in the text field
`send_allowlist` of the same Bitwarden item (chat ids, not secret; a record only, never trusted as input). `chats` never sends a
send list: the root helper narrows the sealed one to the new read list by itself; the root helper generates the send token ITSELF (--ensure-send-token) and seals it for
telegram-mcp and for the tgconfirm broker only: it is never in Bitwarden, a file you can read or this script. The AI sends only
after you confirm each message in a popup. Kill switch: Telegram > Settings > Devices > terminate
"telegram-mcp (AI, read-only)".
Test hooks: MCP_TG_PYTHON, MCP_TG_LOGIN, MCP_TG_CREDS, MCP_TG_SUDO, MCP_TG_PICK (a command that gets the rows on stdin and edits
$MCP_TG_PICK_DIR/sel; exit 0 = save), MCP_GATEWAY_CMD, MCP_ADD_CMD, MCP_STATE_DIR,
MCP_TG_NO_VERIFY=1, MCP_TG_RETRY_DELAY (seconds between the two write attempts), VAULT_BW (path of vault-bw.py), BW_BIN.
"""
from __future__ import annotations

import base64
import contextlib
import importlib.util
import json
import os
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
BIN_DIR = Path(os.path.abspath(__file__)).parent
TG_PYTHON = os.environ.get("MCP_TG_PYTHON", "/opt/telegram-mcp/venv/bin/python")
TG_LOGIN = os.environ.get("MCP_TG_LOGIN", "/usr/local/lib/telegram-mcp/login.py")
TG_CREDS = os.environ.get("MCP_TG_CREDS", "/usr/local/lib/telegram-mcp/creds-install")
SUDO = os.environ.get("MCP_TG_SUDO", "sudo")
GATEWAY = os.environ.get("MCP_GATEWAY_CMD", str(BIN_DIR / "mcp-gateway"))
MCP_ADD = os.environ.get("MCP_ADD_CMD", str(BIN_DIR / "mcp-add"))
STATE_DIR = Path(os.environ.get("MCP_STATE_DIR") or Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "mcp")
TOKEN_FILE = STATE_DIR / "telegram.token"
APPLIED = STATE_DIR / "telegram.applied"   # the allowlist the root helper last sealed (ids only, not secret): "No change." needs it
VAULT_BW = Path(os.environ.get("VAULT_BW") or HOME / ".config/hypr/scripts/vault-bw.py")
FOLDER, ITEM = "MCP", "telegram-mcp"
RECOVERY = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "mcp-telegram-setup" / "recovery.json"


class BwWriteError(Exception):
    pass


def eprint(*a: object) -> None:
    print(*a, file=sys.stderr, flush=True)


PHASES: list[tuple[str, float]] = []


@contextlib.contextmanager
def phase(name: str, timed: bool = True):
    """Prints `  NAME ... 1.84 s` when the block ends. timed=False is for steps that wait for the owner (the picker, a QR scan):
    they are shown without a time and are not part of the total."""
    t0 = time.monotonic()
    try:
        yield
    finally:
        dt = time.monotonic() - t0
        if timed:
            PHASES.append((name, dt))
            eprint(f"  {name} ... {dt:.2f} s")
        else:
            eprint(f"  {name} ... (your input)")


def print_total() -> None:
    if PHASES:
        eprint(f"Total {sum(t for _n, t in PHASES):.1f} s (without your input)")


def die(msg: str, code: int = 1) -> None:
    eprint(f"mcp-telegram-setup: {msg}")
    sys.exit(code)


# --- Bitwarden through vault-bw.py (the same bw session, pinentry unlock and helpers as the vault browser) -----------------
def load_vault_bw():
    if not VAULT_BW.exists():
        die(f"{VAULT_BW} is missing (stow the dotfiles)")
    spec = importlib.util.spec_from_file_location("vault_bw", VAULT_BW)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def rbw_record(m) -> dict | None:
    """The item through rbw (milliseconds, no bw process, no bw unlock): `rbw get --raw --folder MCP telegram-mcp`. None when rbw
    cannot give a complete record (not set up, locked and cancelled, item or custom fields missing): bw then answers."""
    if not m.rbw_ready():
        return None
    # rbw reads its local copy: sync first, or an allowlist / session written from another device (or by the last run) is stale
    subprocess.run([m.RBW, "sync"], capture_output=True)
    p = subprocess.run([m.RBW, "get", "--raw", "--folder", FOLDER, ITEM], capture_output=True, text=True)
    if p.returncode != 0:
        return None
    try:
        rec = json.loads(p.stdout)
    except ValueError:
        return None
    if not rec.get("id") or not field(rec, "api_id") or not field(rec, "api_hash"):
        return None
    rec["_src"] = "rbw"   # with_full_item / set_fields read the full bw item before any edit (rbw cannot write custom fields)
    return rec


def find_item(m) -> dict:
    rec = rbw_record(m)
    if rec is not None:
        return rec
    fid = m.folder_id(FOLDER, create=False)
    if not fid:
        die(f"Bitwarden has no folder {FOLDER}. Create the login item {ITEM} in it with the custom fields api_id and api_hash "
            "(from https://my.telegram.org/apps), then run this again.")
    items = [i for i in m.bw_json("list", "items", "--folderid", fid, "--search", ITEM) if i.get("name") == ITEM]
    if not items:
        die(f"Bitwarden folder {FOLDER} has no item named {ITEM} (needs the custom fields api_id and api_hash).")
    return m.bw_json("get", "item", items[0]["id"])


def field(item: dict, name: str) -> str:
    for f in item.get("fields") or []:
        if f.get("name") == name and f.get("value"):
            return str(f["value"]).strip()   # text and hidden fields alike
    return ""


def with_full_item(m, item: dict) -> dict:
    """rbw cannot write custom fields, so every write needs bw's full item. Read it NOW, before the QR login: a bw that cannot
    answer must stop the setup before the owner scans anything, not after the one-time session exists."""
    if item.get("_src") != "rbw":
        return item
    p = m.bw("get", "item", item["id"])
    try:
        item["_bw"] = json.loads(p.stdout) if p.returncode == 0 else None
    except ValueError:
        item["_bw"] = None
    if not item["_bw"]:
        die(f"bw cannot read the Bitwarden item ({m.first_line(p.stderr or p.stdout)}): fix that first (unlock, network), "
            "nothing was changed and no QR was shown")
    return item


def set_fields(m, item: dict, values: dict[str, tuple[str, int]]) -> None:
    """Set custom fields (name -> (value, type)); type 0 = text, 1 = hidden. Written with `bw edit item` (stdin). Raises
    BwWriteError when bw cannot do it. The base is a fresh `bw get item` (the QR step can take minutes), else the copy read before."""
    target = item
    if item.get("_src") == "rbw":
        p = m.bw("get", "item", item["id"])
        try:
            target = json.loads(p.stdout) if p.returncode == 0 else None
        except ValueError:
            target = None
        target = target or item.get("_bw")
        if not target:
            raise BwWriteError("bw cannot read the item")
    fields = [f for f in target.get("fields") or [] if f.get("name") not in values]
    for name, (value, ftype) in values.items():
        fields.append({"name": name, "value": value, "type": ftype})
    target = dict(target, fields=fields)
    p = m.bw("edit", "item", item["id"], stdin=base64.b64encode(json.dumps(target).encode()).decode())
    if p.returncode != 0:
        raise BwWriteError(m.first_line(p.stderr or p.stdout))
    item["fields"] = fields
    m.refresh_rbw()


def store_fields(m, item: dict, values: dict[str, tuple[str, int]], recovery: dict | None = None) -> None:
    """set_fields with one retry. When it still fails: with `recovery` (a fresh session that exists nowhere else) the values are
    written to the 0600 recovery file and the owner is told how to finish; without it the run just stops."""
    err = ""
    for attempt in (1, 2):
        try:
            set_fields(m, item, values)
            return
        except BwWriteError as e:
            err = str(e)
            if attempt == 1:
                eprint(f"Bitwarden write failed ({err}); trying once more ...")
                time.sleep(float(os.environ.get("MCP_TG_RETRY_DELAY", "2")))
    if recovery is None:
        die(f"could not update the Bitwarden item: {err}")
    save_recovery(recovery)
    die("could not write the new session to Bitwarden "
        f"({err}).\nIt is NOT lost: it is kept in {RECOVERY} (mode 600, tmpfs: gone at reboot).\n"
        "Fix bw (unlock the vault, check the network), then run:  mcp-telegram-setup --resume")


def save_recovery(rec: dict) -> None:
    RECOVERY.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(RECOVERY.parent, 0o700)
    tmp = RECOVERY.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(rec, f)
    os.replace(tmp, RECOVERY)


def load_recovery() -> dict | None:
    try:
        rec = json.loads(RECOVERY.read_text())
    except (OSError, ValueError):
        return None
    return rec if isinstance(rec, dict) and rec.get("session") else None


# --- Telegram (login.py in the pinned venv) ------------------------------------------------------------------------------------
def run_login(mode: str, api_id: str, api_hash: str, session: str = "") -> dict | None:
    env = dict(os.environ, TELEGRAM_API_ID=api_id, TELEGRAM_API_HASH=api_hash)
    env.pop("TELEGRAM_SESSION_STRING", None)
    if session:
        env["TELEGRAM_SESSION_STRING"] = session
    p = subprocess.run([TG_PYTHON, TG_LOGIN, mode], env=env, stdout=subprocess.PIPE, text=True)   # stderr: QR + prompts stay on the terminal
    if p.returncode == 3:
        return None
    if p.returncode != 0:
        die(f"Telegram login/listing failed (exit {p.returncode})")
    try:
        return json.loads(p.stdout)
    except ValueError:
        die("the Telegram helper returned something that is not JSON")


# --- the chat picker: a checkbox list --------------------------------------------------------------------------------------
# State lives in a 0700 work directory (tmpfs): chats.json (ordered list), orig (ids ticked at the start), sel (ids ticked now,
# one per line), rows (what fzf shows). fzf toggles through `mcp-telegram-setup _pick tab DIR ID`, which rewrites sel and rows and
# answers with a reload-sync + down + change-header action (no --multi, no --track: with reload-sync --track drops typed characters).
def order_chats(chats: list[dict], me_id: int | None) -> list[dict]:
    """Saved Messages (the chat with yourself) first, then Telegram's order."""
    me = [dict(c, title="Saved Messages") for c in chats if me_id is not None and c["id"] == me_id]
    return me + [c for c in chats if me_id is None or c["id"] != me_id]


def read_ids(path: Path) -> set[int]:
    try:
        return {int(x) for x in path.read_text().split() if x.lstrip("-").isdigit()}
    except OSError:
        return set()


def render_rows(chats: list[dict], sel: set[int], orig: set[int]) -> str:
    """`id TAB [x]+ kind title (N unread)`: green [x] / grey [ ], then + (newly ticked) or - (unticked) or a space"""
    lines = []
    for c in chats:
        on, was = c["id"] in sel, c["id"] in orig
        box = "\033[32m[x]\033[0m" if on else "\033[90m[ ]\033[0m"
        mark = "\033[32m+\033[0m" if on and not was else "\033[31m-\033[0m" if was and not on else " "
        unread = f"({c['unread']} unread)" if c.get("unread") else ""
        lines.append(f"{c['id']}\t{box}{mark} {c['kind']:7} {c['title']} {unread}".rstrip())
    return "\n".join(lines) + "\n"


def picker_header(sel: set[int], orig: set[int]) -> str:
    return f"Selected {len(sel)} (+{len(sel - orig)} / -{len(orig - sel)}) · Tab / Space: toggle · Enter: save · Esc: cancel"


def pick_write(d: Path, chats: list[dict], sel: set[int], orig: set[int]) -> None:
    (d / "sel").write_text("".join(f"{i}\n" for i in sorted(sel)))
    (d / "rows").write_text(render_rows(chats, sel, orig))


def pick_cmd(argv: list[str]) -> int:
    """Hidden `_pick rows|header|tab DIR [ID]`: one python start per key press."""
    if len(argv) < 2:
        return 2
    cmd, d = argv[0], Path(argv[1])
    chats = json.loads((d / "chats.json").read_text())
    orig, sel = read_ids(d / "orig"), read_ids(d / "sel")
    if cmd == "rows":
        sys.stdout.write(render_rows(chats, sel, orig))
    elif cmd == "header":
        print(picker_header(sel, orig))
    elif cmd == "tab":
        cid = argv[2] if len(argv) > 2 else ""
        if cid.lstrip("-").isdigit() and int(cid) in {c["id"] for c in chats}:
            sel = sel ^ {int(cid)}
            pick_write(d, chats, sel, orig)
        print(f"reload-sync(cat {shlex.quote(str(d / 'rows'))})+down+change-header:{picker_header(sel, orig)}")
    else:
        return 2
    return 0


def run_picker(d: Path, prompt: str) -> int:
    """Show the prepared state in fzf-menu (or plain fzf); the exit status is 0 when the owner pressed Enter."""
    orig, sel = read_ids(d / "orig"), read_ids(d / "sel")
    rows = (d / "rows").read_text()
    env = dict(os.environ, MCP_TG_PICK_DIR=str(d))
    hook = os.environ.get("MCP_TG_PICK")
    if hook:
        return subprocess.run([hook], input=rows, text=True, env=env).returncode
    me, qd = shlex.quote(os.path.abspath(__file__)), shlex.quote(str(d))
    tab = f"transform({me} _pick tab {qd} {{1}})"
    header = picker_header(sel, orig)
    if shutil.which("fzf-menu"):
        env["FZF_MENU_NORMAL_BINDS"] = f"space:{tab}"     # NORMAL mode (Esc): Space toggles like Tab
        argv = ["fzf-menu", "--here", "-p", f"Telegram: {prompt}", "--delimiter", "\t", "--with-nth", "2..", "--ansi",
                "--header", header, "--bind", f"tab:{tab}", "--bind", f"btab:{tab}"]
    else:
        argv = ["fzf", "--ansi", "--prompt", "Telegram > ", "--delimiter", "\t", "--with-nth", "2..", "--header", header,
                "--layout=reverse", "--bind", f"tab:{tab}", "--bind", f"btab:{tab}"]
    return subprocess.run(argv, input=rows, stdout=subprocess.DEVNULL, text=True, env=env).returncode


def pick_chats(chats: list[dict], selected: set[int], me_id: int | None, prompt: str) -> set[int] | None:
    """The chats ticked at the end (None = cancelled). `selected` starts ticked."""
    ordered = order_chats(chats, me_id)
    d = Path(tempfile.mkdtemp(prefix="mcp-tg-pick.", dir=os.environ.get("XDG_RUNTIME_DIR") or "/tmp"))   # mkdtemp: mode 0700
    try:
        (d / "chats.json").write_text(json.dumps(ordered))
        (d / "orig").write_text("".join(f"{i}\n" for i in sorted(selected)))
        pick_write(d, ordered, set(selected), set(selected))
        with phase("your choice", timed=False):
            rc = run_picker(d, prompt)
        return read_ids(d / "sel") if rc == 0 else None
    finally:
        shutil.rmtree(d, ignore_errors=True)


def pick_demo(d: Path) -> int:
    """Hidden `_pick-demo DIR`: the real picker on a prepared DIR (chats.json, orig), for the UI test."""
    chats = json.loads((d / "chats.json").read_text())
    orig = read_ids(d / "orig")
    if not (d / "sel").exists():
        pick_write(d, chats, set(orig), orig)
    return run_picker(d, "demo")


def print_summary(final: set[int], orig: set[int], names: dict[int, dict]) -> None:
    """What will change, with titles, kinds and ids (a title alone can be spoofed by a look-alike), then the full final list."""
    added, removed = sorted(final - orig), sorted(orig - final)
    if added:
        eprint(f"\nAdding ({len(added)}):\n" + "\n".join(describe_chats(added, names)))
    if removed:
        eprint(f"\nRemoving ({len(removed)}):\n" + "\n".join(describe_chats(removed, names)))
    eprint(f"\nFinal list ({len(final)}):\n" + "\n".join(describe_chats(sorted(final), names)))


# --- gateway / root helper ---------------------------------------------------------------------------------------------------
def ensure_token() -> tuple[str, bool]:
    """(token, created): created is True when this call had to make the token file (then the root helper needs the new token)"""
    if TOKEN_FILE.exists() and TOKEN_FILE.read_text().strip():
        return TOKEN_FILE.read_text().strip(), False
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    tok = secrets.token_urlsafe(32)
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(tok)
    return tok, True


def applied_allowlist() -> str | None:
    """The allowlist the root helper sealed last time (None: never by this version or the seal failed: seal everything once)."""
    try:
        return APPLIED.read_text().strip()
    except OSError:
        return None


def mark_applied(value: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(APPLIED, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value)


def ensure_sudo(why: str) -> None:
    if not Path(TG_CREDS).exists():
        die(f"{TG_CREDS} is missing: run  sudo ~/dotfiles/apply-system.sh --only users,mcp  first")
    eprint(f"\nsudo is needed {why} (the password is asked by sudo, not by this script).")
    if SUDO == "sudo" and subprocess.run(["sudo", "-v"]).returncode != 0:
        die("sudo authentication failed")


def sealed_send_allowlist() -> set[int]:
    """The SEALED send allowlist, read by the root helper (the only authoritative copy; Bitwarden's is a record an agent could edit)."""
    p = subprocess.run([SUDO, TG_CREDS, "--print-send-allowlist"], capture_output=True, text=True)
    if p.returncode != 0:
        die("could not read the sealed send list from the root helper (sudo failed or creds-install is out of date: "
            "sudo ~/dotfiles/apply-system.sh --only mcp)")
    return parse_ids(p.stdout.strip())


def confirm(question: str, default: bool = False) -> bool:
    """[y/N] by default, [Y/n] with default=True (an empty line is the default; no input at all, EOF, is always no)"""
    eprint(f"{question} [{'Y/n' if default else 'y/N'}] ")
    try:
        ans = input().strip().lower()
    except EOFError:
        return False
    return default if not ans else ans in ("y", "yes")


def sudo_apply(payload: dict[str, str], args: tuple[str, ...] = ()) -> None:
    ensure_sudo("once to seal the credentials with the TPM2")     # the password is yours: not part of the timed phase
    with phase("seal (sudo)"):
        p = subprocess.run([SUDO, TG_CREDS, *args], input=json.dumps(payload), text=True)
    if p.returncode != 0:
        die("the root helper failed (nothing was started); fix the error above and run this again, the session is safe in Bitwarden")


def gateway(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run([GATEWAY, *args], capture_output=True, text=True)


def mcp_post(url: str, token: str, body: dict, session: str = "") -> tuple[dict | None, str]:
    headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    if session:
        headers["mcp-session-id"] = session
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers, method="POST")
    with urllib.request.urlopen(req, timeout=20) as r:
        text = r.read().decode()
        sid = r.headers.get("mcp-session-id", session)
    for line in text.splitlines():
        if line.startswith("data:"):
            text = line[5:].strip()
            break
    try:
        return (json.loads(text) if text.strip() else None), sid
    except ValueError:
        return None, sid


def gateway_tool_count(token: str) -> int:
    url = gateway("url", "telegram").stdout.strip()
    if not url:
        return 0
    init = {"jsonrpc": "2.0", "id": 1, "method": "initialize",
            "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "mcp-telegram-setup", "version": "1"}}}
    _, sid = mcp_post(url, token, init)
    mcp_post(url, token, {"jsonrpc": "2.0", "method": "notifications/initialized"}, sid)
    res, _ = mcp_post(url, token, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"}, sid)
    return len(((res or {}).get("result") or {}).get("tools") or [])


def verify() -> None:
    if os.environ.get("MCP_TG_NO_VERIFY") == "1":
        return
    gtoken = gateway("headers")
    try:
        token = json.loads(gtoken.stdout)["Authorization"].removeprefix("Bearer ")
    except (ValueError, KeyError):
        eprint("could not read the gateway token; skipped the final check")
        return
    eprint("Waiting for the service to log in to Telegram ...")
    with phase("service check"):
        for _ in range(30):
            try:
                n = gateway_tool_count(token)
                if n:
                    eprint(f"OK: the gateway serves {n} read-only Telegram tools.")
                    return
            except (urllib.error.URLError, OSError, ValueError):
                pass
            time.sleep(2)
    eprint("The service did not answer in time. Look at: systemctl status telegram-mcp; journalctl -u telegram-mcp -n 40")


# --- commands ------------------------------------------------------------------------------------------------------------------
def read_item(m) -> dict:
    """Unlock (pinentry: your input, not timed), then read the full Bitwarden item BEFORE any QR: a broken bw must stop us while
    nothing exists yet."""
    m.ensure()
    with phase("Bitwarden read"):
        return with_full_item(m, find_item(m))


def keep_fresh_session(m, item: dict, session: str, allowlist: str, why: str) -> None:
    """A QR login happened and the run stops before sealing: the new session must not vanish."""
    store_fields(m, item, {"session": (session, 1)}, recovery={"session": session, "allowlist": allowlist})
    die(f"{why} The new session is stored in Bitwarden: run  mcp-telegram-setup chats  to choose the chats (nothing was sealed or started)")


def cmd_setup(chats_only: bool, new_login: bool) -> None:
    for what, path in (("the venv", TG_PYTHON), ("login.py", TG_LOGIN)):
        if not Path(path).exists():
            die(f"{what} is missing ({path}): run  sudo ~/dotfiles/apply-system.sh --only users,mcp  first")
    if load_recovery() is not None:
        die(f"an earlier login is waiting in {RECOVERY} (its session could not be written to Bitwarden): run  "
            "mcp-telegram-setup --resume  first (or delete that file to throw it away)")
    m = load_vault_bw()
    item = read_item(m)
    api_id, api_hash = field(item, "api_id"), field(item, "api_hash")
    if not api_id or not api_hash:
        die(f"the Bitwarden item {FOLDER}/{ITEM} needs the custom fields api_id and api_hash (https://my.telegram.org/apps)")
    stored_session = field(item, "session")
    if chats_only and not stored_session:
        die("no session in Bitwarden yet: run mcp-telegram-setup without arguments first")
    out = None
    if stored_session and not new_login:
        eprint("Using the session stored in Bitwarden (use --new-login for a fresh QR login) ...")
        with phase("Telegram chat list"):
            out = run_login("list", api_id, api_hash, stored_session)
        if out is None:
            eprint("That session is no longer valid, switching to a QR login.")
    fresh = out is None
    if fresh:
        if chats_only:
            die("the stored session is not valid: run mcp-telegram-setup --new-login")
        with phase("Telegram login (QR) and chat list", timed=False):
            out = run_login("qr", api_id, api_hash)
    session = out.get("session") or stored_session
    allowed = {int(x) for x in field(item, "allowlist").split(",") if x.strip().lstrip("-").isdigit()}
    eprint(f"\nLogged in as {out['me']['name']}. {len(out['chats'])} chats found.")
    me_id = (out.get("me") or {}).get("id")
    names = {c["id"]: c for c in out["chats"]}
    final = pick_chats(out["chats"], allowed, me_id, "tick the chats the AI may READ")
    if final is None:
        if fresh:
            keep_fresh_session(m, item, session, ",".join(map(str, sorted(allowed))), "Cancelled.")
        die("cancelled, nothing was changed", 0)
    allowlist = sorted(final)
    value = ",".join(map(str, allowlist))
    changed = final != allowed
    marker = applied_allowlist()
    if not allowlist:
        if fresh:   # the QR login happened: the session must not vanish just because nothing was ticked
            keep_fresh_session(m, item, session, "", "No chat ticked: the service refuses to run without an allowlist.")
        die("no chat ticked: the service refuses to run without an allowlist (nothing was changed)")
    if not changed and not fresh and marker == value:
        eprint("No change.")
        print_total()
        return
    if changed:
        print_summary(final, allowed, names)
        if not confirm("\nSave these chats?", default=True):
            if fresh:
                keep_fresh_session(m, item, session, ",".join(map(str, sorted(allowed))), "Not confirmed.")
            die("not confirmed, nothing was changed", 0)
    values: dict[str, tuple[str, int]] = {}
    if changed:
        values["allowlist"] = (value, 0)
    if fresh:
        values["session"] = (session, 1)
    if values:
        with phase("Bitwarden write"):
            store_fields(m, item, values, recovery={"session": session, "allowlist": value} if fresh else None)
        eprint("Bitwarden updated (the master copy).")
    # seal everything on a fresh login or when this version never sealed (a failed earlier seal, an upgrade); else only what changed
    apply_setup(m, item, allowlist, session, api_id, api_hash, full=(fresh or marker is None),
                allowlist_changed=(changed or marker != value), names={i: c["title"] for i, c in names.items()}, fresh=fresh)
    print_total()


def cmd_resume() -> None:
    """Finish a setup whose fresh session only reached the recovery file: write it to Bitwarden, then seal and start."""
    rec = load_recovery()
    if rec is None:
        die("nothing to resume (no recovery file with a session)")
    m = load_vault_bw()
    item = read_item(m)
    api_id, api_hash = field(item, "api_id"), field(item, "api_hash")
    if not api_id or not api_hash:
        die(f"the Bitwarden item {FOLDER}/{ITEM} needs the custom fields api_id and api_hash (https://my.telegram.org/apps)")
    values = {"session": (rec["session"], 1)}
    if rec["allowlist"].strip():
        values["allowlist"] = (rec["allowlist"], 0)
    with phase("Bitwarden write"):
        store_fields(m, item, values, recovery=rec)
    eprint("Bitwarden updated (the master copy).")
    if not rec["allowlist"].strip():
        RECOVERY.unlink(missing_ok=True)
        die("the session is stored in Bitwarden; no chats were chosen yet: run  mcp-telegram-setup chats", 0)
    session, allowlist = rec["session"], sorted(int(x) for x in rec["allowlist"].split(",") if x.strip().lstrip("-").isdigit())
    RECOVERY.unlink(missing_ok=True)   # the session is safe in Bitwarden now
    apply_setup(m, item, allowlist, session, api_id, api_hash, full=True, allowlist_changed=True, names={}, fresh=True)
    print_total()


def apply_setup(m, item: dict, allowlist: list[int], session: str, api_id: str, api_hash: str, full: bool, names: dict,
                allowlist_changed: bool = True, fresh: bool = False) -> None:
    """After Bitwarden holds the values: seal what changed with the root helper, restart the gateway, register, verify."""
    token, created = ensure_token()
    value = ",".join(map(str, allowlist))
    payload: dict[str, str] = {}
    if allowlist_changed or full:
        payload["allowlist"] = value   # the root helper narrows the sealed send list to this on its own
    if full:
        payload.update(api_id=api_id, api_hash=api_hash, session=session, token=token)
    elif created:
        payload["token"] = token
    if not payload:
        eprint("Nothing to seal (the credentials are unchanged).")
        return
    sealed_list = "allowlist" in payload
    served_before = set(gateway("servers").stdout.split())
    sudo_apply(payload)
    payload.clear()
    mark_applied(value)
    if sealed_list:
        with phase("sealed send list (sudo)"):
            sealed = sealed_send_allowlist()
        if sealed != parse_ids(field(item, "send_allowlist")):    # keep the Bitwarden record equal to what is really sealed
            with phase("Bitwarden write"):
                store_fields(m, item, {"send_allowlist": (",".join(map(str, sorted(sealed))), 0)})
            eprint("The sealed send list is now: " + (", ".join(map(str, sorted(sealed))) if sealed else "empty (run send-chats to allow sending again)"))
    with phase("gateway restart"):
        gateway("restart")
    eprint("Gateway restarted.")
    served_after = set(gateway("servers").stdout.split())
    if fresh or served_after != served_before:
        if Path(MCP_ADD).exists():
            with phase("mcp-add"):
                r = subprocess.run([MCP_ADD], capture_output=True, text=True)
            eprint("mcp-add: " + ("registered the gateway servers in Claude Code and Codex." if r.returncode == 0 else "failed, run it by hand: mcp-add"))
    else:
        eprint("mcp-add skipped (served servers unchanged)")
    verify()
    eprint(f"\nAllowed chats ({len(allowlist)}): " + ", ".join(names.get(i, str(i)) for i in allowlist))
    eprint("Change them later: mcp-telegram-setup chats. Kill switch: Telegram > Settings > Devices > terminate "
           '"telegram-mcp (AI, read-only)".')


def parse_ids(text: str) -> set[int]:
    return {int(x) for x in text.split(",") if x.strip().lstrip("-").isdigit()}


def describe_chats(ids: list[int], names: dict[int, dict]) -> list[str]:
    """One line per chat: title, kind and id (the title alone can be spoofed by a look-alike)."""
    out = []
    for i in ids:
        c = names.get(i)
        out.append(f"  {c['title'] if c else '(not in the chat list)'}  [{c['kind'] if c else '?'}]  id {i}")
    return out


def cmd_send_chats(account: str) -> None:
    if account != "main":
        die(f"only the account 'main' exists yet (several accounts arrive with M1b, one credential set per account); got '{account}'")
    for what, path in (("the venv", TG_PYTHON), ("login.py", TG_LOGIN)):
        if not Path(path).exists():
            die(f"{what} is missing ({path}): run  sudo ~/dotfiles/apply-system.sh --only users,mcp  first")
    m = load_vault_bw()
    item = read_item(m)
    api_id, api_hash, session = field(item, "api_id"), field(item, "api_hash"), field(item, "session")
    readable = parse_ids(field(item, "allowlist"))
    if not session or not readable:
        die("the Telegram read setup is not done yet: run mcp-telegram-setup first (sending is a subset of the readable chats)")
    with phase("Telegram chat list"):
        out = run_login("list", api_id, api_hash, session)
    if out is None:
        die("the stored session is not valid: run mcp-telegram-setup --new-login")
    chats = [c for c in out["chats"] if c["id"] in readable]
    if not chats:
        die("none of the readable chats is in the chat list Telegram returned")
    # the starting point is the SEALED send list (read by the root helper), never the Bitwarden copy: that one is a record an agent
    # with the unlocked vault could have edited
    ensure_sudo("to read the sealed send list and to seal the new one")
    with phase("sealed send list (sudo)"):
        sealed = sealed_send_allowlist()
    recorded = parse_ids(field(item, "send_allowlist"))
    if recorded != sealed:
        extra = sorted(recorded - sealed)
        eprint("Note: the send_allowlist record in Bitwarden differs from the sealed list"
               + (f" (it also had {len(extra)} chat(s) that are NOT sealed and are ignored)" if extra else "") + ". The sealed list is the one used.")
    current = sealed & readable
    names = {c["id"]: c for c in out["chats"]}
    eprint(f"\nLogged in as {out['me']['name']}. {len(chats)} readable chat{'' if len(chats) == 1 else 's'}; {len(current)} may already be written to:")
    eprint("\n".join(describe_chats(sorted(current), names)) if current else "  (none)")
    final = pick_chats(chats, current, (out.get("me") or {}).get("id"), "tick the chats the AI may ASK to WRITE to (you still confirm each message)")
    if final is None:
        die("cancelled, the send list is unchanged", 0)
    if final == current:
        eprint("No change.")
        print_total()
        return
    send = sorted(final)
    if not send:
        die("that would leave no chat to write to; the service needs at least one (nothing was changed)")
    eprint("\nThe AI will be allowed to ASK to write to exactly the final list below.")
    print_summary(final, current, names)
    if not confirm("\nSeal this send list?"):
        die("not confirmed, nothing was changed", 0)
    value = ",".join(map(str, send))
    with phase("Bitwarden write"):
        store_fields(m, item, {"send_allowlist": (value, 0)})
    eprint("Bitwarden updated (send_allowlist record; the send token is not stored there).")
    payload = {"send_allowlist": value}
    sudo_apply(payload, ("--ensure-send-token",))
    payload.clear()
    with phase("gateway restart"):
        gateway("restart")
    eprint("Gateway restarted.")
    if Path(MCP_ADD).exists():
        with phase("mcp-add"):
            r = subprocess.run([MCP_ADD, "--claude"], capture_output=True, text=True)
        eprint("mcp-add: " + ("telegram-send registered in Claude Code (never in Codex)." if r.returncode == 0 else "failed, run it by hand: mcp-add"))
    eprint(f"\nThe AI may ask to write to ({len(send)}):")
    eprint("\n".join(describe_chats(send, names)))
    eprint("Sending is OFF until you switch it on: hub > Telegram: allow sending (SUPER+; x m). Every message then needs your confirmation\n"
           "in a popup. (mcp-add also applied mcp-guard: Claude Code may not use key-injection or capture tools in its Bash.)")
    print_total()


def cmd_status() -> int:
    rc = 0

    def sc(*a: str) -> str:
        return subprocess.run(["systemctl", *a], capture_output=True, text=True).stdout.strip()

    active = sc("is-active", "telegram-mcp.service")
    print(f"service:  telegram-mcp.service is {active or 'unknown'} (enabled: {sc('is-enabled', 'telegram-mcp.service') or 'no'})")
    print(f"whisper:  telegram-whisper-proxy.socket is {sc('is-active', 'telegram-whisper-proxy.socket') or 'unknown'} "
          f"(whisper-server runs on demand: {sc('is-active', 'telegram-whisper.service')})")
    served = gateway("servers").stdout.split()
    print(f"gateway:  telegram {'is' if 'telegram' in served else 'is NOT'} served ({'token file present' if TOKEN_FILE.exists() else 'no token file'})")
    if active != "active":
        rc = 1
    if "telegram" not in served:
        rc = 1
    sc_unit = sc("is-active", "tgconfirm.service")
    sw = subprocess.run([str(BIN_DIR / "mcp-telegram-send"), "status"], capture_output=True, text=True).stdout.strip()
    print(f"sending:  tgconfirm.service is {sc_unit or 'unknown'}; {sw or 'no state'}; telegram-send {'is' if 'telegram-send' in served else 'is NOT'} served")
    return rc


def main(argv: list[str]) -> int:
    if any(a in ("-h", "--help") for a in argv):
        print((__doc__ or "").strip())
        return 0
    if argv and argv[0] == "_pick":          # hidden: the fzf key handlers of the chat picker
        return pick_cmd(argv[1:])
    if argv and argv[0] == "_pick-demo" and len(argv) == 2:   # hidden: the real picker on a prepared directory (UI test)
        return pick_demo(Path(argv[1]))
    new_login = "--new-login" in argv
    words = [a for a in argv if not a.startswith("--")]
    if "--resume" in argv:
        if words:
            print("usage: mcp-telegram-setup --resume", file=sys.stderr)
            return 2
        cmd_resume()
        return 0
    if words == ["status"]:
        return cmd_status()
    if words and words[0] == "send-chats":
        acct = "main"
        if "--account" in argv:
            i = argv.index("--account")
            acct = argv[i + 1] if i + 1 < len(argv) else ""
            words = [w for w in words if w != acct]
        if words != ["send-chats"] or not acct:
            print("usage: mcp-telegram-setup send-chats [--account NAME]", file=sys.stderr)
            return 2
        cmd_send_chats(acct)
    elif words == ["chats"]:
        cmd_setup(True, new_login)
    elif not words:
        cmd_setup(False, new_login)
    else:
        print(f"mcp-telegram-setup: unknown command {' '.join(words)} (try --help)", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
