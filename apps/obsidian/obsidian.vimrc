" dotfiles: ~/dotfiles/apps/obsidian/obsidian.vimrc, the source of the vault's .obsidian.vimrc.
" Do not edit the copy in the vault: apps/obsidian/apply.sh rebuilds it from this file plus vimrc-twins.txt (the
" ua/ru twins of every normal/visual key and of the nmap lines below, generated by .config/layout/layout.py).
" For the community plugin "Vimrc Support" (obsidian-vimrc-support); Obsidian's own Vim key bindings are on
" (app.json vimMode, set by apply.sh). The plugin has no <leader>, so Space sequences are plain nmap lines; keep them
" one line each, `nmap <lhs> <rhs>` with a literal lhs: the generator reads them to add the Cyrillic twins.
" Habits taken from ~/.config/nvim (lua/mappings.lua): jj, <leader>ff/fw/fC/e/w/q/n, ]b [b, gd.

" ---- like nvim -------------------------------------------------------------------------------------------------
" jj leaves INSERT
imap jj <Esc>
" j / k move by display line (wrapped lines), like a code window with `wrap`
nmap j gj
nmap k gk
" Y yanks to the end of the line (nvim default), not the whole line
nmap Y y$
" yank and delete go to the system clipboard (nvim: clipboard=unnamedplus)
set clipboard=unnamedplus

" ---- Obsidian commands as ex commands (:obcommand lists every command id) --------------------------------------
exmap findfile obcommand switcher:open
exmap grepvault obcommand global-search:open
exmap cmdpalette obcommand command-palette:open
exmap togglesidebar obcommand app:toggle-left-sidebar
exmap revealfile obcommand file-explorer:reveal-active-file
exmap savefile obcommand editor:save-file
exmap closetab obcommand workspace:close
exmap newnote obcommand file-explorer:new-file
exmap followlink obcommand editor:follow-link
exmap goback obcommand app:go-back
exmap goforward obcommand app:go-forward
exmap nexttab obcommand workspace:next-tab
exmap prevtab obcommand workspace:previous-tab
exmap togglefold obcommand editor:toggle-fold
exmap foldall obcommand editor:fold-all
exmap unfoldall obcommand editor:unfold-all
exmap outline obcommand outline:open
exmap backlinks obcommand backlink:open
exmap preview obcommand markdown:toggle-preview

" ---- keys: Space sequences (nvim <leader>) ----------------------------------------------------------------------
" Space itself stops moving right; every sequence below starts with it
unmap <Space>
nmap <Space>ff :findfile
nmap <Space>fw :grepvault
nmap <Space>fC :cmdpalette
nmap <Space>fl :backlinks
nmap <Space>fo :outline
nmap <Space>e :togglesidebar
nmap <Space>E :revealfile
nmap <Space>w :savefile
nmap <Space>q :closetab
nmap <Space>n :newnote
nmap <Space>p :preview

" ---- keys: navigation (nvim gd, ]b [b, Ctrl+o / Ctrl+i, zR zM za) ------------------------------------------------
nmap gd :followlink
nmap ]b :nexttab
nmap [b :prevtab
nmap <C-o> :goback
nmap <C-i> :goforward
nmap za :togglefold
nmap zM :foldall
nmap zR :unfoldall
