{
	"name": "Vimium C",
	"description": "dotfiles: ua/ru mapKey, pass keys for YouTube, mail/docs exclusions, Everforest black",
	"environment": {
		"platform": "linux"
	},
	"exclusionRules": [
		{
			"pattern": ":https://www.youtube.com/",
			"passKeys": "f m k j l c t i <space>"
		},
		{
			"pattern": ":https://mail.google.com/",
			"passKeys": ""
		},
		{
			"pattern": ":https://docs.google.com/",
			"passKeys": ""
		},
		{
			"pattern": ":https://outlook.live.com/",
			"passKeys": ""
		},
		{
			"pattern": ":https://outlook.office.com/",
			"passKeys": ""
		},
		{
			"pattern": ":https://outlook.office365.com/",
			"passKeys": ""
		},
		{
			"pattern": ":https://mail.proton.me/",
			"passKeys": ""
		},
		{
			"pattern": "^file:///[^?#]*/\\.cache/keymap/",
			"passKeys": ""
		}
	],
	"keyMappings": [
		"# dotfiles: Vimium C defaults stay (j k h l gg G d u f F H L J K x X o O b B T yy yf p P gi gs / n N v V).",
		"# Ctrl+[ already acts as Esc in Vimium C. Below: the same keys on the ua and ru layouts (mapKey, generated).",
		"# generated by ~/dotfiles/.config/layout/layout.py from keymap.tsv, do not edit (run: layout.py gen)",
		"# Vimium C mapKey block for the ua and ru layouts, embedded in browsers/vimium-c.json by browsers/vimium-c-build.py.",
		"# ASCII characters of a layout (ru: . and , on the slash key) are left alone, as everywhere in this tool.",
		"mapKey ё `",
		"mapKey ʼ ~",
		"mapKey Ё ~",
		"mapKey х [",
		"mapKey Х {",
		"mapKey ї ]",
		"mapKey ъ ]",
		"mapKey Ї }",
		"mapKey Ъ }",
		"mapKey ґ \\\\",
		"mapKey Ґ |",
		"mapKey ж ;",
		"mapKey Ж :",
		"mapKey є '",
		"mapKey э '",
		"mapKey Є \"",
		"mapKey Э \"",
		"mapKey б ,",
		"mapKey Б <",
		"mapKey ю .",
		"mapKey Ю >",
		"mapKey № #",
		"mapKey й q",
		"mapKey ц w",
		"mapKey у e",
		"mapKey к r",
		"mapKey е t",
		"mapKey н y",
		"mapKey г u",
		"mapKey ш i",
		"mapKey щ o",
		"mapKey з p",
		"mapKey ф a",
		"mapKey і s",
		"mapKey ы s",
		"mapKey в d",
		"mapKey а f",
		"mapKey п g",
		"mapKey р h",
		"mapKey о j",
		"mapKey л k",
		"mapKey д l",
		"mapKey я z",
		"mapKey ч x",
		"mapKey с c",
		"mapKey м v",
		"mapKey и b",
		"mapKey т n",
		"mapKey ь m",
		""
	],
	"userDefinedCss": [
		"/* Everforest black for Vimium C (link hints, HUD, find bar, Vomnibar). Generated by themes/palette/render.py. Do not edit.",
		"   Shipped inside browsers/vimium-c.json (userDefinedCss); built by browsers/vimium-c-build.py. Sections: ui (first), #find, #omni.",
		"   Role map: hints = bg_oled with a green frame, typed prefix = yellow, hover/select highlights = green / yellow, HUD = surface. */",
		".LH,.D>.LH{background:#000000;border:1px solid #abc682;border-radius:3px;box-shadow:none;color:#abc682}",
		".BH{color:#d9bc7f}",
		".MC,.MH{color:#d9bc7f}",
		".IH{background:rgba(171,198,130,0.16);border:1px solid #abc682}",
		".IHS{background:rgba(217,188,127,0.24);border-color:#d9bc7f}",
		".HUD,.HUD.D{color:#dbd8c9}",
		".HUD:after,.HUD.D:after{background:#0d1210;border:1px solid #272f2b}",
		".Flash{box-shadow:0 0 4px 2px #abc682}",
		".Sel{box-shadow:0 0 4px 2px #d9bc7f}",
		".Frame{border-color:#abc682}",
		".One{border-color:#ea9e77}",
		"",
		"/*#find*/",
		".r,.r.D{background:#0d1210;box-shadow:inset 0 0 1.5px 1px #3e4843;color:#dbd8c9}",
		"",
		"/*#find:selection*/",
		"background:#28352d !important;",
		"",
		"/*#omni*/",
		"body{background:#000000;box-shadow:0 2px 9px 0.5px rgba(0,0,0,0.9)}",
		"body::after{border:1px solid #3e4843}",
		"#bar{background:#0d1210;border-color:#272f2b}",
		"#list{background:#000000}",
		"#input{background:#000000;border:1px solid #272f2b;box-shadow:none;color:#dbd8c9}",
		"#toolbar{color:#6c7871}",
		".button:hover{background:#151b18;color:#dbd8c9}",
		".item{border-color:#272f2b}",
		".item:hover{background-color:#151b18}",
		".p{border-color:#3e4843}",
		".item.s{background-color:#1e2822}",
		".top,match{color:#dbd8c9}",
		"match{color:#abc682}",
		"a{color:#8cc69c}",
		".label,.time{color:#8d998f}",
		".icon,.tab,.math{fill:#6c7871;fill:var(--vc-c,#6c7871);stroke:#6c7871;stroke:var(--vc-c,#6c7871)}",
		""
	]
}
