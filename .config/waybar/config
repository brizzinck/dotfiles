// Waybar (W1): two bars per output in one process; every module is defined in modules.jsonc.
//   compact  base bar: exclusive zone, always there (hidden only by `bar.sh hide`)
//   full     overlay of the same height drawn over compact (non-exclusive, margin-top -28); SIGUSR1 toggles only this one
// Mode and visibility live in ~/.local/state/waybar (written by scripts/bar.sh, read here through `include`), so they survive
// restarts, theme reloads and logins. Never send SIGUSR1 by hand: use `bar.sh mode toggle` (SUPER+B) or `bar.sh hide toggle`
// (SUPER+CTRL+B). Colours: style.css (palette tokens, themes/palette). Alerts print nothing until they are relevant.
[
  {
    "name": "waybar-compact",
    "include": ["~/.local/state/waybar/compact.jsonc", "~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin": 0,
    "exclusive": true,
    "on-sigusr1": "noop",
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": [
      "privacy", "custom/recording", "custom/health", "network#alert", "custom/updates#alert",
      "hyprland/language", "custom/toggles", "battery", "custom/mode#compact"
    ]
  },
  {
    "name": "waybar-full",
    "include": ["~/.local/state/waybar/full.jsonc", "~/.config/waybar/full-default.jsonc", "~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin": 0,
    "exclusive": false,
    "margin-top": -28,
    "on-sigusr1": "toggle",
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": [
      "privacy", "custom/recording", "custom/health", "custom/updates",
      "group/toggles", "group/net", "group/audio", "group/system",
      "custom/ai", "custom/vault", "hyprland/language", "group/trays",
      "battery", "custom/mode#full"
    ]
  }
]
