#!/usr/bin/env bash
# hub - utility hub: one fuzzy list of every action and every described keybind.
#
#   hub                      interactive fzf (default; also `hub --fzf`)
#   hub open [GROUP]         SUPER+M: remember the focused window, open the hub in a float.tui ghostty
#                            (a second press while the hub is focused closes it); GROUP (Setup, Update, Learn, Fix, Toggles,
#                            Capture, ... case does not matter, `hub groups` lists them) starts the list filtered to that
#                            group (the waybar toggles summary and battery use it; leader menu: SUPER+; then the group key)
#   hub groups [--json]      the groups in display order (groups.tsv) with the number of rows and a description
#   hub --list [--all]       print the merged table (--all also shows actions whose command is missing)
#   hub --json [--all]       the same table as JSON for agents: id, group, title, keys, kind, command, needs, description,
#                            available, state (true/false/null), install (package to install when the tool is missing)
#   hub --raw                print the merged, evaluated records (fields below, then avail, state, install)
#   hub --describe ID        description of one row (used by the fzf preview)
#   hub --run ID             run one row without the UI
#   hub --leader ID          run one row for the leader menu (SUPER+;): the focused window is the target and TUI rows open
#                            in their own float.tui terminal (see .config/hub/leader)
#   --dry-run                with --run/--leader (or the UI): print what would run instead of running it
#
# Data (merged on every open):
#   actions.tsv, actions.d/*.tsv   tab separated, `#` comments, `-` or a missing trailing column = empty
#     id  group  title  keys  kind  command  state  needs  desc  leader
#       id     unique slug
#       group  section label shown as a prefix (short, <= 9 chars looks best)
#       keys   human key text, e.g. SUPER+CTRL+I (also used to dedupe against the live bind table)
#       kind   run     detached `bash -c command`, hub closes, the previously focused window is refocused first
#              toggle  like run, but the hub stays open and shows the new state
#              tui     runs in this terminal in place (hub is replaced); prefix the command with `+pause `
#                      to wait for a key afterwards
#              bind    replays a Hyprland keybind by its key text (command = e.g. SUPER+V, same text as `keys`); the
#                      Lua config records every bind in a registry that `hyprctl eval df_bind_run(...)` replays
#       command  shell command line (kind bind: the bind's key text)
#       state    optional shell snippet, exit status 0 = ON (toggles show a live "on"/"off" marker)
#       needs    optional space separated commands that must exist; default = first word of command.
#                The row is hidden when one is missing (~ is expanded, a path is tested with -x)
#       desc     optional text for the preview pane
#       leader   optional key path in the SUPER+; leader menu: `w m` = group key + item key, `space` = a top-level item.
#                Group keys and labels live in leader-groups.tsv; .config/hub/leader renders the which-key menu from
#                these columns, so the leader and the hub cannot drift (the hub itself ignores this column).
#   every `bindd` from `hyprctl binds -j` (global submap, no mouse binds, workspace digits collapsed)
#   is appended as group "Keybinds"; rows that share a title or a key with an actions.tsv row are merged.
#   Keybind rows are executable: they replay the bind through the Lua registry (hyprctl eval df_bind_run).
#
# Groups: groups.tsv fixes the order of the groups (name <TAB> description; unknown groups come before Keybinds). The groups
# Setup / Update / Learn / Fix follow the Omarchy menu: first-time setup, updates and rollbacks, learning the system, repairs.
# Missing tools: a row whose command is not installed is hidden, unless install-hints.tsv (command <TAB> package) knows the
# package: then it is shown dimmed as "+ title (install: package)" and Enter installs it (yay -S --needed) in a terminal.
#
# Window/app actions target the window that was focused before the hub opened: its address is saved in
# $XDG_RUNTIME_DIR/hub/prev-window, exported as HUB_TARGET=address:0x... to run/toggle commands, and the
# window is refocused before every non-TUI action.
set -u
# the shared modal fzf (INSERT/NORMAL, vim keys, ua/ru twins) with the Everforest colours of the active variant
# shellcheck source=/dev/null
. "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/vimfzf.sh"
# lazygit colours (generated gui.theme merged after the structural config; set only when the file exists)
if [[ -z ${LG_CONFIG_FILE:-} && -r ${XDG_STATE_HOME:-$HOME/.local/state}/theme/current/lazygit.yml ]]; then
  export LG_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/config.yml,${XDG_STATE_HOME:-$HOME/.local/state}/theme/current/lazygit.yml"
fi

HUB_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
SELF="$HUB_DIR/hub"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/hub"
PREV_FILE="$RUN_DIR/prev-window"
CACHE="$RUN_DIR/list.cache"
LOG="$RUN_DIR/last.log"
US=$'\037'
DRY=0
ALL=0
JSON=0
LEADER=0
mkdir -p "$RUN_DIR"

# ───────────────────────────── data pipeline ─────────────────────────────

# actions.tsv + actions.d/*.tsv -> 9 US-separated fields per row
load_actions() {
  local f
  for f in "$HUB_DIR/actions.tsv" "$HUB_DIR"/actions.d/*.tsv; do
    [[ -f $f ]] || continue
    grep -vE '^[[:space:]]*(#|$)' "$f" || true
  done | awk -F'\t' -v OFS="$US" '{
    for (i = NF + 1; i <= 9; i++) $i = ""
    for (i = 1; i <= 9; i++) if ($i == "-") $i = ""
    print $1, $2, $3, $4, $5, $6, $7, $8, $9
  }'
}

# live bind table -> same 9 fields (kind=bind, command = the bind's key text, replayed through the Lua bind registry)
load_binds() {
  hyprctl binds -j 2>/dev/null | jq -r --arg us "$US" '
    def mods($m):
      [ (if ($m / 64 | floor) % 2 == 1 then "SUPER" else empty end),
        (if ($m / 4  | floor) % 2 == 1 then "CTRL"  else empty end),
        (if ($m / 8  | floor) % 2 == 1 then "ALT"   else empty end),
        (if $m % 2 == 1 then "SHIFT" else empty end) ];
    def keylabel: (mods(.modmask) + [.key]) | join("+");
    [ .[]
      | select(.has_description and .submap == "" and (.mouse | not))
      | select(.description | test("^(Move window to )?[Ww]orkspace [0-9]+$") | not)
      | { desc: .description, key: keylabel, disp: .dispatcher, arg: .arg } ]
    | reduce .[] as $b ([];
        (map(.desc) | index($b.desc)) as $i
        | if $i == null then . + [$b + {keys: [$b.key]}] else .[$i].keys += [$b.key] end)
    | .[]
    | [ "bind:" + .keys[0], "Keybinds", .desc, (.keys | join(" / ")), "bind",
        .keys[0], "",
        (if .disp == "exec" and ((.arg | split(" ")[0]) | startswith("$") | not) then (.arg | split(" ")[0]) else "" end),
        "" ]
    | join($us)'
}

# merge: bind rows that duplicate an action row (same title or same key) are dropped; the action row gains the keys
merge_rows() {
  awk -F"$US" -v US="$US" '
    function norm(s) { s = toupper(s); gsub(/[ \t]+/, "", s); return s }
    FILENAME == ARGV[1] {
      n++
      for (i = 1; i <= 9; i++) A[n, i] = $i
      tk[tolower($3)] = n
      m = split($4, kk, " / ")
      for (q = 1; q <= m; q++) if (kk[q] != "") ks[norm(kk[q])] = n
      next
    }
    {
      j = 0
      if (tolower($3) in tk) j = tk[tolower($3)]
      else {
        m = split($4, kk, " / ")
        for (q = 1; q <= m; q++) if (norm(kk[q]) in ks) { j = ks[norm(kk[q])]; break }
      }
      if (j) { if (A[j, 4] == "") A[j, 4] = $4; next }
      B[++b] = $0
    }
    END {
      for (r = 1; r <= n; r++) {
        line = A[r, 1]
        for (i = 2; i <= 9; i++) line = line US A[r, i]
        print line
      }
      for (r = 1; r <= b; r++) print B[r]
    }' "$1" "$2"
}

cmd_ok() {
  local w=$1
  w=${w/#\~/$HOME}
  if [[ $w == */* ]]; then [[ -x $w ]]; else command -v "$w" >/dev/null 2>&1; fi
}

# $1 kind, $2 command, $3 needs
needs_ok() {
  local kind=$1 cmd=$2 needs=$3 w
  local -a words
  if [[ -z $needs ]]; then
    [[ $kind == bind ]] && return 0
    read -r -a words <<<"$cmd"
    for w in "${words[@]}"; do
      [[ $w == +pause || $w == [A-Za-z_]*=* ]] && continue
      needs=$w
      break
    done
    [[ -z $needs || $needs == '$'* ]] && return 0
  fi
  for w in $needs; do cmd_ok "$w" || return 1; done
  return 0
}

# first command of "needs" (or of the command line) that is not installed; empty when everything is there
missing_cmd() {
  local kind=$1 cmd=$2 needs=$3 w
  local -a words
  if [[ -z $needs ]]; then
    [[ $kind == bind ]] && return 0
    read -r -a words <<<"$cmd"
    for w in "${words[@]}"; do
      [[ $w == +pause || $w == [A-Za-z_]*=* ]] && continue
      needs=$w
      break
    done
    [[ -z $needs || $needs == '$'* ]] && return 0
  fi
  for w in $needs; do
    cmd_ok "$w" || { printf '%s' "$w"; return 0; }
  done
}

# package that provides a missing command (install-hints.tsv: command <TAB> package), empty when unknown
install_hint() {
  [[ -n $1 ]] && awk -F'\t' -v c="$1" '$1 !~ /^#/ && $1 == c { print $2; exit }' "$HUB_DIR/install-hints.tsv" 2>/dev/null
}

# sort the cache by the group order of groups.tsv (stable inside a group; unknown groups before Keybinds, which is last)
sort_by_group() {
  awk -F"$US" -v order="$HUB_DIR/groups.tsv" '
    BEGIN {
      while ((getline line < order) > 0) {
        if (line ~ /^#/ || line == "") continue
        split(line, f, "\t")
        idx[f[1]] = ++n
      }
      last = n + 1000
    }
    { g = $2; i = (g in idx) ? idx[g] : (g == "Keybinds" ? last : n + 1); printf "%d\t%d\t%s\n", i, NR, $0 }' "$1" |
    sort -t$'\t' -k1,1n -k2,2n | cut -f3-
}

# build the evaluated cache: 9 fields + avail (1/0) + state (on/off/-) + install (package for a missing tool, else empty)
build_cache() {
  local actions binds merged tmp
  actions=$(mktemp "$RUN_DIR/a.XXXXXX")
  binds=$(mktemp "$RUN_DIR/b.XXXXXX")
  merged=$(mktemp "$RUN_DIR/m.XXXXXX")
  tmp=$(mktemp "$RUN_DIR/c.XXXXXX")
  load_actions >"$actions"
  load_binds >"$binds"
  merge_rows "$actions" "$binds" >"$merged"
  local id grp title keys kind cmd state needs desc avail st inst miss
  while IFS=$US read -r id grp title keys kind cmd state needs desc; do
    [[ -n $id ]] || continue
    avail=1 inst=""
    needs_ok "$kind" "$cmd" "$needs" || avail=0
    if [[ $avail == 0 ]]; then
      miss=$(missing_cmd "$kind" "$cmd" "$needs")
      inst=$(install_hint "$miss")
    fi
    st=-
    if [[ $avail == 1 && -n $state ]]; then
      if timeout 1 bash -c "$state" >/dev/null 2>&1; then st=on; else st=off; fi
    fi
    printf '%s\n' "$id$US$grp$US$title$US$keys$US$kind$US$cmd$US$state$US$needs$US$desc$US$avail$US$st$US$inst"
  done <"$merged" >"$tmp"
  sort_by_group "$tmp" >"$tmp.sorted"
  mv "$tmp.sorted" "$CACHE"
  rm -f "$actions" "$binds" "$merged" "$tmp"
}

# ───────────────────────────── presentation ─────────────────────────────

list_table() {
  local id grp title keys kind cmd state needs desc avail st inst mark
  while IFS=$US read -r id grp title keys kind cmd state needs desc avail st inst; do
    if [[ $avail == 0 ]]; then
      [[ -n $inst ]] || ((ALL)) || continue
      mark="missing"
      [[ -n $inst ]] && mark="install"
    else
      case $st in on) mark="on" ;; off) mark="off" ;; *) mark="-" ;; esac
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$grp" "$mark" "$id" "$title" "${keys:--}" "$kind"
  done <"$CACHE"
}

# fzf input: id <US> coloured display text
fzf_rows() {
  local id grp title keys kind cmd state needs desc avail st inst mark
  while IFS=$US read -r id grp title keys kind cmd state needs desc avail st inst; do
    if [[ $avail != 1 ]]; then
      # a missing tool with a known package: dimmed row, Enter installs it
      [[ -n $inst ]] || continue
      printf '%s%s%s\n' "$id" "$US" "$(printf '\e[2m%-9s + %-42s  (install: %s)\e[0m' "$grp" "$title" "$inst")"
      continue
    fi
    case $st in
      on) mark=$'\e[32m● \e[0m' ;;
      off) mark=$'\e[2m○ \e[0m' ;;
      *) mark='  ' ;;
    esac
    printf '%s%s%s\n' "$id" "$US" "$(printf '\e[2m%-9s\e[0m %s%-42s\e[2m  %s\e[0m' "$grp" "$mark" "$title" "$keys")"
  done <"$CACHE"
}

describe() {
  local rec id grp title keys kind cmd state needs desc avail st inst
  rec=$(awk -F"$US" -v id="$1" '$1 == id { print; exit }' "$CACHE" 2>/dev/null)
  [[ -n $rec ]] || { echo "unknown row: $1"; return 1; }
  IFS=$US read -r id grp title keys kind cmd state needs desc avail st inst <<<"$rec"
  printf '\e[1m%s\e[0m\n' "$title"
  printf '\e[2m%s  ·  %s\e[0m\n\n' "$grp" "$id"
  [[ -n $desc ]] && printf '%s\n\n' "$desc"
  [[ -n $keys ]] && printf 'key      %s\n' "$keys"
  printf 'kind     %s\n' "$kind"
  case $st in on) printf 'state    ON\n' ;; off) printf 'state    OFF\n' ;; esac
  if [[ $avail != 1 ]]; then
    printf 'status   unavailable (missing: %s)\n' "${needs:-${cmd%% *}}"
    [[ -n $inst ]] && printf 'install  Enter installs the package "%s" (yay -S --needed)\n' "$inst"
  fi
  printf '\ncommand\n  %s\n' "$cmd"
  [[ -n $state ]] && printf '\nstate check\n  %s\n' "$state"
}

# ───────────────────────────── running ─────────────────────────────

record_prev() {
  hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' >"$PREV_FILE" || : >"$PREV_FILE"
}

prev_addr() { cat "$PREV_FILE" 2>/dev/null || true; }

focus_prev() {
  local a
  a=$(prev_addr)
  [[ -n $a ]] || return 0
  if ((DRY)); then echo "DRY: hyprd focuswindow address:$a"; else hyprd focuswindow "address:$a" >/dev/null 2>&1; fi
}

# run one row by id; returns 10 for toggle rows so the UI can stay open
run_row() {
  local rec id grp title keys kind cmd state needs desc avail st inst target
  rec=$(awk -F"$US" -v id="$1" '$1 == id { print; exit }' "$CACHE")
  [[ -n $rec ]] || { echo "hub: unknown row: $1" >&2; return 1; }
  IFS=$US read -r id grp title keys kind cmd state needs desc avail st inst <<<"$rec"
  if [[ $avail != 1 ]]; then
    if [[ -n $inst ]]; then
      # missing tool with a known package: install it in a terminal, the row works afterwards
      kind=tui
      cmd="+pause $HOME/.config/hypr/scripts/pkg-install.sh $inst"
      title="Install $inst"
    else
      ((DRY)) || notify-send -a hub -u low "hub" "$title is unavailable (missing: ${needs:-${cmd%% *}})" 2>/dev/null || true
      echo "hub: $title is unavailable" >&2
      return 1
    fi
  fi
  target=$(prev_addr)
  case $kind in
    tui)
      local pause=0
      if [[ $cmd == '+pause '* ]]; then pause=1; cmd=${cmd#+pause }; fi
      if ((LEADER)); then
        # no terminal around the leader menu: give the TUI its own floating ghostty
        local inner=$cmd
        ((pause)) && inner="$cmd; printf '\\n[press a key]'; read -rsn1 _"
        if ((DRY)); then echo "DRY: ghostty --class=float.tui -e bash -c '$inner'"; return 0; fi
        setsid -f ghostty --class=float.tui --title="$title" -e bash -c "$inner" >>"$LOG" 2>&1 </dev/null
        return 0
      fi
      if ((DRY)); then echo "DRY: tui in place: $cmd$( ((pause)) && echo ' (+pause)')"; return 0; fi
      clear
      if ((pause)); then
        bash -c "$cmd"
        printf '\n[press a key]'
        read -rsn1 _
        return 0
      fi
      exec bash -c "$cmd"
      ;;
    run | bind | toggle)
      [[ $kind == toggle || $LEADER == 1 ]] || focus_prev
      if [[ $kind == bind ]]; then
        # the Lua config keeps a registry of every bind (hyprland.lua, df_bind_run); `cmd` is the bind's key text
        if [[ ! $cmd =~ ^[A-Za-z0-9_+:.-]+$ ]]; then echo "hub: bad bind label '$cmd'" >&2; return 1; fi
        if ((DRY)); then echo "DRY: hyprctl eval df_bind_run([==[$cmd]==])"; return 0; fi
        hyprctl eval "df_bind_run([==[$cmd]==])" >/dev/null 2>&1
      else
        if ((DRY)); then echo "DRY: HUB_TARGET=${target:+address:}$target bash -c '$cmd'"; [[ $kind == toggle ]] && return 10; return 0; fi
        HUB_TARGET="${target:+address:}$target" setsid -f bash -c "$cmd" >>"$LOG" 2>&1 </dev/null
      fi
      [[ $kind == toggle ]] && return 10
      return 0
      ;;
    *)
      echo "hub: row $id has unknown kind '$kind'" >&2
      return 1
      ;;
  esac
}

interactive() {
  local start_query=${1:-}
  command -v fzf >/dev/null 2>&1 || { echo "hub: fzf is required" >&2; return 1; }
  if [[ -n ${HUB_FROM_OPEN:-} ]]; then echo $$ >"$RUN_DIR/float.pid"; else record_prev; fi
  printf '\e]2;hub\a'
  local query="" out rc id sel
  [[ -n $start_query ]] && query="^$start_query"
  while :; do
    build_cache
    rc=0
    out=$(fzf_rows | VF_PROMPT=hub vimfzf --delimiter="$US" --with-nth=2 \
      --tiebreak=begin,index --print-query --query="$query" \
      --header='Enter run · Esc normal mode (j/k g/G, i or / to type, q close) · ●/○ live state' \
      --preview="$SELF --describe {1}" --preview-window='right,45%,wrap,border-left') || rc=$?
    ((rc == 0)) || return 0
    query=$(sed -n 1p <<<"$out")
    sel=$(sed -n 2p <<<"$out")
    id=${sel%%"$US"*}
    [[ -n $id ]] || return 0
    rc=0
    run_row "$id" || rc=$?
    if ((rc == 10)); then
      sleep 0.35
      continue
    fi
    return 0
  done
}

# canonical spelling of a group name (case-insensitive) from groups.tsv, else from the rows; empty when unknown
canon_group() {
  local g
  g=$(awk -F'\t' -v w="$1" '$1 !~ /^#/ && tolower($1) == tolower(w) { print $1; exit }' "$HUB_DIR/groups.tsv" 2>/dev/null)
  [[ -n $g ]] || g=$(awk -F"$US" -v w="$1" 'tolower($2) == tolower(w) { print $2; exit }' "$CACHE" 2>/dev/null)
  printf '%s' "$g"
}

open_hub() {
  [[ ${1:-} =~ ^[A-Za-z]*$ ]] || { echo "hub: bad group '$1'" >&2; return 2; }
  local aw cls title addr pid grp=""
  if [[ -n ${1:-} ]]; then
    [[ -s $CACHE ]] || build_cache
    grp=$(canon_group "$1")
    if [[ -z $grp ]]; then
      notify-send -a hub -u low "hub" "unknown group '$1' (hub groups lists them)" 2>/dev/null || true
      echo "hub: unknown group '$1' (hub groups lists them)" >&2
      return 2
    fi
    set -- "$grp"
  fi
  aw=$(hyprctl activewindow -j 2>/dev/null) || aw="{}"
  cls=$(jq -r '.class // ""' <<<"$aw")
  title=$(jq -r '.title // ""' <<<"$aw")
  addr=$(jq -r '.address // ""' <<<"$aw")
  if [[ $cls == float.tui && $title == hub ]]; then
    # second press: end the hub process, ghostty closes its window when the command exits
    # (closewindow would pop up ghostty's "process still running" confirmation)
    pid=$(cat "$RUN_DIR/float.pid" 2>/dev/null || true)
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
      pkill -TERM -P "$pid" 2>/dev/null
      kill -TERM "$pid" 2>/dev/null
    else
      hyprd closewindow "address:$addr" >/dev/null
    fi
    return 0
  fi
  printf '%s\n' "$addr" >"$PREV_FILE"
  HUB_FROM_OPEN=1 exec ghostty --class=float.tui --title=hub -e "$SELF" --fzf ${1:+"$1"}
}

# the groups in display order: name, rows (available or installable), description
cmd_groups() {
  build_cache
  awk -F"$US" -v order="$HUB_DIR/groups.tsv" -v json="$JSON" '
    BEGIN {
      while ((getline line < order) > 0) {
        if (line ~ /^#/ || line == "") continue
        split(line, f, "\t")
        names[++n] = f[1]; desc[f[1]] = f[2]
      }
    }
    { if ($10 == 1 || $12 != "") cnt[$2]++; if (!($2 in seen) && !($2 in desc)) { seen[$2] = 1; names[++n] = $2 } }
    END {
      for (i = 1; i <= n; i++) {
        g = names[i]; if (!(g in cnt)) continue
        if (json == 1) printf "%s%s", (c++ ? "\n" : ""), "{\"group\":\"" g "\",\"rows\":" cnt[g] ",\"description\":\"" desc[g] "\"}"
        else printf "%-10s %3d  %s\n", g, cnt[g], desc[g]
      }
      if (json == 1) printf "\n"
    }' "$CACHE" | { if ((JSON)); then jq -s '.'; else cat; fi; }
}

# the merged table as JSON for agents (hub --json [--all])
list_json() {
  jq -Rn --arg us "$US" --argjson all "$ALL" '
    [ inputs | split($us) as $f
      | { id: $f[0], group: $f[1], title: $f[2], keys: ($f[3] | if . == "" then null else . end), kind: $f[4],
          command: $f[5], needs: ($f[7] | if . == "" then null else . end), description: ($f[8] | if . == "" then null else . end),
          available: ($f[9] == "1"), state: (if $f[10] == "on" then true elif $f[10] == "off" then false else null end),
          install: (($f[11] // "") | if . == "" then null else . end) }
      | select(.available or $all == 1 or .install != null) ]' <"$CACHE"
}

usage() { sed -n '2,/^set -u/p' "$SELF" | sed '$d; s/^# \{0,1\}//'; }

# ───────────────────────────── main ─────────────────────────────

args=()
for a in "$@"; do
  case $a in
    --dry-run) DRY=1 ;;
    --all) ALL=1 ;;
    --json) JSON=1 ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]}"

case ${1:-} in
  "" | --fzf) if ((JSON)); then build_cache; list_json; else interactive "${2:-}"; fi ;;
  open) open_hub "${2:-}" ;;
  --list) build_cache; if ((JSON)); then list_json; else list_table | column -t -s $'\t'; fi ;;
  --json) build_cache; list_json ;;
  groups) cmd_groups ;;
  --raw) build_cache; cat "$CACHE" ;;
  --describe) shift; describe "${1:?row id}" ;;
  --run) shift; build_cache; run_row "${1:?row id}" || [[ $? == 10 ]] ;;
  --leader) shift; LEADER=1; build_cache; record_prev; run_row "${1:?row id}" || [[ $? == 10 ]] ;;
  -h | --help) usage ;;
  *) echo "hub: unknown argument '$1' (try --help)" >&2; exit 2 ;;
esac
