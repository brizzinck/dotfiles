// generated by ~/dotfiles/.config/layout/layout.py from keymap.tsv, do not edit (run: layout.py gen)
// Imported by rofi/config.rasi. Default kb-* bindings plus the ua/ru twins of their letter keys
// (custom keys passed by the scripts use lk_rofi from ~/.config/layout/layout-keys.sh).
configuration {
  kb-primary-paste: "Control+V,Control+Cyrillic_EM,Shift+Insert";
  kb-secondary-paste: "Control+v,Control+Cyrillic_em,Insert";
  kb-secondary-copy: "Control+c,Control+Cyrillic_es";
  kb-clear-line: "Control+w,Control+Cyrillic_tse";
  kb-move-front: "Control+a,Control+Cyrillic_ef";
  kb-move-end: "Control+e,Control+Cyrillic_u";
  kb-move-word-back: "Alt+b,Alt+Cyrillic_i,Control+Left";
  kb-move-word-forward: "Alt+f,Alt+Cyrillic_a,Control+Right";
  kb-move-char-back: "Left,Control+b,Control+Cyrillic_i";
  kb-move-char-forward: "Right,Control+f,Control+Cyrillic_a";
  kb-remove-word-back: "Control+Alt+h,Control+Alt+Cyrillic_er,Control+BackSpace";
  kb-remove-word-forward: "Control+Alt+d,Control+Alt+Cyrillic_ve";
  kb-remove-char-forward: "Delete";
  kb-remove-char-back: "BackSpace,Shift+BackSpace,Control+h,Control+Cyrillic_er";
  kb-remove-to-eol: "";
  kb-remove-to-sol: "";
  kb-accept-entry: "Return,KP_Enter,Control+m,Control+Cyrillic_softsign";
  kb-mode-complete: "Control+l,Control+Cyrillic_de";
  kb-row-up: "Up,Control+p,Control+Cyrillic_ze,Control+k,Control+Cyrillic_el";
  kb-row-down: "Down,Control+n,Control+Cyrillic_te,Control+j,Control+Cyrillic_o";
  kb-page-prev: "Page_Up,Control+u,Control+Cyrillic_ghe";
  kb-page-next: "Page_Down,Control+d,Control+Cyrillic_ve";
  kb-screenshot: "Alt+S,Alt+Ukrainian_I,Alt+Cyrillic_YERU";
  kb-ellipsize: "Alt+period,Alt+Cyrillic_yu";
  kb-toggle-sort: "Alt+grave,Alt+Cyrillic_io";
  kb-cancel: "Escape,Control+g,Control+Cyrillic_pe,Control+bracketleft,Control+Cyrillic_ha";
}
