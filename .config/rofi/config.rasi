/* rofi 2.0 - Everforest v2 (themes/palette). The token variables (bg, surface, select, border, fg, muted, subtext, green,
   red, blue, ...) come from the generated rofi.rasi: black first (always there), then the active variant
   (~/.local/state/theme/current, flipped by `theme`; a missing import is skipped silently, checked with rofi 2.0).
   Scripts pass only -theme-str (width/lines), -p and -mesg on top of this. */
@import "~/dotfiles/themes/generated/black/rofi.rasi"
@import "~/.local/state/theme/current/rofi.rasi"

configuration {
  modes: "drun,run,window,ssh";
  show-icons: true;
  icon-theme: "breeze-dark";
  font: "JetBrainsMono Nerd Font 13";
  terminal: "ghostty";
  drun-display-format: "{name}";
  display-drun: "󰀻 apps";
  display-run: "󰐊 run";
  display-window: "󱂬 win";
  display-ssh: "󰣀 ssh";
  display-combi: "󰍉 all";
  matching: "fuzzy";
  sort: true;
  sorting-method: "fzf";
  case-sensitive: false;
  cycle: true;
  hover-select: false;
  kb-mode-next: "Shift+Right,Control+Tab";
  kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";
}

* {
  accent: @green;
  urgent: @red;
  active: @blue;
  background-color: transparent;
  text-color: @fg;
}

window {
  width: 640px;
  location: center;
  anchor: center;
  background-color: @bg;
  border: 1px;
  border-color: @border;
  border-radius: 8px;
  padding: 12px;
}

mainbox {
  spacing: 10px;
  children: [ inputbar, message, listview ];
}

inputbar {
  padding: 8px 12px;
  spacing: 10px;
  border: 0 0 1px 0;
  border-color: @border;
  children: [ prompt, entry ];
}

prompt { text-color: @accent; }

entry {
  placeholder: "search";
  placeholder-color: @subtext;
  cursor: text;
}

listview {
  lines: 10;
  columns: 1;
  fixed-height: true;
  scrollbar: false;
  spacing: 2px;
}

element {
  padding: 6px 10px;
  border-radius: 6px;
  spacing: 10px;
}

element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @select; text-color: @accent; }
element normal.urgent, element alternate.urgent, element selected.urgent { text-color: @urgent; }
element normal.active, element alternate.active, element selected.active { text-color: @active; }

element-icon {
  size: 22px;
  vertical-align: 0.5;
}

element-text {
  text-color: inherit;
  vertical-align: 0.5;
}

message {
  padding: 6px 10px;
  border-radius: 6px;
  background-color: @surface;
}

textbox { text-color: @fg; }
