# dunst 1.13 - structure only; the colours are Everforest v2 (themes/palette) and arrive as drop-ins from dunstrc.d/:
# 40-theme-black.conf (repo symlink to the generated black file, always valid) and 50-theme.conf (symlink to
# ~/.local/state/theme/current/dunstrc, flipped by `theme`). Drop-ins are read in name order after this file.
# Reload: `dunstctl reload` (theme does it); pkill -x dunst restarts it (dbus activation).

[global]
    monitor = 0
    follow = keyboard
    width = (280, 420)
    height = (0, 220)
    origin = top-right
    offset = (12, 40)
    notification_limit = 5
    indicate_hidden = yes
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    separator_height = 1
    separator_color = frame
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    gap_size = 6
    corner_radius = 6
    font = JetBrainsMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_theme = "breeze-dark, Adwaita"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 24
    max_icon_size = 40
    sticky_history = yes
    history_length = 50
    dmenu = /usr/bin/rofi -dmenu -i -p dunst
    browser = /usr/bin/xdg-open
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    timeout = 0

# Do not cover fullscreen video/presentations with low/normal notifications.
[fullscreen_delay]
    msg_urgency = normal
    fullscreen = delay
[fullscreen_delay_low]
    msg_urgency = low
    fullscreen = delay
[fullscreen_show_critical]
    msg_urgency = critical
    fullscreen = show

# Per-app accents (frame_color/highlight come from the theme drop-in: red = recording, yellow = attention, orange =
# caution). Critical keeps the red frame (these rules only match normal/low).
# Screen recorder (hypr/scripts/rec-toggle.sh): red = recording
[recorder]
    appname = recorder
    msg_urgency = normal
    timeout = 3

# Idle toggle (hypr/scripts/idle-toggle.sh): yellow = attention; replaces itself via the stack tag
[idle]
    appname = idle
    msg_urgency = normal
    timeout = 2

# Battery warnings from waybar
[battery]
    appname = battery
    msg_urgency = normal

# Volume/brightness OSD (swayosd draws its own overlay; this rule only keeps any osd-style
# notifications short and out of the history)
[osd]
    appname = osd
    history_ignore = yes
    timeout = 1
    format = "%s"
