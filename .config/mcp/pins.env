# Pinned external pieces of the MCP stack (read by .local/bin/mcp-install, doctor.sh and the tests). KEY=VALUE, no quoting.
# mcp-proxy (TBXark/mcp-proxy, MIT): release tag + sha256 of each release tarball (from the release's checksums.txt)
MCP_PROXY_VERSION=1.1.0
MCP_PROXY_SHA256_linux_amd64=e093acc33530846b91e4e15158cf1a65524d92a7826ac257802efcf2c6ab6cae
MCP_PROXY_SHA256_linux_arm64=f872ff023d76b0a8e770195e684ff547ddc7399ab65362f58cecaa8ab65c8956
# npm servers: node/package.json + node/package-lock.json (integrity hashes), installed with `npm ci --ignore-scripts`
# Python servers: requirements-desktop-ro.txt (hashes), installed with `pip install --require-hashes --no-deps`
