[Unit]
Description=Reverse SOCKS5 tunnel to bredllm (192.168.1.13) — egress via this laptop's IP
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -R 1080 skalse@192.168.1.13 -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
