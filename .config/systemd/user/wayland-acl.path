[Unit]
Description=Re-apply the managed users' Wayland ACL when a new socket appears in the runtime directory

[Path]
# inotify on the directory itself: an entry created, moved or removed in $XDG_RUNTIME_DIR (the new compositor's wayland-N, and
# other top-level churn; the service exits at once when nothing changed, see wayland-acl.sh)
PathChanged=%t
Unit=wayland-acl.service

[Install]
WantedBy=default.target
