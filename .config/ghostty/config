term = xterm-256color

# Palette: Everforest, variant black (default) or night, see themes/palette. Colours, palette 0-15, cursor,
# selection, minimum-contrast and faint-opacity come from generated fragments. The first include is the
# fallback while the theme link does not exist yet; the second is the active variant (the symlink
# ~/.local/state/theme/current, flipped by `theme black|night`, which also reloads ghostty with SIGUSR2).
config-file = ?~/dotfiles/themes/generated/black/ghostty.conf
config-file = ?~/.local/state/theme/current/ghostty.conf

font-family = JetBrainsMono Nerd Font
font-size = 15
font-style = Regular

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-padding-color = extend
mouse-hide-while-typing = true

copy-on-select = clipboard

clipboard-write = allow
clipboard-read = allow

app-notifications = no-clipboard-copy
